<Window x:Class="Pos.Desktop.RegisterAdministrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Cajas y equipos" Width="1080" Height="650" MinWidth="900" MinHeight="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#E8F3FB" CornerRadius="5"><icons:PackIconMaterial Kind="DesktopClassic" Width="27" Height="27" Foreground="#146CB0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Cajas y equipos" FontSize="23" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Administra cajas de la red; desactivar una caja no modifica ventas, inventario ni historial." Foreground="#526577" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></StackPanel></StackPanel>
        <DataGrid Grid.Row="1" x:Name="RegistersGrid" Margin="0,18,0,12" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" MouseDoubleClick="OnRenameClick"><DataGrid.Columns><DataGridTextColumn Header="Caja" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Equipo" Binding="{Binding DeviceName}" Width="150"/><DataGridTextColumn Header="Última conexión" Binding="{Binding LastConnectionDisplay}" Width="150"/><DataGridTextColumn Header="Usuario actual" Binding="{Binding ActiveUser}" Width="160"/><DataGridTextColumn Header="Turno abierto" Binding="{Binding ShiftDisplay}" Width="180"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2"><Border Background="#F3F8FC" Padding="10,7" CornerRadius="4"><TextBlock x:Name="StatusText" Foreground="#526577" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Width="115" Margin="0,0,8,0" Click="OnRefreshClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Actualizar"/></StackPanel></Button><Button Width="120" Margin="0,0,8,0" Click="OnRenameClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PencilOutline" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Renombrar"/></StackPanel></Button><Button x:Name="ActiveButton" Style="{StaticResource DangerButtonStyle}" Width="135" Margin="0,0,8,0" Click="OnToggleActiveClick">Desactivar</Button><Button Width="180" Margin="0,0,8,0" Click="OnPairAgainClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LinkVariant" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Volver a emparejar"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="OnCloseClick">Cerrar</Button></StackPanel></StackPanel>
    </Grid>
</Window>
