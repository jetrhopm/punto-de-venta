<UserControl x:Class="Pos.Desktop.InvoiceRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" Background="#FFF4DE" CornerRadius="6"><icons:PackIconMaterial Kind="FileDocumentEditOutline" Width="30" Height="30" Foreground="#A96300" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="14,1,0,0"><TextBlock Text="Solicitudes de factura" FontSize="23" FontWeight="Bold"/><TextBlock Text="Registra y consulta solicitudes; configura tu PAC propio antes del futuro timbrado CFDI." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PacSettingsButton" Background="#146CB0" Foreground="White" Padding="12,8" Margin="0,0,10,0" Click="OnPacSettingsClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CogOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Configurar PAC"/></StackPanel></Button><Border Background="#FFF4DE" BorderBrush="#F2D18B" BorderThickness="1" CornerRadius="5" Padding="13,8"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ClockOutline" Width="18" Height="18" Foreground="#A96300" Margin="0,0,7,0"/><TextBlock Text="Sin timbrado fiscal" Foreground="#7A520B" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Nueva solicitud" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="La venta debe estar confirmada. Este registro no genera XML, PDF ni factura fiscal." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                    <TextBlock Text="Folio de venta" FontWeight="SemiBold"/>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions><TextBox x:Name="SaleFolioBox" Height="40" VerticalContentAlignment="Center" KeyDown="OnSaleFolioKeyDown"/><Button Grid.Column="1" Margin="9,0,0,0" Background="#146CB0" Foreground="White" Click="OnFindSaleClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Buscar"/></StackPanel></Button></Grid>
                    <Border x:Name="SaleSummaryBorder" Background="#F3F8FC" BorderBrush="#D2E1EE" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="SaleSummaryText" FontWeight="SemiBold"/><TextBlock Text="Venta confirmada disponible para solicitud." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
                    <Separator Margin="0,19,0,17"/>
                    <TextBlock Text="RFC del receptor" FontWeight="SemiBold"/><TextBox x:Name="TaxIdBox" Height="40" Margin="0,5,0,13" MaxLength="20" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Nombre o razón social" FontWeight="SemiBold"/><TextBox x:Name="ReceiverNameBox" Height="40" Margin="0,5,0,13" MaxLength="200" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Correo para seguimiento (opcional)" FontWeight="SemiBold"/><TextBox x:Name="EmailBox" Height="40" Margin="0,5,0,13" MaxLength="200" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Notas internas (opcional)" FontWeight="SemiBold"/><TextBox x:Name="NotesBox" Height="76" Margin="0,5,0,0" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <TextBlock x:Name="FormStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,13,0,0"/>
                    <Button Height="42" Margin="0,16,0,0" Background="#16803C" Foreground="White" FontWeight="Bold" Click="OnCreateClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="FilePlusOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Registrar solicitud"/></StackPanel></Button>
                </StackPanel></ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Historial de solicitudes" FontSize="18" FontWeight="Bold"/><TextBlock Text="Pendientes para futura revisión y timbrado por PAC." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Background="#146CB0" Foreground="White" Click="OnRefreshClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Actualizar"/></StackPanel></Button></Grid>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="SearchBox" Height="40" Padding="38,6,10,6" TextChanged="OnSearchChanged" ToolTip="Buscar por folio, RFC o receptor"/><icons:PackIconMaterial Kind="Magnify" Width="20" Height="20" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/><DataGrid x:Name="RequestsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding SaleFolio}" Width="75"/><DataGridTextColumn Header="Total" Binding="{Binding SaleTotalText}" Width="95"/><DataGridTextColumn Header="RFC" Binding="{Binding ReceiverTaxId}" Width="125"/><DataGridTextColumn Header="Receptor" Binding="{Binding ReceiverName}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="155"/><DataGridTextColumn Header="Solicitud" Binding="{Binding RequestedAtText}" Width="145"/><DataGridTextColumn Header="Registró" Binding="{Binding RequestedBy}" Width="145"/></DataGrid.Columns></DataGrid></Grid>
                    <TextBlock x:Name="HistoryStatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
