<Window x:Class="Pos.Desktop.MissingProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto no encontrado" Width="520" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Producto no encontrado" FontSize="24" FontWeight="SemiBold" Foreground="#B42318"/>
            <TextBlock x:Name="CodeText" Margin="0,6,0,0" Foreground="#526577" TextWrapping="Wrap"/>
            <TextBlock Text="Puedes registrarlo rapido o cobrarlo como producto comun. Solo pedimos lo indispensable." Margin="0,8,0,0" Foreground="#526577" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Nombre o descripcion" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" Height="36"/>
            <TextBlock Text="Precio" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="PriceBox" Height="36"/>
            <TextBlock Text="Unidad" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ComboBox x:Name="UnitBox" Height="36" SelectedIndex="0">
                <ComboBoxItem Content="Pieza"/>
                <ComboBoxItem Content="Kilogramo"/>
                <ComboBoxItem Content="Gramo"/>
                <ComboBoxItem Content="Litro"/>
                <ComboBoxItem Content="Mililitro"/>
                <ComboBoxItem Content="Metro"/>
                <ComboBoxItem Content="Servicio"/>
            </ComboBox>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Width="110" Height="38" Click="OnCancelClick">Cancelar</Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="150" Height="38" Margin="0,0,8,0" Click="OnCommonClick">Producto comun</Button>
                <Button Width="155" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnRegisterClick">Registrar producto</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
