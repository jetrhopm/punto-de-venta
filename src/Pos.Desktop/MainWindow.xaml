<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="JetVenta" Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="TopNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SalesToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="74"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PaymentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Icons/app-icon-48.png" Width="44" Height="44" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JetVenta" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="StoreNameText" Text="Conectando..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopNavButton}" Tag="Ventas" Click="OnNavigateClick" ToolTip="Ventas (F1)"><StackPanel><icons:PackIconMaterial Kind="CartOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Ventas  F1" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Creditos" Click="OnNavigateClick" ToolTip="Creditos (F2)"><StackPanel><icons:PackIconMaterial Kind="CreditCardOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Créditos F2" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Clientes" Click="OnNavigateClick" ToolTip="Clientes (F2)"><StackPanel><icons:PackIconMaterial Kind="AccountGroupOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Clientes  F2" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Productos" Click="OnNavigateClick" ToolTip="Productos (F3)"><StackPanel><icons:PackIconMaterial Kind="PackageVariantClosed" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Productos F3" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Inventario" Click="OnNavigateClick" ToolTip="Inventario (F4)"><StackPanel><icons:PackIconMaterial Kind="Warehouse" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Inventario  F4" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Compras" Click="OnNavigateClick"><StackPanel><icons:PackIconMaterial Kind="CartOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="#2B8C7F"/><TextBlock Text="Compras" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Configuracion" Click="OnNavigateClick" ToolTip="Configuración"><StackPanel><icons:PackIconMaterial Kind="CogOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Config." Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Facturas" Click="OnNavigateClick"><StackPanel><icons:PackIconMaterial Kind="FileDocumentOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Facturas" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Corte" Click="OnNavigateClick"><StackPanel><icons:PackIconMaterial Kind="ClipboardCheckOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Corte" Margin="0,3,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource TopNavButton}" Tag="Reportes" Click="OnNavigateClick"><StackPanel><icons:PackIconMaterial Kind="ChartBoxOutline" Width="23" Height="23" HorizontalAlignment="Center" Foreground="#7C5799"/><TextBlock Text="Reportes" Margin="0,3,0,0"/></StackPanel></Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconOnlyButton}" ToolTip="Minimizar" Click="OnMinimizeClick"><icons:PackIconMaterial Kind="WindowMinimize" Width="19" Height="19"/></Button>
                    <Button Style="{StaticResource IconOnlyButton}" ToolTip="Salir" Click="OnExitClick"><icons:PackIconMaterial Kind="LogoutVariant" Width="20" Height="20" Foreground="{StaticResource DangerBrush}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Button Style="{StaticResource RailButton}" Click="OnSalesActionClick"><StackPanel><icons:PackIconMaterial Kind="PlusBoxOutline" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Nuevo ticket" Margin="0,4,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource RailButton}" Click="OnSalesActionClick"><StackPanel><icons:PackIconMaterial Kind="ContentSaveOutline" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Guardar orden" Margin="0,4,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource RailButton}" Click="OnCancelLastSaleClick"><StackPanel><icons:PackIconMaterial Kind="Cancel" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Cancelar ticket" Margin="0,4,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource RailButton}" Click="OnSalesActionClick"><StackPanel><icons:PackIconMaterial Kind="AccountSearchOutline" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Buscar cliente" Margin="0,4,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource RailButton}" Click="OnReturnLastSaleClick"><StackPanel><icons:PackIconMaterial Kind="UndoVariant" Width="25" Height="25" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Devolución" Margin="0,4,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource RailButton}" Click="OnPairingCodeClick"><StackPanel><icons:PackIconMaterial Kind="LinkVariant" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#7C5799"/><TextBlock Text="Código de caja" Margin="0,4,0,0"/></StackPanel></Button>
            </StackPanel>

            <Border Grid.Column="1" Margin="10,0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WorkspaceTitleText" Text="Venta en curso" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="WorkspaceDetailText" Text="Escanea un código o busca un producto." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center"><TextBlock x:Name="CurrentSectionText" Text="Nueva venta" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/></Border>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnAddProductFromEntryClick" ToolTip="Enter - agregar producto"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="ENTER Agregar"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnInsertCommonProductClick" ToolTip="INS - Varios"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PlusBoxOutline" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="INS Varios"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnCommonProductClick" ToolTip="Ctrl+P - Artículo común"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="TagOutline" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="CTRL+P Art. común"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnProductLookupClick" ToolTip="F10 - Buscar producto"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="F10 Buscar"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnWholesaleClick" ToolTip="F11 - Mayoreo"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Cash" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="F11 Mayoreo"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnCashInClick" ToolTip="F7 - Entrada de efectivo"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CashPlus" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="F7 Entradas"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnCashOutClick" ToolTip="F8 - Salida de efectivo"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CashMinus" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="F8 Salidas"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnDeleteSelectedLineClick" ToolTip="DEL - Borrar partida"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,5,0" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="DEL Borrar"/></StackPanel></Button>
                        <Button Style="{StaticResource SalesToolbarButton}" Click="OnPriceVerifierClick" ToolTip="F9 - Verificador"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="BarcodeScan" Width="18" Height="18" Margin="0,0,5,0" Foreground="#7C5799"/><TextBlock Text="F9 Verificador"/></StackPanel></Button>
                    </DockPanel>

                    <ListView Grid.Row="2" x:Name="CartList" Margin="0,14,0,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#FBFDFF" DisplayMemberPath="DisplayText" KeyDown="OnCartKeyDown"/>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Código o producto" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                            <Grid>
                                <icons:PackIconMaterial Kind="BarcodeScan" Width="23" Height="23" Foreground="{StaticResource PrimaryBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="ProductSearchTextBox" Height="46" FontSize="17" Padding="43,7,10,7" TextChanged="OnProductSearchTextChanged" KeyDown="OnProductSearchKeyDown" ToolTip="Código de barras o descripción"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White"><ListBox x:Name="ProductResultsList" Height="140" DisplayMemberPath="DisplayText" Visibility="Collapsed" MouseDoubleClick="OnProductSelected"/></Border>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="46" Width="104" Margin="10,24,0,0" Click="OnSearchButtonClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Magnify" Width="20" Height="20" Margin="0,0,5,0"/><TextBlock Text="Buscar" VerticalAlignment="Center"/></StackPanel></Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Venta en curso" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Total de la venta" Margin="0,22,0,2" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="SaleTotalText" Text="$0.00" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="SaleItemsText" Text="Artículos: 0" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,15"/>
                    </StackPanel>
                    <Button Grid.Row="1" Style="{StaticResource PaymentButton}" Height="64" Click="OnChargeClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="CashRegister" Width="25" Height="25" Margin="0,0,8,0" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Seleccionar forma de pago" VerticalAlignment="Center"/></StackPanel></Button>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="Cliente actual" FontWeight="SemiBold" Margin="3,0,0,5"/>
                        <Button Click="OnSalesActionClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="AccountOutline" Width="20" Height="20" Margin="0,0,7,0"/><TextBlock Text="Seleccionar cliente" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource SuccessButtonStyle}" Height="72" Margin="3,15,3,4" Click="OnChargeClick"><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="CashRegister" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="COBRAR" FontSize="18" FontWeight="Bold"/></StackPanel><TextBlock Text="F12" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Button>
                        <UniformGrid Columns="2">
                            <Button Click="OnChargeClick"><StackPanel><icons:PackIconMaterial Kind="ReceiptTextOutline" Width="21" Height="21" HorizontalAlignment="Center"/><TextBlock Text="Ticket rápido" FontSize="11"/></StackPanel></Button>
                            <Button Click="OnSalesActionClick"><StackPanel><icons:PackIconMaterial Kind="PrinterOutline" Width="21" Height="21" HorizontalAlignment="Center"/><TextBlock Text="Último ticket" FontSize="11"/></StackPanel></Button>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <Separator Margin="0,14,0,10"/>
                        <Button Click="OnCloseShiftClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ClipboardCheckOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Realizar corte"/></StackPanel></Button>
                        <Button Click="OnExitClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LogoutVariant" Width="19" Height="19" Margin="0,0,7,0" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Cerrar sesión"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#17384E" Padding="14,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#50D890" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Listo." Foreground="White" VerticalAlignment="Center"/></StackPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="RegisterStatusText" Text="Caja: sin configurar" Foreground="#DDEAF2" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
