<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Punto de Venta"
        Width="1280"
        Height="760"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#146CB0" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0D4D80" />
        <SolidColorBrush x:Key="PanelBrush" Color="#EEF7FC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D2DCE4" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Icons/app-icon-48.png" Width="38" Height="38" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Punto de Venta" FontSize="20" FontWeight="Bold" Foreground="#17324D" />
                        <TextBlock Text="Modo desarrollo" FontSize="12" Foreground="#607080" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CurrentSectionText" Text="Ventas" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#17324D" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Minimizar" Click="OnMinimizeClick">_</Button>
                    <Button ToolTip="Salir" Click="OnExitClick">Salir</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#EAF4FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource NavigationButton}" Tag="Ventas" Click="OnNavigateClick">F1  Ventas</Button>
                        <Button Style="{StaticResource NavigationButton}" Tag="Clientes" Click="OnNavigateClick">F2  Clientes</Button>
                        <Button Style="{StaticResource NavigationButton}" Tag="Productos" Click="OnNavigateClick">F3  Productos</Button>
                        <Button Style="{StaticResource NavigationButton}" Tag="Inventario" Click="OnNavigateClick">F4  Inventario</Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource NavigationButton}" Tag="Corte" Click="OnNavigateClick">Corte</Button>
                        <Button Style="{StaticResource NavigationButton}" Tag="Configuracion" Click="OnNavigateClick">Configuracion</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBrush}" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Venta en atencion" FontSize="17" FontWeight="SemiBold" Foreground="#17324D" />
                            <TextBlock Text="Escanea un codigo o busca un producto para iniciar." Margin="0,4,0,0" Foreground="#526577" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="OnChargeClick">F12  Cobrar</Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,16,0,0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                        <Image Source="Assets/Icons/sales-icon-128.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,18" />
                        <TextBlock x:Name="WorkspaceTitleText" Text="Listo para una venta" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Foreground="#17324D" />
                        <TextBlock x:Name="WorkspaceDetailText" Text="La captura de productos, cobro, inventario y turnos se habilitara por incrementos transaccionales." Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#526577" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Click="OnSalesActionClick">F10  Buscar producto</Button>
                            <Button Click="OnSalesActionClick">F9  Verificar precio</Button>
                            <Button Click="OnSalesActionClick">F6  Venta pendiente</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#17324D" Padding="16,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Base tecnica lista. PostgreSQL local pendiente de preparar." Foreground="White" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Caja: sin configurar" Foreground="#DDEAF2" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
