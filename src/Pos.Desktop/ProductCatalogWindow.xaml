<UserControl x:Class="Pos.Desktop.ProductCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
 <UserControl.Resources><x:Array x:Key="UnitOptions" Type="{x:Type sys:String}"><sys:String>Pieza</sys:String><sys:String>Granel (peso)</sys:String><sys:String>Litro</sys:String><sys:String>Mililitro</sys:String><sys:String>Metro</sys:String><sys:String>Servicio</sys:String></x:Array></UserControl.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#E7F3FB" CornerRadius="6"><icons:PackIconMaterial Kind="PackageVariantClosed" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Catálogo de productos" FontSize="24" FontWeight="Bold"/><TextBlock Text="Precios, utilidades, existencias, departamentos y promociones" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="OnDepartmentsClick" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ShapeOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Departamentos"/></StackPanel></Button><Button Click="OnPromotionsClick" Style="{StaticResource PrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="TagMultipleOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Promociones"/></StackPanel></Button></StackPanel></Grid>
  <Border Grid.Row="1" Margin="0,18,0,12" Padding="12" Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="115"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Buscar por código o nombre" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="SearchBox" Height="32"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Departamento" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><ComboBox x:Name="DepartmentFilterBox" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Precio mínimo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MinimumPriceBox" Height="32"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="Precio máximo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MaximumPriceBox" Height="32"/></StackPanel><StackPanel Grid.Column="4" Margin="8,0"><TextBlock Text="Utilidad mínima %" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MinimumProfitBox" Height="32"/></StackPanel><StackPanel Grid.Column="5" Margin="8,0"><TextBlock Text="Ordenar por" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><ComboBox x:Name="SortBox" Height="32" SelectedIndex="0"><ComboBoxItem Tag="description">Descripción</ComboBoxItem><ComboBoxItem Tag="code">Código</ComboBoxItem><ComboBoxItem Tag="cost">Costo</ComboBoxItem><ComboBoxItem Tag="price">Precio venta</ComboBoxItem><ComboBoxItem Tag="profit">Utilidad %</ComboBoxItem><ComboBoxItem Tag="stock">Existencia</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Column="6" Margin="8,0,0,0" VerticalAlignment="Bottom"><CheckBox x:Name="DescendingBox" Content="Mayor a menor" Margin="0,0,0,8"/><Button Click="OnApplyFiltersClick" Style="{StaticResource PrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="FilterOutline" Width="17" Height="17" Margin="0,0,5,0"/><TextBlock Text="Aplicar"/></StackPanel></Button></StackPanel></Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="365"/></Grid.ColumnDefinitions><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnSelectionChanged" Sorting="OnGridSorting" CanUserSortColumns="True" GridLinesVisibility="Horizontal" Margin="0,0,14,0"><DataGrid.Columns><DataGridTextColumn Header="Código" SortMemberPath="code" Binding="{Binding Code}" Width="105"/><DataGridTextColumn Header="Descripción" SortMemberPath="description" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Departamento" SortMemberPath="department" Binding="{Binding Department}" Width="145"/><DataGridTextColumn Header="Costo" SortMemberPath="cost" Binding="{Binding Cost, StringFormat={}{0:C2}}" Width="90"/><DataGridTextColumn Header="P. venta" SortMemberPath="price" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="95"/><DataGridTextColumn Header="P. mayoreo" SortMemberPath="wholesale" Binding="{Binding WholesalePrice, StringFormat={}{0:C2}}" Width="105"/><DataGridTextColumn Header="Utilidad" SortMemberPath="profit" Binding="{Binding ProfitPercent, StringFormat={}{0:0.##}%}" Width="78"/><DataGridTextColumn Header="Existencia" SortMemberPath="stock" Binding="{Binding Stock, StringFormat={}{0:0.###}}" Width="90"/><DataGridTextColumn Header="Inv. mín." Binding="{Binding MinimumStock, StringFormat={}{0:0.###}}" Width="82"/><DataGridTextColumn Header="Inv. máx." Binding="{Binding MaximumStock, StringFormat={}{0:0.###}}" Width="82"/><DataGridTextColumn Header="Unidad" Binding="{Binding UnitOfMeasure}" Width="105"/></DataGrid.Columns></DataGrid>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FormTitleText" Text="Nuevo producto" FontSize="19" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Código" Margin="0,14,0,4"/><TextBox x:Name="CodeBox"/><TextBlock Text="Descripción" Margin="0,9,0,4"/><TextBox x:Name="DescriptionBox"/><TextBlock Text="Departamento (opcional)" Margin="0,9,0,4"/><ComboBox x:Name="DepartmentBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="Unidad de venta" Margin="0,9,0,4"/><ComboBox x:Name="UnitBox" ItemsSource="{StaticResource UnitOptions}" SelectedIndex="0"/><UniformGrid Columns="2" Margin="0,11,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Costo"/><TextBox x:Name="CostBox" Text="0.00" LostFocus="OnPricingChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="ProfitPercentBox" Text="20" LostFocus="OnPricingChanged" Margin="0,4,0,0"/></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Precio venta"/><TextBox x:Name="PriceBox" Text="0.00" TextChanged="OnPriceChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Ganancia $"/><TextBox x:Name="ProfitAmountBox" IsReadOnly="True" Margin="0,4,0,0"/></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,11,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="P. mayoreo opcional"/><TextBox x:Name="WholesalePriceBox" Text="0.00" TextChanged="OnWholesalePriceChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Mayoreo ganancia %"/><TextBox x:Name="WholesaleProfitPercentBox" Text="0" LostFocus="OnWholesalePricingChanged" Margin="0,4,0,0"/></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Mayoreo ganancia $"/><TextBox x:Name="WholesaleProfitAmountBox" IsReadOnly="True"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Mínimo mayoreo"/><TextBox x:Name="WholesaleMinimumBox" Text="0"/></StackPanel></UniformGrid><CheckBox x:Name="IsKitBox" Content="Es kit o producto compuesto" Margin="0,12,0,0"/><UniformGrid Columns="3" Margin="0,16,0,0"><Button Click="OnNewClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="17" Height="17" Margin="0,0,5,0"/><TextBlock Text="Nuevo"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="17" Height="17" Margin="0,0,5,0"/><TextBlock Text="Guardar"/></StackPanel></Button><Button Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ArchiveRemoveOutline" Width="17" Height="17" Margin="0,0,5,0"/><TextBlock Text="Desactivar"/></StackPanel></Button></UniformGrid></StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PreviousPageButton" Content="Anterior" Click="OnPreviousPageClick" Margin="0,0,6,0"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="6,0"/><Button x:Name="NextPageButton" Content="Siguiente" Click="OnNextPageClick" Margin="6,0,0,0"/></StackPanel></Grid>
 </Grid>
</UserControl>
