<UserControl x:Class="Pos.Desktop.ProductCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
  <UserControl.Resources>
    <x:Array x:Key="UnitOptions" Type="{x:Type sys:String}"><sys:String>Pieza</sys:String><sys:String>Granel (unidad configurada)</sys:String><sys:String>Kilogramo</sys:String><sys:String>Gramo</sys:String><sys:String>Litro</sys:String><sys:String>Mililitro</sys:String><sys:String>Metro</sys:String><sys:String>Servicio</sys:String></x:Array>
    <Style x:Key="ToolbarGroupCard" TargetType="Border"><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" Color="#52657A"/></Setter.Value></Setter></Style>
    <Style x:Key="ToolbarActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="11,4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  </UserControl.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#E7F3FB" CornerRadius="6"><icons:PackIconMaterial Kind="PackageVariantClosed" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Catálogo de productos" FontSize="24" FontWeight="Bold"/><TextBlock Text="Menudeo, mayoreo, existencias y departamentos" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Border Style="{StaticResource ToolbarGroupCard}" Background="#EEF7FF" BorderBrush="#C8E0F4"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" Background="#0879D8" CornerRadius="5"><icons:PackIconMaterial Kind="PackageVariantClosed" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Producto" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Gestiona el catálogo" FontSize="10" Foreground="#637589"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource ToolbarActionButton}" Background="#168B4C" Foreground="White" BorderBrush="#168B4C" Click="OnShowNewProductClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PlusCircle" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Nuevo producto"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" Background="#0879D8" Foreground="White" BorderBrush="#0879D8" Click="OnShowEditProductClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Editar seleccionado"/></StackPanel></Button></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource ToolbarGroupCard}" Background="#FFF9E8" BorderBrush="#ECD78E"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" Background="#F8B816" CornerRadius="5"><icons:PackIconMaterial Kind="CheckboxMarkedOutline" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Selección" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Gestiona elementos de la lista" FontSize="10" Foreground="#637589"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource ToolbarActionButton}" Background="#F8C73A" BorderBrush="#E5AD17" Foreground="#694A00" Click="OnSelectVisibleClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Seleccionar todos"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" Background="#FFF4CD" BorderBrush="#E5C76D" Foreground="#694A00" Click="OnClearSelectionClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="MinusCircleOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Desmarcar todos"/></StackPanel></Button></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource ToolbarGroupCard}" Background="#FFF1F2" BorderBrush="#F0C7CC"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" Background="#D83245" CornerRadius="5"><icons:PackIconMaterial Kind="DeleteOutline" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Bajas lógicas" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Activa o desactiva productos" FontSize="10" Foreground="#637589"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource ToolbarActionButton}" Background="#D83245" Foreground="White" BorderBrush="#D83245" Click="OnDeactivateSelectedClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Retirar seleccionados"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" Background="#E85A65" Foreground="White" BorderBrush="#E85A65" Click="OnReactivateSelectedClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Reactivar"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" x:Name="ShowInactiveButton" Background="#FFF7F7" Foreground="#A42836" BorderBrush="#E7AFB7" Click="OnToggleInactiveClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="EyeOffOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock x:Name="ShowInactiveButtonText" Text="Mostrar bajas"/></StackPanel></Button></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource ToolbarGroupCard}" Background="#F5F1FF" BorderBrush="#D9C9F0" Margin="0,0,0,8"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" Background="#6536D9" CornerRadius="5"><icons:PackIconMaterial Kind="FolderOutline" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Organización" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Clasifica y promociona productos" FontSize="10" Foreground="#637589"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource ToolbarActionButton}" Background="#F0EBFF" Foreground="#5223B8" BorderBrush="#CBBBF0" Click="OnDepartmentsClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="FileTreeOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Departamentos"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" Background="#6536D9" Foreground="White" BorderBrush="#6536D9" Click="OnPromotionsClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="TagOutline" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Promociones"/></StackPanel></Button></StackPanel></StackPanel></Border>
      </WrapPanel>
    </Grid>
    <Border Grid.Row="1" Margin="0,18,0,12" Padding="12" Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="115"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Buscar por código o nombre" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="SearchBox" Height="32"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Departamento" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><ComboBox x:Name="DepartmentFilterBox" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Precio mínimo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MinimumPriceBox" Height="32"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="Precio máximo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MaximumPriceBox" Height="32"/></StackPanel><StackPanel Grid.Column="4" Margin="8,0"><TextBlock Text="Utilidad mínima %" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBox x:Name="MinimumProfitBox" Height="32"/></StackPanel><StackPanel Grid.Column="5" Margin="8,0"><TextBlock Text="Ordenar por" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><ComboBox x:Name="SortBox" Height="32" SelectedIndex="0"><ComboBoxItem Tag="description">Descripción</ComboBoxItem><ComboBoxItem Tag="code">Código</ComboBoxItem><ComboBoxItem Tag="cost">Costo</ComboBoxItem><ComboBoxItem Tag="price">Menudeo</ComboBoxItem><ComboBoxItem Tag="wholesale">Mayoreo</ComboBoxItem><ComboBoxItem Tag="profit">Utilidad %</ComboBoxItem><ComboBoxItem Tag="stock">Existencia</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Column="6" Margin="8,0,0,0" VerticalAlignment="Bottom"><CheckBox x:Name="DescendingBox" Content="Mayor a menor" Margin="0,0,0,8"/><Button Click="OnApplyFiltersClick" Style="{StaticResource PrimaryButtonStyle}">Aplicar</Button></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnSelectionChanged" Sorting="OnGridSorting" CanUserSortColumns="True" GridLinesVisibility="Horizontal" Margin="0,0,14,0"><DataGrid.Columns><DataGridTextColumn Header="Código" SortMemberPath="code" Binding="{Binding Code}" Width="105"/><DataGridTextColumn Header="Descripción" SortMemberPath="description" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Departamento" SortMemberPath="department" Binding="{Binding Department}" Width="145"/><DataGridTextColumn Header="Costo" SortMemberPath="cost" Binding="{Binding Cost, StringFormat={}{0:C2}}" Width="90"/><DataGridTextColumn Header="Menudeo" SortMemberPath="price" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="95"/><DataGridTextColumn Header="Mayoreo" SortMemberPath="wholesale" Binding="{Binding WholesaleText}" Foreground="#7A4EAB" Width="145"/><DataGridTextColumn Header="Utilidad" SortMemberPath="profit" Binding="{Binding ProfitPercent, StringFormat={}{0:0.##}%}" Width="78"/><DataGridTextColumn Header="Existencia" SortMemberPath="stock" Binding="{Binding Stock, StringFormat={}{0:0.###}}" Width="90"/><DataGridTextColumn Header="Mín." Binding="{Binding MinimumStock, StringFormat={}{0:0.###}}" Width="70"/><DataGridTextColumn Header="Máx." Binding="{Binding MaximumStock, StringFormat={}{0:0.###}}" Width="70"/></DataGrid.Columns></DataGrid>
      <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FormTitleText" Text="Nuevo producto" FontSize="19" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Código" Margin="0,14,0,4"/><TextBox x:Name="CodeBox"/><TextBlock Text="Descripción" Margin="0,9,0,4"/><TextBox x:Name="DescriptionBox"/><TextBlock Text="Departamento (opcional)" Margin="0,9,0,4"/><ComboBox x:Name="DepartmentBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="Unidad de venta" Margin="0,9,0,4"/><ComboBox x:Name="UnitBox" ItemsSource="{StaticResource UnitOptions}" SelectedIndex="0"/><TextBlock x:Name="WeightUnitHintText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/><UniformGrid Columns="2" Margin="0,11,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Costo"/><TextBox x:Name="CostBox" Text="0.00" LostFocus="OnPricingChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="ProfitPercentBox" Text="20" LostFocus="OnPricingChanged" Margin="0,4,0,0"/></StackPanel></UniformGrid><Border Background="#EAF3F8" BorderBrush="#C8DCE9" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,10,0,0"><StackPanel><TextBlock Text="Precio de menudeo" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/><UniformGrid Columns="2" Margin="0,5,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Precio venta"/><TextBox x:Name="PriceBox" Text="0.00" TextChanged="OnPriceChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Ganancia $"/><TextBox x:Name="ProfitAmountBox" IsReadOnly="True" Margin="0,4,0,0"/></StackPanel></UniformGrid></StackPanel></Border><Border Background="#F2ECF8" BorderBrush="#D4C3E5" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,8,0,0"><StackPanel><TextBlock Text="Precio de mayoreo (opcional)" FontWeight="SemiBold" Foreground="#7A4EAB"/><UniformGrid Columns="2" Margin="0,5,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Precio mayoreo"/><TextBox x:Name="WholesalePriceBox" Text="0.00" TextChanged="OnWholesalePriceChanged" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="WholesaleProfitPercentBox" Text="0" LostFocus="OnWholesalePricingChanged" Margin="0,4,0,0"/></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Ganancia $"/><TextBox x:Name="WholesaleProfitAmountBox" IsReadOnly="True"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Mínimo de artículos"/><TextBox x:Name="WholesaleMinimumBox" Text="0"/></StackPanel></UniformGrid></StackPanel></Border><Border Background="#F7FAF5" BorderBrush="#CFE1C5" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,8,0,0"><StackPanel><TextBlock Text="Inventario" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/><UniformGrid Columns="3" Margin="0,5,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Existencia inicial"/><TextBox x:Name="InitialStockBox" Text="0" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0"><TextBlock Text="Mínimo"/><TextBox x:Name="MinimumStockBox" Text="0" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Máximo"/><TextBox x:Name="MaximumStockBox" Text="0" Margin="0,4,0,0"/></StackPanel></UniformGrid><TextBlock Text="La existencia inicial sólo se captura al crear. Para cambiarla después usa Inventario > Ajustar." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><CheckBox x:Name="IsKitBox" Content="Es kit o producto compuesto" Margin="0,12,0,0"/><UniformGrid Columns="3" Margin="0,16,0,0"><Button Click="OnNewClick">Nuevo</Button><Button Style="{StaticResource ConfirmButtonStyle}" Click="OnSaveClick">Guardar</Button><Button Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick">Retirar</Button></UniformGrid></StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource PreviousButtonStyle}" x:Name="PreviousPageButton" Content="Anterior" Click="OnPreviousPageClick" Margin="0,0,6,0"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="6,0"/><Button Style="{StaticResource NextButtonStyle}" x:Name="NextPageButton" Content="Siguiente" Click="OnNextPageClick" Margin="6,0,0,0"/></StackPanel></Grid>
  </Grid>
</UserControl>
