<Window x:Class="Pos.Desktop.ProductCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Productos" Width="1050" Height="650" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <x:Array x:Key="UnitOptions" Type="{x:Type sys:String}">
            <sys:String>Pieza</sys:String>
            <sys:String>Kilogramo</sys:String>
            <sys:String>Gramo</sys:String>
            <sys:String>Litro</sys:String>
            <sys:String>Mililitro</sys:String>
            <sys:String>Metro</sys:String>
            <sys:String>Servicio</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
            <Border Width="46" Height="46" Background="#E7F3FB" CornerRadius="5"><icons:PackIconMaterial Kind="PackageVariantClosed" Width="27" Height="27" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="12,0,0,0"><TextBlock Text="Catalogo de productos" FontSize="22" FontWeight="Bold"/><TextBlock Text="Buscar, agregar, editar o desactivar productos" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Height="38" TextChanged="OnSearchChanged" ToolTip="Codigo o descripcion"/>
            <DataGrid Grid.Row="1" x:Name="ProductsGrid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codigo" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding UnitOfMeasure}" Width="105"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat=C2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Border Grid.Row="1" Grid.Column="2" Margin="0,18,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" CornerRadius="5" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="FormTitleText" Text="Nuevo producto" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Codigo" Margin="0,14,0,4"/><TextBox x:Name="CodeBox"/>
                <TextBlock Text="Descripcion" Margin="0,10,0,4"/><TextBox x:Name="DescriptionBox"/>
                <TextBlock Text="Unidad de venta" Margin="0,10,0,4"/>
                <ComboBox x:Name="UnitBox" ItemsSource="{StaticResource UnitOptions}" SelectedIndex="0"/>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Costo"/><TextBox x:Name="CostBox" Text="0.00" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Margin="5,0,0,0"><TextBlock Text="Precio venta"/><TextBox x:Name="PriceBox" Text="0.00" Margin="0,4,0,0"/></StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Precio mayoreo"/><TextBox x:Name="WholesalePriceBox" Text="0.00" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Margin="5,0,0,0"><TextBlock Text="Minimo mayoreo"/><TextBox x:Name="WholesaleMinimumBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                </UniformGrid>
                <CheckBox x:Name="IsKitBox" Content="Es kit o producto compuesto" Margin="0,12,0,0"/>
                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <Button Click="OnNewClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Nuevo"/></StackPanel></Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Guardar"/></StackPanel></Button>
                    <Button Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ArchiveRemoveOutline" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Desactivar"/></StackPanel></Button>
                </UniformGrid>
            </StackPanel></ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
