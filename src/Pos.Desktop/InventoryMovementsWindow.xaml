<Window x:Class="Pos.Desktop.InventoryMovementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Movimientos de inventario - JetVenta" Width="1180" Height="720" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#E6EEF8" CornerRadius="8"><icons:PackIconMaterial Kind="TimelineClockOutline" Width="25" Height="25" Foreground="#376A9A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Movimientos de inventario" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Entradas, salidas, ajustes y ventas registradas" Foreground="#637589"/></StackPanel></StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="36" Padding="10,7" ToolTip="Código, descripción o motivo" TextChanged="OnSearchChanged"/><Button Grid.Column="1" Height="36" Width="110" Margin="10,0,0,0" Click="OnRefreshClick">Actualizar</Button><Button Grid.Column="2" Height="36" Width="90" Margin="8,0,0,0" Click="OnCloseClick">Cerrar</Button></Grid>
        <DataGrid Grid.Row="2" x:Name="MovementsGrid" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="34">
            <DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="145"/><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="105"/><DataGridTextColumn Header="Producto" Binding="{Binding Description}" Width="240"/><DataGridTextColumn Header="Movimiento" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="105"/><DataGridTextColumn Header="Antes" Binding="{Binding StockBefore, StringFormat={}{0:0.###}}" Width="90"/><DataGridTextColumn Header="Después" Binding="{Binding StockAfter, StringFormat={}{0:0.###}}" Width="95"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="190"/><DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="150"/></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Width="110" Height="35" Click="OnPreviousPageClick">Anterior</Button><Button Grid.Column="1" Width="110" Height="35" Margin="8,0,0,0" Click="OnNextPageClick">Siguiente</Button><TextBlock Grid.Column="2" x:Name="PageInfoText" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#637589"/><TextBlock Grid.Column="3" x:Name="StatusText" VerticalAlignment="Center" Foreground="#637589"/></Grid>
    </Grid>
</Window>
