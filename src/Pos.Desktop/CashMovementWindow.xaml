<Window x:Class="Pos.Desktop.CashMovementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Movimiento de efectivo" Width="520" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock Text="Movimiento de efectivo" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <TextBlock x:Name="TypeText" Margin="0,16,0,10" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Importe" /><TextBox x:Name="AmountTextBox" Margin="0,4,0,10" Height="34" FontSize="18" />
        <TextBlock Text="Concepto o motivo" /><TextBox x:Name="ReasonTextBox" Margin="0,4,0,10" Height="34" />
        <StackPanel x:Name="SupplierPanel" Visibility="Collapsed">
            <TextBlock Text="Proveedor (opcional)" />
            <TextBox x:Name="SupplierSearchTextBox" Margin="0,4,0,4" Height="32" TextChanged="OnSupplierSearchChanged" />
            <ListBox x:Name="SupplierList" Height="70" DisplayMemberPath="DisplayText" MouseDoubleClick="OnSupplierSelected" Visibility="Collapsed" />
            <TextBlock Text="Puedes elegir un proveedor para completar el concepto o escribirlo manualmente." Foreground="#526577" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Button Height="38" Margin="0,16,0,0" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Registrar movimiento</Button>
        <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
