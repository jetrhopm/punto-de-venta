<Window x:Class="Pos.Desktop.CashMovementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Movimiento de efectivo" Width="440" Height="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock Text="Movimiento de efectivo" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <ComboBox x:Name="TypeComboBox" Margin="0,16,0,10" Height="34" SelectedIndex="0"><ComboBoxItem Content="Entrada" Tag="In" /><ComboBoxItem Content="Salida" Tag="Out" /></ComboBox>
        <TextBlock Text="Importe" /><TextBox x:Name="AmountTextBox" Margin="0,4,0,10" Height="34" FontSize="18" />
        <TextBlock Text="Concepto" /><TextBox x:Name="ReasonTextBox" Margin="0,4,0,12" Height="34" />
        <Button Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Registrar movimiento</Button>
        <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
