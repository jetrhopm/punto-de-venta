<Window x:Class="Pos.Desktop.MercadoPagoPaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Cobro con Mercado Pago" Width="520" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Closing="OnClosing">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Center"><Border Width="64" Height="64" Background="#E3F5FC" CornerRadius="8"><icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="39" Height="39" Foreground="#009EE3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Completa el pago en la terminal" FontSize="23" FontWeight="Bold" Foreground="#17324D" Margin="0,16,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="AmountText" FontSize="31" FontWeight="Bold" Foreground="#146CB0" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center"><ProgressBar Height="8" IsIndeterminate="True"/><TextBlock x:Name="StatusText" Text="Enviando el cobro a Mercado Pago Point..." TextAlignment="Center" TextWrapping="Wrap" Foreground="#526577" Margin="0,18,0,0"/><TextBlock Text="La venta todavía no está confirmada. No cierres esta ventana hasta conocer el resultado." TextAlignment="Center" TextWrapping="Wrap" Foreground="#8A5B00" Margin="20,10"/></StackPanel>
    <Button x:Name="CancelButton" Grid.Row="2" Content="Cancelar cobro" Height="40" Click="OnCancelClick"/>
  </Grid>
</Window>
