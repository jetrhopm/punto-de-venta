<Window x:Class="Pos.Desktop.StoreSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Datos de la tienda" Width="700" Height="630" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="StoreOutline" Width="27" Height="27" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Datos de la tienda" FontSize="22" FontWeight="Bold"/><TextBlock Text="Información comercial y fiscal" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Nombre comercial" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,5,0,14"/><TextBlock Text="Giro" FontWeight="SemiBold"/><ComboBox x:Name="BusinessTypeBox" Margin="0,5,0,14" IsEditable="True"><ComboBoxItem>Abarrotes</ComboBoxItem><ComboBoxItem>Minisúper</ComboBoxItem><ComboBoxItem>Farmacia</ComboBoxItem><ComboBoxItem>Papelería</ComboBoxItem><ComboBoxItem>Ferretería</ComboBoxItem><ComboBoxItem>Comercio general</ComboBoxItem><ComboBoxItem>Otro</ComboBoxItem></ComboBox><TextBlock Text="Razón social" FontWeight="SemiBold"/><TextBox x:Name="LegalNameBox" Margin="0,5,0,14"/><TextBlock Text="RFC" FontWeight="SemiBold"/><TextBox x:Name="TaxIdBox" Margin="0,5,0,14"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Teléfono" FontWeight="SemiBold"/><TextBox x:Name="PhoneBox" Margin="0,5,0,14"/><TextBlock Text="Zona horaria" FontWeight="SemiBold"/><TextBox x:Name="TimeZoneBox" Margin="0,5,0,14" Text="America/Mexico_City"/><TextBlock Text="Dirección" FontWeight="SemiBold"/><TextBox x:Name="AddressBox" Height="132" Margin="0,5,0,14" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,7" Margin="0,3,12,3"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Border><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="175" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar cambios"/></StackPanel></Button></Grid>
    </Grid>
</Window>
