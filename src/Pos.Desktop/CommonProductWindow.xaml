<Window x:Class="Pos.Desktop.CommonProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Producto común" Width="570" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#FFF4DE" CornerRadius="5"><icons:PackIconMaterial Kind="TagOutline" Width="26" Height="26" Foreground="#A96300" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Producto común" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Se agrega sólo al ticket actual. No se incorpora al inventario." Foreground="#526577" Margin="0,3,0,0"/></StackPanel></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Código (opcional)" FontWeight="SemiBold"/><TextBox x:Name="CodeBox" Height="36" Margin="0,5,0,12" ToolTip="Puedes dejarlo vacío para un artículo temporal"/>
            <TextBlock Text="Nombre o descripción" FontWeight="SemiBold"/><TextBox x:Name="DescriptionBox" Height="36" Margin="0,5,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Precio unitario" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Height="36" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Cantidad" FontWeight="SemiBold"/><TextBox x:Name="QuantityBox" Height="36" Margin="0,5,0,0"/></StackPanel></Grid>
            <TextBlock Text="Unidad de venta" FontWeight="SemiBold" Margin="0,15,0,5"/><ComboBox x:Name="UnitBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Pieza"/><ComboBoxItem Content="Kilogramo (granel)" Tag="Kilogramo"/><ComboBoxItem Content="Gramo (granel)" Tag="Gramo"/><ComboBoxItem Content="Litro"/><ComboBoxItem Content="Mililitro"/><ComboBoxItem Content="Metro"/><ComboBoxItem Content="Servicio"/></ComboBox>
            <TextBlock x:Name="MessageText" Foreground="#B42318" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="112" Height="38" Margin="0,0,8,0" Style="{StaticResource CancelButtonStyle}" IsCancel="True" Click="OnCancelClick">Cancelar</Button><Button Width="168" Height="38" Style="{StaticResource ConfirmButtonStyle}" IsDefault="True" Click="OnAcceptClick">Agregar al ticket</Button></StackPanel>
    </Grid>
</Window>
