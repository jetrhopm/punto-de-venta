<UserControl x:Class="Pos.Desktop.InventoryWindow" x:Name="InventoryRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Background="#F4F7FB">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E0EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="#E4F2EC" CornerRadius="8"><icons:PackIconMaterial Kind="Warehouse" Width="28" Height="28" Foreground="#238A68" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Inventario" FontSize="26" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Existencias, valoración y movimientos" Foreground="#637589" Margin="0,2,0,0"/></StackPanel>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#F1F7FC" BorderBrush="#CFE1F0" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,8,6"><StackPanel><TextBlock Text="Consulta" FontSize="10" FontWeight="SemiBold" Foreground="#637589" Margin="2,0,0,4"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ActionButton}" Click="OnRefreshClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Actualizar"/></StackPanel></Button><Button Style="{StaticResource ActionButton}" Click="OnMovementsClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="TimelineClockOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Movimientos"/></StackPanel></Button></StackPanel></StackPanel></Border>
                <Border Background="#FFF9E8" BorderBrush="#E8D59A" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,8,6"><StackPanel><TextBlock Text="Selección" FontSize="10" FontWeight="SemiBold" Foreground="#637589" Margin="2,0,0,4"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ActionButton}" Click="OnSelectVisibleClick">Seleccionar todos</Button><Button Style="{StaticResource ActionButton}" Click="OnClearSelectionClick" Margin="0">Desmarcar todos</Button></StackPanel></StackPanel></Border>
                <Border Background="#EDF8F2" BorderBrush="#C6E4D3" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,8,6"><StackPanel><TextBlock Text="Operación" FontSize="10" FontWeight="SemiBold" Foreground="#637589" Margin="2,0,0,4"/><Button Style="{StaticResource ActionButton}" Click="OnAdjustmentClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PlusMinusBox" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Ajustar existencia"/></StackPanel></Button></StackPanel></Border>
                <Border Background="#F4F1FA" BorderBrush="#D8CCE8" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,6"><StackPanel><TextBlock Text="Archivo" FontSize="10" FontWeight="SemiBold" Foreground="#637589" Margin="2,0,0,4"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ActionButton}" Click="OnImportClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="FileImportOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Importar"/></StackPanel></Button><Button Style="{StaticResource ActionButton}" Click="OnExportClick" Margin="0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="FileExportOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Exportar"/></StackPanel></Button></StackPanel></StackPanel></Border>
            </WrapPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,18,0,14">
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Productos" Foreground="#637589"/><TextBlock x:Name="ProductsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="en catálogo" Foreground="#637589" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Unidades" Foreground="#637589"/><TextBlock x:Name="UnitsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="existencia total" Foreground="#637589" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Valor de compra" Foreground="#637589"/><TextBlock x:Name="CostValueText" Text="$0.00" FontSize="21" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="costo del inventario" Foreground="#637589" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Valor de venta" Foreground="#637589"/><TextBlock x:Name="SaleValueText" Text="$0.00" FontSize="21" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="si se vende todo" Foreground="#637589" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Utilidad potencial" Foreground="#637589"/><TextBlock x:Name="ProfitValueText" Text="$0.00" FontSize="21" FontWeight="Bold" Foreground="#238A68"/><TextBlock Text="venta menos costo" Foreground="#637589" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Alertas" Foreground="#637589"/><TextBlock x:Name="AlertsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#B54708"/><TextBlock x:Name="AlertsDetailText" Text="sin faltantes" Foreground="#637589" FontSize="11"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="36" Padding="10,7" ToolTip="Código o descripción" TextChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="1" x:Name="StatusBox" Height="36" Margin="10,0,0,0" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="Todos" Tag="" IsSelected="True"/><ComboBoxItem Content="Normal" Tag="normal"/><ComboBoxItem Content="Bajo mínimo" Tag="bajo"/><ComboBoxItem Content="Sobre máximo" Tag="sobre"/><ComboBoxItem Content="Agotado" Tag="agotado"/></ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,15,0"><TextBlock x:Name="StatusText" Foreground="#637589"/><TextBlock x:Name="SelectionText" Margin="12,0,0,0" Foreground="#146CB0" FontWeight="SemiBold"/></StackPanel>
            <Button Grid.Column="3" Height="36" Padding="12,5" Click="OnCloseClick">Cerrar</Button>
        </Grid>

        <DataGrid Grid.Row="3" x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnInventorySelectionChanged" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" Sorting="OnSorting" CellEditEnding="OnCellEditEnding" HeadersVisibility="Column" RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" SortMemberPath="code" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Description}" SortMemberPath="description" IsReadOnly="True" Width="230"/>
                <DataGridTemplateColumn Header="Departamento" SortMemberPath="department" Width="170">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <ComboBox ItemsSource="{Binding DepartmentOptions, ElementName=InventoryRoot}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="OnDepartmentChanged" ToolTip="Asigna el departamento del producto"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tipo" Binding="{Binding UnitOfMeasure}" SortMemberPath="unit" IsReadOnly="True" Width="105"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding Cost, StringFormat={}{0:C2}}" SortMemberPath="cost" IsReadOnly="True" Width="92"/>
                <DataGridTextColumn Header="P. venta" Binding="{Binding Price, StringFormat={}{0:C2}}" SortMemberPath="price" IsReadOnly="True" Width="98"/>
                <DataGridTextColumn Header="Existencia" Binding="{Binding StockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="stock" Width="100"/>
                <DataGridTextColumn Header="Inv. mínimo" Binding="{Binding MinimumStockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="minimum" Width="105"/>
                <DataGridTextColumn Header="Inv. máximo" Binding="{Binding MaximumStockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="maximum" Width="105"/>
                <DataGridTextColumn Header="Valor compra" Binding="{Binding CostValue, StringFormat={}{0:C2}}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Valor venta" Binding="{Binding SaleValue, StringFormat={}{0:C2}}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Utilidad" Binding="{Binding PotentialProfit, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" SortMemberPath="status" IsReadOnly="True" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource PreviousButtonStyle}" Width="110" Height="35" Click="OnPreviousPageClick">Anterior</Button><Button Style="{StaticResource NextButtonStyle}" Grid.Column="1" Width="110" Height="35" Margin="8,0,0,0" Click="OnNextPageClick">Siguiente</Button>
            <TextBlock Grid.Column="2" x:Name="PageInfoText" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#637589"/>
            <TextBlock Grid.Column="3" Text="Para editar existencia, mínimos o máximos: doble clic rápido sobre la celda. Cada cambio queda registrado como movimiento." VerticalAlignment="Center" Foreground="#637589" FontSize="11" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
