<Window x:Class="Pos.Desktop.JetVentaAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="JetVenta" Width="580" SizeToContent="Height" MinHeight="270"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Closing="OnClosing">
    <Border Margin="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Effect="{StaticResource PanelShadowEffect}">
        <Grid Margin="26,24,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconSurface" Width="50" Height="50" CornerRadius="6" VerticalAlignment="Top">
                    <icons:PackIconMaterial x:Name="SeverityIcon" Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,1,0,0">
                    <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SeverityText" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" x:Name="MessageSurface" Margin="0,20,0,22" Padding="15,13" CornerRadius="5" BorderThickness="1">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource DangerButtonStyle}" MinWidth="112" Margin="5,0,0,0" Click="OnCancelClick"/>
                <Button x:Name="DeclineButton" Grid.Column="2" Style="{StaticResource DangerButtonStyle}" MinWidth="112" Margin="5,0,0,0" Click="OnDeclineClick"/>
                <Button x:Name="AcceptButton" Grid.Column="3" Style="{StaticResource SuccessButtonStyle}" MinWidth="128" Margin="7,0,0,0" Click="OnAcceptClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
