<Window x:Class="Pos.Desktop.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="JetVenta" Width="540" Height="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Loaded="OnLoaded">
    <Border Background="White" BorderBrush="#D8E4EC" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="14,14,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EAF7FF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.58"/>
                        <GradientStop Color="#E9FAF4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="40,28,40,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="132"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Source="/Assets/jetventa-banner.png" Width="400" Height="132" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Grid.Row="1" x:Name="VersionText" Text="Version" FontSize="13" Foreground="#607987" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" x:Name="StoreNameText" Text="Preparando tienda" FontSize="18" FontWeight="SemiBold" Foreground="#102F46" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="40,28,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Revisando que todo este listo" FontSize="22" FontWeight="SemiBold" Foreground="#102F46"/>
                <TextBlock x:Name="CurrentStatusText" Grid.Row="1" Margin="0,8,0,0" Text="Preparando JetVenta..." FontSize="14" Foreground="#607987" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <icons:PackIconMaterial Kind="DatabaseCheckOutline" Width="22" Height="22" Foreground="#1E78B8"/>
                        <TextBlock Grid.Column="1" Text="Datos de la tienda" FontSize="14" Foreground="#102F46"/>
                        <TextBlock Grid.Column="2" x:Name="DataStatusText" Text="Pendiente" FontSize="13" Foreground="#607987"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <icons:PackIconMaterial Kind="CogSyncOutline" Width="22" Height="22" Foreground="#1E78B8"/>
                        <TextBlock Grid.Column="1" Text="Servicios de JetVenta" FontSize="14" Foreground="#102F46"/>
                        <TextBlock Grid.Column="2" x:Name="ServiceStatusText" Text="Pendiente" FontSize="13" Foreground="#607987"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <icons:PackIconMaterial Kind="StoreCheckOutline" Width="22" Height="22" Foreground="#1E78B8"/>
                        <TextBlock Grid.Column="1" Text="Tienda y caja" FontSize="14" Foreground="#102F46"/>
                        <TextBlock Grid.Column="2" x:Name="StoreStatusText" Text="Pendiente" FontSize="13" Foreground="#607987"/>
                    </Grid>
                </StackPanel>

                <ProgressBar Grid.Row="3" x:Name="StartupProgress" Height="12" Margin="0,26,0,0" Minimum="0" Maximum="100" Value="8"/>

                <StackPanel Grid.Row="4" x:Name="ErrorPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Button Width="165" Height="38" Margin="0,0,10,0" Content="Configurar conexión" Click="OnConfigureClick"/>
                    <Button Width="145" Height="38" Margin="0,0,10,0" Content="Reparar servicios" Click="OnRepairClick"/>
                    <Button Width="90" Height="38" Content="Cerrar" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
