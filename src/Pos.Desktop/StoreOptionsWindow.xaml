<Window x:Class="Pos.Desktop.StoreOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Opciones habilitadas" Width="760" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#E7F3FB" CornerRadius="6"><icons:PackIconMaterial Kind="TuneVariant" Width="27" Height="27" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Opciones habilitadas" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Define cómo trabaja JetVenta con inventario, crédito y precios." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="InventoryEnabledBox" Content="Utilizar inventario para mis productos" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Controla existencias, entradas, salidas, mínimos y máximos. Puedes activarlo después si hoy no llevas inventario." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="22,0,0,10"/>
                        <Grid Margin="22,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Método de costo de inventario" VerticalAlignment="Center"/><ComboBox x:Name="CostMethodBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Tag="WeightedAverage">Costo promedio ponderado</ComboBoxItem></ComboBox><TextBlock Grid.Column="2" Text="Se actualiza al recibir compras." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid>
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="CreditSalesEnabledBox" Content="Deseo ofrecer crédito a mis clientes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Permite cobrar a crédito, registrar abonos y consultar el saldo de los clientes." Foreground="{StaticResource TextMutedBrush}" Margin="22,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="CommonProductsEnabledBox" Content="Habilitar venta de producto común" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Permite registrar durante la venta un artículo que todavía no existe en el catálogo, con permiso." Foreground="{StaticResource TextMutedBrush}" Margin="22,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="AutoPriceBox" Content="Calcular automáticamente el precio de venta con el margen de ganancia" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="22,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Margen predeterminado al crear o recibir productos" VerticalAlignment="Center"/><TextBox x:Name="DefaultProfitBox" Grid.Column="1" Height="30" Text="20"/><TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
                        <TextBlock Text="Si escribes un precio manual, ese precio tiene prioridad. El margen se usa cuando el precio está vacío." Foreground="{StaticResource TextMutedBrush}" Margin="22,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="RoundAmountsBox" Content="Habilitar redondeo de centavos a cantidad cerrada" FontWeight="SemiBold" Margin="0,0,0,8" Checked="OnRoundChanged" Unchecked="OnRoundChanged"/>
                        <Grid Margin="22,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tipo de redondeo" VerticalAlignment="Center"/><ComboBox x:Name="RoundingModeBox" Grid.Column="1" SelectionChanged="OnRoundChanged"><ComboBoxItem Tag="Tenths">A décimas (45.52 → 45.60, 35.18 → 35.20)</ComboBoxItem><ComboBoxItem Tag="Whole">A pesos cerrados (45.52 → 46.00)</ComboBoxItem></ComboBox></Grid>
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Avisos ocasionales" FontWeight="SemiBold" Foreground="#17324D"/>
                        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="Mostrar aviso" VerticalAlignment="Center"/><TextBox x:Name="NoticeBox" Grid.Column="1" Height="30"/><TextBlock Grid.Column="2" Text="cada" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="NoticeEveryBox" Grid.Column="3" Height="30" Text="5"/></Grid>
                        <TextBlock Text="El aviso se mostrará al cajero después de cobrar el número indicado de ventas. Déjalo vacío para no mostrar avisos." Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Width="170" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar cambios"/></StackPanel></Button></Grid>
    </Grid>
</Window>
