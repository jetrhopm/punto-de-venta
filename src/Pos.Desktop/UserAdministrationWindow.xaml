<Window x:Class="Pos.Desktop.UserAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Usuarios y permisos"
        Width="1240"
        Height="860"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" Background="#E9E3F1" CornerRadius="5">
                <icons:PackIconMaterial Kind="AccountGroupOutline" Width="27" Height="27" Foreground="#76538D"/>
            </Border>
            <StackPanel Margin="12,1,0,0">
                <TextBlock Text="Usuarios y permisos" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Controla quién puede operar cada función de la tienda." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid x:Name="ListPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Usuarios registrados" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Selecciona una cuenta para editarla, activarla o desactivarla." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Click="OnCreateClick" MinWidth="174">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <icons:PackIconMaterial Kind="AccountPlusOutline" Width="19" Height="19" Margin="0,0,7,0"/>
                            <TextBlock Text="Crear usuario"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="UsersGrid" Margin="0,14,0,12" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnUserSelected" MouseDoubleClick="OnUserDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="1.1*"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="1.7*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="130"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="EditButton" Click="OnEditClick" MinWidth="185" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <icons:PackIconMaterial Kind="PencilOutline" Width="19" Height="19" Margin="0,0,7,0"/>
                            <TextBlock Text="Editar seleccionado"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusButton" Click="OnToggleStatusClick" MinWidth="250">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <icons:PackIconMaterial Kind="AccountCheckOutline" Width="19" Height="19" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusButtonText" Text="Activar o desactivar seleccionado"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,7" Margin="0,12,0,0">
                    <TextBlock x:Name="ListStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <Border x:Name="EditorPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="EditorTitleText" Text="Crear usuario" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EditorDescriptionText" Text="Completa los datos y define los permisos de la cuenta." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Click="OnCancelEditorClick" MinWidth="120">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <icons:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="Volver"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <UniformGrid Columns="2" Margin="0,18,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Usuario" FontWeight="SemiBold"/>
                                <TextBox x:Name="NewUserBox" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Nombre para mostrar" FontWeight="SemiBold"/>
                                <TextBox x:Name="NewNameBox" Margin="0,5,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock x:Name="PasswordLabelText" Text="Contraseña" FontWeight="SemiBold" Margin="0,14,0,5"/>
                        <PasswordBox x:Name="NewPasswordBox"/>
                        <TextBlock x:Name="PasswordHintText" Text="La contraseña es obligatoria para crear la cuenta." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>

                        <CheckBox x:Name="NewAdminBox" Content="Crear como administrador" Margin="0,14,0,0" Checked="OnAdministratorChanged" Unchecked="OnAdministratorChanged"/>
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock x:Name="PermissionHintText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <TextBlock Text="Permisos" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0"/>
                        <TabControl Margin="0,9,0,0" MinHeight="240">
                            <TabItem Header="Ventas"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="SalesPermissionsPanel" Margin="12"/></ScrollViewer></TabItem>
                            <TabItem Header="Clientes"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CustomerPermissionsPanel" Margin="12"/></ScrollViewer></TabItem>
                            <TabItem Header="Productos"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ProductPermissionsPanel" Margin="12"/></ScrollViewer></TabItem>
                            <TabItem Header="Inventario"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="InventoryPermissionsPanel" Margin="12"/></ScrollViewer></TabItem>
                            <TabItem Header="Otros"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="OtherPermissionsPanel" Margin="12"/></ScrollViewer></TabItem>
                        </TabControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Click="OnCancelEditorClick" MinWidth="135" Margin="0,0,8,0">
                                <TextBlock Text="Cancelar (Esc)"/>
                            </Button>
                            <Button x:Name="SaveButton" Style="{StaticResource ConfirmButtonStyle}" Click="OnSaveClick" IsDefault="True" MinWidth="165">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/>
                                    <TextBlock Text="Guardar (Enter)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,7" Margin="0,12,0,0">
                            <TextBlock x:Name="EditorStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
