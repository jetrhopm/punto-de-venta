<Window x:Class="Pos.Desktop.UserAdministrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Usuarios y permisos" Width="980" Height="680" WindowStartupLocation="CenterOwner">
    <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Administradores y cajeros" FontSize="21" FontWeight="Bold" Foreground="#17324D"/><DataGrid Grid.Row="1" x:Name="UsersGrid" Margin="0,14,0,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnUserSelected"><DataGrid.Columns><DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="1.5*"/><DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdministrator}"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" x:Name="StatusButton" Height="34" Click="OnToggleStatusClick">Activar o desactivar seleccionado</Button></Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,0,0,0"><TextBlock Text="Crear usuario" FontSize="19" FontWeight="SemiBold" Foreground="#17324D"/><UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,8,0"><TextBlock Text="Usuario"/><TextBox x:Name="NewUserBox" Height="32"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Nombre"/><TextBox x:Name="NewNameBox" Height="32"/></StackPanel></UniformGrid><TextBlock Text="Contraseña" Margin="0,10,0,3"/><PasswordBox x:Name="NewPasswordBox" Height="32"/><CheckBox x:Name="NewAdminBox" Content="Administrador" Margin="0,10"/><Button Height="34" Click="OnCreateClick">Crear usuario</Button><Separator Margin="0,18"/><TextBlock Text="Permisos del usuario seleccionado" FontSize="19" FontWeight="SemiBold" Foreground="#17324D"/><ScrollViewer Height="220" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><WrapPanel x:Name="PermissionsPanel"/></ScrollViewer><Button Height="34" Margin="0,8,0,0" Click="OnSavePermissionsClick">Guardar permisos</Button><Separator Margin="0,18"/><TextBlock Text="Restablecer contraseña" FontWeight="SemiBold"/><PasswordBox x:Name="ResetPasswordBox" Height="32" Margin="0,6"/><Button Height="34" Click="OnResetPasswordClick">Cambiar contraseña</Button><TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#526577" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    </Grid>
</Window>
