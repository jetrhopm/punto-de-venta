<Window x:Class="Pos.Desktop.ExitShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Salir de JetVenta" Width="560" Height="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="#FFF0DC" CornerRadius="5">
                <icons:PackIconMaterial Kind="ClockAlertOutline" Width="29" Height="29" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Hay un turno abierto" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Elige como quieres salir de la caja." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Button Height="54" Margin="0,0,0,10" Style="{StaticResource SuccessButtonStyle}" Click="OnCloseShiftAndExitClick">
                <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ClipboardCheckOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Cerrar turno y salir"/></StackPanel>
            </Button>
            <Button Height="54" Margin="0,0,0,10" Click="OnLeaveOpenAndExitClick">
                <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LogoutVariant" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Dejar turno abierto y salir"/></StackPanel>
            </Button>
            <Button Height="54" Click="OnCancelClick">
                <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CloseCircleOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Cancelar"/></StackPanel>
            </Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Dejar el turno abierto no realiza corte; al volver a iniciar sesion se continuara el turno actual." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
