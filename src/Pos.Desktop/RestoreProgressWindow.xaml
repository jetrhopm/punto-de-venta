<Window x:Class="Pos.Desktop.RestoreProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurando JetVenta"
        Width="520"
        Height="220"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Restaurando la información de la tienda"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,12,0,16"
                   Text="Preparando restauración..."
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap" />
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="14"
                     IsIndeterminate="True"
                     Foreground="#16A34A"
                     Background="#DDEFE2" />
    </Grid>
</Window>
