<Window x:Class="Pos.Desktop.PriceVerifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificador de precios" Width="600" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Verificador de precios" FontSize="24" FontWeight="SemiBold" Foreground="#17324D"/>
            <TextBlock Text="F9 lee un código de barras y muestra precio. No agrega nada a la venta." Foreground="#526577" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="CodeBox" Height="42" Margin="0,20,0,16" FontSize="18" Padding="10,5" KeyDown="OnCodeKeyDown" ToolTip="Escanea o escribe el código y presiona Enter"/>
        <Border Grid.Row="2" Background="#F3F8FB" BorderBrush="#D8E4EC" BorderThickness="1" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="Producto" FontSize="12" Foreground="#526577"/>
                <TextBlock x:Name="ProductNameText" Text="Escanea un producto" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="ProductCodeText" Text="Código de barras: -" FontSize="14" Foreground="#526577" Margin="0,8,0,0"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProductPriceText" Text="$0.00" FontSize="42" FontWeight="Bold" Foreground="#146CB0" VerticalAlignment="Center"/>
                    <Border x:Name="ProductAvailabilityBadge" Grid.Column="1" Background="#E7F5EC" CornerRadius="5" Padding="12,7" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="ProductAvailabilityText" Text="Disponible" FontWeight="SemiBold" Foreground="#16834A"/>
                    </Border>
                </Grid>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Existencia" FontSize="12" Foreground="#526577"/>
                    <TextBlock x:Name="ProductStockText" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="#17324D"/>
                </StackPanel>
                <TextBlock x:Name="ProductDetailText" Text="" FontSize="14" Foreground="#526577" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
    </Grid>
</Window>
