<Window x:Class="Pos.Desktop.ProductLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Etiquetas" Width="980" Height="690" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="#F3EDFB" CornerRadius="6"><icons:PackIconMaterial Kind="Barcode" Width="27" Height="27" Foreground="#6E4B8D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="14,0,0,0"><TextBlock Text="Etiquetas" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Busca un artículo e imprime su código, descripción y precio de venta." Foreground="#526577" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
            <Border Margin="0,16,0,0" Padding="11" Background="#E8F3FB" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="5"><TextBlock Text="Puedes escanear el código de barras o escribirlo. Las etiquetas se imprimen con la impresora configurada para esta caja." Foreground="#17324D" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="40" FontSize="16" Padding="10,5" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" ToolTip="Código o descripción del producto"/>
            <Button Grid.Column="1" Margin="10,0,0,0" Height="40" Click="OnSearchClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Buscar"/></StackPanel></Button>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OnProductDoubleClick" KeyDown="OnResultsKeyDown" Margin="0,0,14,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="130"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Precio venta" Binding="{Binding PriceText}" Width="105"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding UnitOfMeasure}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Padding="16" Background="#F7F9FB" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Etiqueta seleccionada" FontSize="17" FontWeight="SemiBold" Foreground="#17324D"/>
                    <TextBlock x:Name="SelectedProductText" Text="Selecciona un producto de la lista." Foreground="#526577" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="SelectedPriceText" FontSize="21" FontWeight="Bold" Foreground="#13894B" Margin="0,7,0,0"/>
                    <TextBlock Text="Cantidad de etiquetas" FontWeight="SemiBold" Margin="0,20,0,5"/>
                    <TextBox x:Name="QuantityBox" Text="1" Height="38" Padding="9,5" PreviewMouseDown="OnQuantityPreviewMouseDown"/>
                    <TextBlock Text="Vista previa" FontSize="16" FontWeight="SemiBold" Foreground="#17324D" Margin="0,20,0,6"/>
                    <Border Background="White" BorderBrush="#CCD9E3" BorderThickness="1" Padding="5"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="245"><ContentControl x:Name="PreviewHost"/></ScrollViewer></Border>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#526577" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <Button Grid.Column="1" x:Name="PrintButton" Style="{StaticResource ConfirmButtonStyle}" Height="42" Click="OnPrintClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="Printer" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Imprimir"/></StackPanel></Button>
            <Button Grid.Column="2" Margin="10,0,0,0" Height="42" Style="{StaticResource CancelButtonStyle}" Click="OnCloseClick">Cerrar</Button>
        </Grid>
    </Grid>
</Window>
