<Window x:Class="Pos.Desktop.TicketSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Configuracion de ticket" Width="900" Height="650" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
            <Border Width="46" Height="46" Background="#E7F3FB" CornerRadius="5"><icons:PackIconMaterial Kind="ReceiptTextOutline" Width="27" Height="27" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="12,0,0,0"><TextBlock Text="Formato del ticket" FontSize="22" FontWeight="Bold"/><TextBlock Text="Edita los textos y revisa el resultado antes de guardar" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Encabezado" FontWeight="SemiBold"/><TextBox x:Name="HeaderBox" Height="90" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnPreviewChanged"/>
            <TextBlock Text="Mensaje final" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBox x:Name="FooterBox" Height="70" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnPreviewChanged"/>
            <TextBlock Text="Ancho de papel" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <ComboBox x:Name="WidthBox" Width="150" Margin="0,5,0,0" HorizontalAlignment="Left" SelectionChanged="OnPreviewChanged"><ComboBoxItem>58</ComboBoxItem><ComboBoxItem>80</ComboBoxItem></ComboBox>
            <TextBlock Text="La vista previa usa una venta de ejemplo. No registra movimientos ni imprime." Margin="0,18,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="2" Margin="0,20,0,0" Background="#EEF2F4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border x:Name="TicketPaper" Width="260" Padding="18" Background="White" BorderBrush="#CCD6DD" BorderThickness="1" HorizontalAlignment="Center"><TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12" TextAlignment="Left" TextWrapping="NoWrap"/></Border></ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Padding="22,8" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar formato"/></StackPanel></Button></Grid>
    </Grid>
</Window>
