<Window x:Class="Pos.Desktop.TicketSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Diseño del ticket - JetVenta" Width="1180" Height="780" MinWidth="1050" MinHeight="690"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="50" Height="50" Background="{StaticResource PrimarySoftBrush}" CornerRadius="6">
                    <icons:PackIconMaterial Kind="ReceiptTextOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,1,0,0">
                    <TextBlock Text="Diseño del ticket de venta" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Personaliza los datos comerciales y revisa el resultado completo" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#E4F2EC" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="EyeOutline" Width="17" Height="17" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/><TextBlock Text="Vista en tiempo real" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Datos impresos" FontSize="17" FontWeight="Bold"/>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,0"><TextBlock Text="Nombre comercial" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="StoreNameBox" MaxLength="160" TextChanged="OnPreviewChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Razón social" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="LegalNameBox" MaxLength="200" TextChanged="OnPreviewChanged"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,0"><TextBlock Text="RFC" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="TaxIdBox" MaxLength="20" TextChanged="OnPreviewChanged"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="PhoneBox" MaxLength="30" TextChanged="OnPreviewChanged"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBox x:Name="AddressBox" MaxLength="300" TextChanged="OnPreviewChanged"/>

                    <Separator Margin="0,20,0,18"/>
                    <TextBlock Text="Mensajes" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Encabezado adicional" FontWeight="SemiBold" Margin="0,13,0,5"/>
                    <TextBox x:Name="HeaderBox" Height="70" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" TextChanged="OnPreviewChanged"/>
                    <TextBlock Text="Mensaje final" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <TextBox x:Name="FooterBox" Height="70" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" TextChanged="OnPreviewChanged"/>

                    <Separator Margin="0,20,0,18"/>
                    <TextBlock Text="Formato" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Ancho del papel" FontWeight="SemiBold" Margin="0,13,0,6"/>
                    <Grid Height="42" Width="300" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="Width58Button" GroupName="TicketWidth" Content="58 mm" Style="{StaticResource SegmentRadioStyle}" Checked="OnPreviewChanged"/>
                        <RadioButton x:Name="Width80Button" Grid.Column="1" GroupName="TicketWidth" Content="80 mm" Style="{StaticResource SegmentRadioStyle}" Checked="OnPreviewChanged"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#E8EEF2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Ticket muestra" FontSize="17" FontWeight="Bold"/><TextBlock Text="Los productos y cantidades son datos de ejemplo" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/></StackPanel>
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" VerticalAlignment="Center"><TextBlock x:Name="PreviewWidthText" FontWeight="SemiBold"/></Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Border Background="White" BorderBrush="#B9C8D2" BorderThickness="1" HorizontalAlignment="Center" Effect="{StaticResource PanelShadowEffect}">
                            <ContentControl x:Name="TicketPreviewHost"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="25,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="3,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="175" Click="OnPrintSampleClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PrinterOutline" Width="19" Height="19" Margin="0,0,8,0"/><TextBlock Text="Imprimir muestra"/></StackPanel></Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Width="180" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,8,0"/><TextBlock Text="Guardar diseño"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
