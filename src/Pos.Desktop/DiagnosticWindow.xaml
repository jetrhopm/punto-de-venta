<Window x:Class="Pos.Desktop.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Diagnóstico - JetVenta" Width="980" Height="700" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Correcto"><Setter Property="Background" Value="#EAF7EF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Aviso"><Setter Property="Background" Value="#FFF7E6"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Problema"><Setter Property="Background" Value="#FDECEC"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pendiente"><Setter Property="Background" Value="#F1F5F9"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#FFF1E1" CornerRadius="6"><icons:PackIconMaterial Kind="Stethoscope" Width="28" Height="28" Foreground="#9A6A37" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="Diagnóstico de JetVenta" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Revisa el estado actual sin mostrar contraseñas, tokens ni claves privadas." Foreground="#526577" Margin="0,4,0,0"/></StackPanel></StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14" Background="#E8F3FB" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Productos activos" Foreground="#526577"/><TextBlock x:Name="ProductsText" FontSize="20" FontWeight="Bold" Foreground="#17324D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Ventas confirmadas" Foreground="#526577"/><TextBlock x:Name="SalesText" FontSize="20" FontWeight="Bold" Foreground="#17324D"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Respaldo más reciente" Foreground="#526577"/><TextBlock x:Name="BackupText" FontSize="13" FontWeight="SemiBold" Foreground="#17324D" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Última revisión" Foreground="#526577"/><TextBlock x:Name="CheckedText" FontSize="13" FontWeight="SemiBold" Foreground="#17324D"/></StackPanel></Grid></Border>
        <DataGrid Grid.Row="2" x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="48">
            <DataGrid.Columns><DataGridTextColumn Header="Revisión" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="Qué hacer" Binding="{Binding Action}" Width="300"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#526577" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RepairApiButton" Width="150" Margin="0,0,8,0" Click="OnRepairApiClick" ToolTip="Inicia o repara la API local de JetVenta"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PowerCycle" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Levantar API"/></StackPanel></Button><Button Width="190" Margin="0,0,8,0" Click="OnRefreshClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Actualizar diagnóstico"/></StackPanel></Button><Button Width="160" Margin="0,0,8,0" Click="OnCopyClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentCopy" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Copiar reporte"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="OnCloseClick">Cerrar</Button></StackPanel></StackPanel>
    </Grid>
</Window>
