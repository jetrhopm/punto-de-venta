<Window x:Class="Pos.Desktop.CloudBackupProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Respaldo en Google Drive" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow" Closing="OnClosing">
  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal">
      <Border Width="46" Height="46" Background="#E6EEF8" CornerRadius="5"><icons:PackIconMaterial Kind="CloudUploadOutline" Width="27" Height="27" Foreground="#376A9A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="Guardando respaldo en Google Drive..." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" Text="Esto tarda unos segundos. No apagues la computadora." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="8" Margin="0,18,0,16"/>
    <Button x:Name="SkipButton" Content="Omitir por hoy" HorizontalAlignment="Right" Padding="16,7" Click="OnSkipClick"/>
  </StackPanel>
</Window>
