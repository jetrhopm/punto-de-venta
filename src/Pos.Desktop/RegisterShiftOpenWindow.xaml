<Window x:Class="Pos.Desktop.RegisterShiftOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Caja con turno abierto" Width="540" Height="340" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="54" Height="54" Background="#FFF3E2" BorderBrush="#E9C770" BorderThickness="1" CornerRadius="6">
                <icons:PackIconMaterial Kind="CashRegister" Width="31" Height="31" Foreground="#A96300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,2,0,0">
                <TextBlock Text="Hay un turno abierto" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Esta caja sólo permite un turno a la vez." Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,20,0,16" Padding="14" Background="#FFF8EB" BorderBrush="#E9C770" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="OwnerText" FontWeight="Bold" FontSize="16" Foreground="#6B5200" TextWrapping="Wrap"/>
                <TextBlock x:Name="OpenedAtText" Margin="0,5,0,0" Foreground="#6B5200"/>
                <Separator Margin="0,13,0,12"/>
                <TextBlock Text="Para vender con otra cuenta, cierra esta sesión e inicia con el usuario indicado para realizar el corte de caja. Después podrás abrir el turno del siguiente cajero." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="115" Margin="0,0,8,0" Style="{StaticResource CancelButtonStyle}" IsCancel="True" Click="OnCancelClick">Cancelar</Button>
            <Button Width="160" Style="{StaticResource NextButtonStyle}" IsDefault="True" Click="OnChangeUserClick">Cambiar usuario</Button>
        </StackPanel>
    </Grid>
</Window>
