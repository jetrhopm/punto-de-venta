<Window x:Class="Pos.Desktop.ConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuración" Width="720" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Configuración" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Administración local de la tienda y esta caja" Foreground="#526577" Margin="0,4,0,18"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
            <Button x:Name="StoreButton" Margin="6" Click="OnStoreClick"><StackPanel><TextBlock Text="Datos de la tienda" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nombre, giro y datos fiscales" Foreground="#526577"/></StackPanel></Button>
            <Button x:Name="UsersButton" Margin="6" Click="OnUsersClick"><StackPanel><TextBlock Text="Usuarios y permisos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Administradores y cajeros" Foreground="#526577"/></StackPanel></Button>
            <Button x:Name="PrinterButton" Margin="6" Click="OnPrinterClick"><StackPanel><TextBlock Text="Impresora" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Impresoras instaladas en Windows" Foreground="#526577"/></StackPanel></Button>
            <Button x:Name="TicketButton" Margin="6" Click="OnTicketClick"><StackPanel><TextBlock Text="Formato de ticket" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Encabezado, mensaje y ancho" Foreground="#526577"/></StackPanel></Button>
            <Button x:Name="BackupButton" Margin="6" Click="OnBackupClick"><StackPanel><TextBlock Text="Respaldos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Crear y verificar respaldo PostgreSQL" Foreground="#526577"/></StackPanel></Button>
            <Button x:Name="ImportButton" Margin="6" Click="OnImportClick"><StackPanel><TextBlock Text="Importar inventario" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Archivos CSV o XLSX" Foreground="#526577"/></StackPanel></Button>
        </UniformGrid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="6,14,6,0" Foreground="#526577" TextWrapping="Wrap"/>
    </Grid>
</Window>
