<UserControl x:Class="Pos.Desktop.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        >
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="IconTileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="Height" Value="90"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17324D"/><Setter Property="Margin" Value="5,16,5,3"/></Style>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CogOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/><TextBlock Text="Configuración" FontSize="25" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="Administración de la tienda y de esta caja" Foreground="{StaticResource TextMutedBrush}" Margin="39,3,0,18"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="5,0,5,3"/>
                <UniformGrid Columns="4">
                    <Button x:Name="StoreButton" Style="{StaticResource IconTileButton}" Click="OnStoreClick" ToolTip="Nombre, giro y datos fiscales"><StackPanel><icons:PackIconMaterial Kind="StoreOutline" Width="30" Height="30" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="Datos de la tienda" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Nombre y giro" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="UsersButton" Style="{StaticResource IconTileButton}" Click="OnUsersClick" ToolTip="Administradores, cajeros y permisos"><StackPanel><icons:PackIconMaterial Kind="AccountGroupOutline" Width="30" Height="30" Foreground="#76538D" HorizontalAlignment="Center"/><TextBlock Text="Cajeros y permisos" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Usuarios" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="OptionsButton" Style="{StaticResource IconTileButton}" Click="OnOptionsClick" ToolTip="Inventario, crédito, precios y avisos"><StackPanel><icons:PackIconMaterial Kind="TuneVariant" Width="30" Height="30" Foreground="#4C8A86" HorizontalAlignment="Center"/><TextBlock Text="Opciones habilitadas" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Inventario y ventas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="BackupButton" Style="{StaticResource IconTileButton}" Click="OnBackupClick" ToolTip="Respaldar y recuperar la tienda"><StackPanel><icons:PackIconMaterial Kind="DatabaseExportOutline" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Base de datos" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Respaldos y recuperación" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="FoliosButton" Style="{StaticResource IconTileButton}" Click="OnFoliosClick" ToolTip="Consulta y cambia el siguiente folio de venta"><StackPanel><icons:PackIconMaterial Kind="ReceiptTextEditOutline" Width="30" Height="30" Foreground="#9A6A37" HorizontalAlignment="Center"/><TextBlock Text="Modificar folios" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Consecutivo de ventas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Tag="Facturación" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="FileDocumentOutline" Width="30" Height="30" Foreground="#9A6A37" HorizontalAlignment="Center"/><TextBlock Text="Facturación" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Módulo futuro" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                </UniformGrid>
                <TextBlock Text="Personalización" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="4">
                    <Button x:Name="TicketButton" Style="{StaticResource IconTileButton}" Click="OnTicketClick" ToolTip="Diseño y vista previa del ticket"><StackPanel><icons:PackIconMaterial Kind="ReceiptTextEditOutline" Width="30" Height="30" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/><TextBlock Text="Ticket" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Diseño e impresión" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="PaymentMethodsButton" Style="{StaticResource IconTileButton}" Click="OnPaymentMethodsClick" ToolTip="Activa las formas de pago de la tienda"><StackPanel><icons:PackIconMaterial Kind="CreditCardOutline" Width="30" Height="30" Foreground="#2C8A5C" HorizontalAlignment="Center"/><TextBlock Text="Formas de pago" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Cobros disponibles" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Tag="Impuestos" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="CalculatorVariantOutline" Width="30" Height="30" Foreground="#76538D" HorizontalAlignment="Center"/><TextBlock Text="Impuestos" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="En preparación" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="CutButton" Style="{StaticResource IconTileButton}" Click="OnCutClick" ToolTip="Reglas para el cierre de turno y efectivo"><StackPanel><icons:PackIconMaterial Kind="ContentCut" Width="30" Height="30" Foreground="#9A6A37" HorizontalAlignment="Center"/><TextBlock Text="Corte" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Cierre y límite de caja" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="CurrencyButton" Style="{StaticResource IconTileButton}" Click="OnCurrencyClick" ToolTip="Símbolo que se muestra en tickets"><StackPanel><icons:PackIconMaterial Kind="CurrencyUsd" Width="30" Height="30" Foreground="#2C8A5C" HorizontalAlignment="Center"/><TextBlock Text="Símbolo de moneda" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Tickets y comprobantes" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="MeasureButton" Style="{StaticResource IconTileButton}" Click="OnMeasureClick" ToolTip="Unidad predeterminada para productos de granel"><StackPanel><icons:PackIconMaterial Kind="Ruler" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Unidades de medida" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Peso y granel" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                </UniformGrid>
                <TextBlock Text="Dispositivos" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="4">
                    <Button x:Name="PrinterButton" Style="{StaticResource IconTileButton}" Click="OnPrinterClick" ToolTip="Selecciona y prueba impresoras de Windows"><StackPanel><icons:PackIconMaterial Kind="PrinterOutline" Width="30" Height="30" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/><TextBlock Text="Impresora de tickets" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Configurada en Windows" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ScannerButton" Style="{StaticResource IconTileButton}" Click="OnScannerClick" ToolTip="Lector USB tipo teclado o puerto serial"><StackPanel><icons:PackIconMaterial Kind="BarcodeScan" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Lector de códigos" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="USB o serial" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="CashDrawerButton" Style="{StaticResource IconTileButton}" Click="OnCashDrawerClick" ToolTip="Configura y prueba el cajón conectado a la impresora"><StackPanel><icons:PackIconMaterial Kind="CashRegister" Width="30" Height="30" Foreground="#9A6A37" HorizontalAlignment="Center"/><TextBlock Text="Cajón de dinero" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Impresora y apertura" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ScaleButton" Style="{StaticResource IconTileButton}" Click="OnScaleClick" ToolTip="Configura y prueba una báscula serial o USB con puerto COM"><StackPanel><icons:PackIconMaterial Kind="ScaleBalance" Width="30" Height="30" Foreground="#76538D" HorizontalAlignment="Center"/><TextBlock Text="Báscula" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Puerto COM y lectura" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Click="OnMercadoPagoClick" ToolTip="Autoriza la cuenta y asigna una terminal Mercado Pago Point"><StackPanel><icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="30" Height="30" Foreground="#009EE3" HorizontalAlignment="Center"/><TextBlock Text="Mercado Pago Point" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Cuenta y terminal" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                </UniformGrid>
                <TextBlock Text="Servicios y mantenimiento" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="4">
                    <Button Style="{StaticResource IconTileButton}" Tag="Recargas electrónicas" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="Cellphone" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Recargas electrónicas" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Requiere proveedor" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Tag="Pago de servicios" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="ReceiptTextOutline" Width="30" Height="30" Foreground="#2C8A5C" HorizontalAlignment="Center"/><TextBlock Text="Pago de servicios" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Requiere proveedor" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ImportButton" Style="{StaticResource IconTileButton}" Click="OnImportClick" ToolTip="Importar productos e inventario desde CSV o Excel"><StackPanel><icons:PackIconMaterial Kind="FileImportOutline" Width="30" Height="30" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/><TextBlock Text="Importar inventario" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="CSV y XLSX" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Tag="Actualizaciones automáticas" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="Update" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Actualizaciones" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="En preparación" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="DiagnosticButton" Style="{StaticResource IconTileButton}" Click="OnDiagnosticClick" ToolTip="Revisa la API, PostgreSQL, migraciones, respaldos e impresión"><StackPanel><icons:PackIconMaterial Kind="Stethoscope" Width="30" Height="30" Foreground="#9A6A37" HorizontalAlignment="Center"/><TextBlock Text="Diagnóstico" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Estado de JetVenta" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconTileButton}" Tag="Nube JetVenta" Click="OnPendingClick"><StackPanel><icons:PackIconMaterial Kind="CloudOutline" Width="30" Height="30" Foreground="#76538D" HorizontalAlignment="Center"/><TextBlock Text="Nube JetVenta" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Fase futura" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="LicenseButton" Style="{StaticResource IconTileButton}" Click="OnLicenseClick" ToolTip="Consulta y activa la licencia local"><StackPanel><icons:PackIconMaterial Kind="License" Width="30" Height="30" Foreground="#2C8A5C" HorizontalAlignment="Center"/><TextBlock Text="Licencia" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Estado y vigencia" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="SystemDetailsButton" Style="{StaticResource IconTileButton}" Click="OnSystemDetailsClick" ToolTip="Consulta versión, equipo, API y dispositivos configurados"><StackPanel><icons:PackIconMaterial Kind="InformationOutline" Width="30" Height="30" Foreground="#376A9A" HorizontalAlignment="Center"/><TextBlock Text="Detalles del sistema" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Versión y diagnóstico" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/></StackPanel></Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Margin="7,14,7,0" Padding="12,8" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</UserControl>
