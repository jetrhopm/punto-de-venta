<Window x:Class="Pos.Desktop.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Configuración" Width="820" Height="590" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CogOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/><TextBlock Text="Configuración" FontSize="25" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="Administración de la tienda y de esta caja" Foreground="{StaticResource TextMutedBrush}" Margin="39,3,0,18"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
            <Button x:Name="StoreButton" Style="{StaticResource ToolButton}" Click="OnStoreClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="StoreOutline" Width="25" Height="25" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Datos de la tienda" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nombre, giro y datos fiscales" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
            <Button x:Name="UsersButton" Style="{StaticResource ToolButton}" Click="OnUsersClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E9E3F1" CornerRadius="5"><icons:PackIconMaterial Kind="AccountGroupOutline" Width="25" Height="25" Foreground="#76538D"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Usuarios y permisos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Administradores y cajeros" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
            <Button x:Name="PrinterButton" Style="{StaticResource ToolButton}" Click="OnPrinterClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E4F2EC" CornerRadius="5"><icons:PackIconMaterial Kind="PrinterOutline" Width="25" Height="25" Foreground="{StaticResource SuccessBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Impresora" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Impresoras instaladas en Windows" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
            <Button x:Name="TicketButton" Style="{StaticResource ToolButton}" Click="OnTicketClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#FFF0DC" CornerRadius="5"><icons:PackIconMaterial Kind="ReceiptTextEditOutline" Width="25" Height="25" Foreground="{StaticResource WarningBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Formato de ticket" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Encabezado, mensaje y ancho" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
            <Button x:Name="BackupButton" Style="{StaticResource ToolButton}" Click="OnBackupClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E6EEF8" CornerRadius="5"><icons:PackIconMaterial Kind="DatabaseExportOutline" Width="25" Height="25" Foreground="#376A9A"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Respaldos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Crear y verificar respaldo" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
            <Button x:Name="ImportButton" Style="{StaticResource ToolButton}" Click="OnImportClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E4F2EC" CornerRadius="5"><icons:PackIconMaterial Kind="FileImportOutline" Width="25" Height="25" Foreground="{StaticResource SuccessBrush}"/></Border><StackPanel Grid.Column="1" Margin="12,1,0,0"><TextBlock Text="Importar inventario" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Archivos CSV o XLSX" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Button>
        </UniformGrid>
        <Border Grid.Row="2" Margin="7,14,7,0" Padding="12,8" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
