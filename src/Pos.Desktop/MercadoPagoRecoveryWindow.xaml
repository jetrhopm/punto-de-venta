<Window x:Class="Pos.Desktop.MercadoPagoRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cobros Point pendientes" Width="820" Height="510"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="#E3F5FC" CornerRadius="8" Margin="0,0,13,0">
                <icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="29" Height="29" Foreground="#009EE3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Cobros Point que requieren revisión" FontSize="21" FontWeight="Bold" Foreground="#17324D"/>
                <TextBlock Text="Actualiza el estado antes de cobrar de nuevo. Un cobro aprobado se confirma desde su ticket original." Foreground="#526577" TextWrapping="Wrap" MaxWidth="670" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="OrdersGrid" Grid.Row="1" Margin="0,20,0,12" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketLabel}" Width="90"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding AmountLabel}" Width="100"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="145"/>
                <DataGridTextColumn Header="Creado" Binding="{Binding CreatedLabel}" Width="145"/>
                <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#526577" TextWrapping="Wrap" MinHeight="22"/>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Actualizar estado" Padding="14,7" Margin="0,0,8,0" Click="OnRefreshClick"/>
            <Button Grid.Column="2" x:Name="CompleteButton" Content="Confirmar venta e imprimir" Padding="14,7" Margin="0,0,8,0" Background="#16884A" Foreground="White" Click="OnCompleteClick"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Cancelar en terminal" Padding="14,7" Margin="0,0,8,0" Background="#FFF3F3" BorderBrush="#EBA3A3" Foreground="#B3261E" Click="OnCancelClick"/>
            <Button Grid.Column="4" Content="Cerrar" Padding="20,7" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
