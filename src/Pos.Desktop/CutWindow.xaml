<Window x:Class="Pos.Desktop.CutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Corte" Width="980" Height="720" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F4F7FB" Loaded="OnLoaded">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Width="120" Height="36" Click="OnRefreshClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="Refresh" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Actualizar"/></StackPanel></Button>
            <StackPanel><TextBlock Text="CORTE" FontSize="25" FontWeight="Bold" Foreground="#075B59"/><TextBlock Text="Resumen del turno actual antes de realizar el corte." Foreground="#637589" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,14">
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Ventas totales" Foreground="#637589"/><TextBlock x:Name="TotalSalesText" Text="$0.00" FontSize="25" FontWeight="Bold" Foreground="#146CB0"/><TextBlock x:Name="SalesCountText" Text="0 ventas" Foreground="#637589"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Efectivo esperado en caja" Foreground="#637589"/><TextBlock x:Name="ExpectedCashText" Text="$0.00" FontSize="25" FontWeight="Bold" Foreground="#238A68"/><TextBlock Text="Fondo + efectivo + entradas - salidas" Foreground="#637589"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="Utilidad estimada" Foreground="#637589"/><TextBlock x:Name="ProfitText" Text="$0.00" FontSize="25" FontWeight="Bold" Foreground="#7C5799"/><TextBlock Text="Ventas menos costo" Foreground="#637589"/></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="Dinero en caja" FontSize="17" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock x:Name="InitialCashText" Margin="0,14,0,0"/><TextBlock x:Name="CashSalesInBoxText" Margin="0,7,0,0" Foreground="#238A68"/><TextBlock x:Name="CashInText" Margin="0,7,0,0" Foreground="#238A68"/><TextBlock x:Name="CashOutText" Margin="0,7,0,0" Foreground="#B54708"/><TextBlock x:Name="CashReturnsText" Margin="0,7,0,0" Foreground="#B54708"/><Separator Margin="0,14,0,10"/><TextBlock Text="Efectivo esperado" FontWeight="Bold" Foreground="#17324D"/><TextBlock x:Name="ExpectedCashDetailText" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#238A68"/></StackPanel></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,0"><StackPanel><TextBlock Text="Ventas" FontSize="17" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock x:Name="CashSalesText" Margin="0,14,0,0"/><TextBlock x:Name="CardSalesText" Margin="0,9,0,0"/><TextBlock x:Name="TransferSalesText" Margin="0,9,0,0"/><TextBlock x:Name="CreditSalesText" Margin="0,9,0,0"/><Separator Margin="0,16,0,12"/><TextBlock Text="Ganancia estimada" Foreground="#637589"/><TextBlock x:Name="ProfitDetailText" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#7C5799"/><TextBlock Text="Vales, cheques y reportes por departamento se agregarán cuando existan esos movimientos en el sistema." Foreground="#637589" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Foreground="#637589" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="130" Height="38" Margin="0,0,8,0" Click="OnCloseClick">Cerrar</Button><Button Width="170" Height="38" Margin="0,0,8,0" Background="#075B59" Foreground="White" FontWeight="Bold" Click="OnMakeCutClick">Hacer corte de cajero</Button><Button Width="165" Height="38" IsEnabled="False" ToolTip="El corte consolidado del día se habilitará cuando exista soporte para varios turnos">Corte del día</Button></StackPanel></Grid>
    </Grid>
</Window>
