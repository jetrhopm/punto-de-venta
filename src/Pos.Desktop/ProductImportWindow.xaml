<Window x:Class="Pos.Desktop.ProductImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar inventario" Width="1250" Height="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Importar productos e inventario" FontSize="22" FontWeight="Bold" Foreground="#17324D"/>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileBox" Height="34" IsReadOnly="True"/>
            <Button Grid.Column="1" Width="110" Margin="8,0" Click="OnSelectFileClick">Seleccionar</Button>
            <StackPanel Grid.Column="2" Margin="10,0">
                <TextBlock Text="Duplicados"/>
                <ComboBox x:Name="DuplicateRuleBox" Width="120" SelectedIndex="0">
                    <ComboBoxItem Tag="Skip">Omitir</ComboBoxItem>
                    <ComboBoxItem Tag="Update">Actualizar</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0">
                <TextBlock Text="Minimo mayoreo"/>
                <TextBox x:Name="WholesaleMinimumBox" Width="90" Height="30" Text="1"
                         ToolTip="Se usa cuando eleventa exporta precio de mayoreo sin cantidad minima"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="PreviewGrid" IsReadOnly="False" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  CellEditEnding="OnPreviewCellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fila" Binding="{Binding RowNumber}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Codigo" Binding="{Binding Code, UpdateSourceTrigger=LostFocus}" Width="110"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="220"/>
                <DataGridTextColumn Header="Departamento" Binding="{Binding Category, UpdateSourceTrigger=LostFocus}" Width="130"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding Cost, StringFormat=C2, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Venta" Binding="{Binding Price, StringFormat=C2, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Mayoreo" Binding="{Binding WholesalePrice, StringFormat=C2, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Existencia" Binding="{Binding Stock, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Minimo" Binding="{Binding MinimumStock, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Maximo" Binding="{Binding MaximumStock, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Tipo de venta" Binding="{Binding UnitOfMeasure, UpdateSourceTrigger=LostFocus}" Width="110"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName, UpdateSourceTrigger=LostFocus}" Width="150"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#526577" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="ImportButton" Width="170" Height="38" IsEnabled="False" Click="OnImportClick">Importar ahora</Button>
        </Grid>
    </Grid>
</Window>
