<Window x:Class="Pos.Desktop.ProductImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Importar inventario" Width="1250" Height="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <x:Array x:Key="UnitOptions" Type="{x:Type sys:String}">
            <sys:String>Pieza</sys:String>
            <sys:String>Kilogramo</sys:String>
            <sys:String>Gramo</sys:String>
            <sys:String>Litro</sys:String>
            <sys:String>Mililitro</sys:String>
            <sys:String>Metro</sys:String>
            <sys:String>Servicio</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Importar productos e inventario" FontSize="22" FontWeight="Bold" Foreground="#17324D"/>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileBox" Height="34" IsReadOnly="True"/>
            <Button Grid.Column="1" Width="110" Margin="8,0" Click="OnSelectFileClick">Seleccionar</Button>
            <StackPanel Grid.Column="2" Margin="10,0">
                <TextBlock Text="Duplicados"/>
                <ComboBox x:Name="DuplicateRuleBox" Width="120" SelectedIndex="0">
                    <ComboBoxItem Tag="Skip">Omitir</ComboBoxItem>
                    <ComboBoxItem Tag="Update">Actualizar</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0">
                <TextBlock Text="Minimo mayoreo"/>
                <TextBox x:Name="WholesaleMinimumBox" Width="90" Height="30" Text="1"
                         ToolTip="Se usa cuando eleventa exporta precio de mayoreo sin cantidad minima"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="PreviewGrid" IsReadOnly="False" AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  CellEditEnding="OnPreviewCellEditEnding"
                  Sorting="OnPreviewSorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fila" Binding="{Binding RowNumber}" SortMemberPath="RowNumber" IsReadOnly="True"/>
                <DataGridTextColumn Header="Codigo" Binding="{Binding Code, UpdateSourceTrigger=LostFocus}" SortMemberPath="Code" Width="110"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" SortMemberPath="Description" Width="220"/>
                <DataGridTextColumn Header="Departamento" Binding="{Binding Category, UpdateSourceTrigger=LostFocus}" SortMemberPath="Category" Width="130"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding CostText, UpdateSourceTrigger=LostFocus}" SortMemberPath="Cost"/>
                <DataGridTextColumn Header="Venta" Binding="{Binding PriceText, UpdateSourceTrigger=LostFocus}" SortMemberPath="Price"/>
                <DataGridTextColumn Header="Mayoreo" Binding="{Binding WholesalePriceText, UpdateSourceTrigger=LostFocus}" SortMemberPath="WholesalePrice"/>
                <DataGridTextColumn Header="Minimo mayoreo" Binding="{Binding WholesaleMinimumQuantityText, UpdateSourceTrigger=LostFocus}" SortMemberPath="WholesaleMinimumQuantity"/>
                <DataGridTextColumn Header="Existencia" Binding="{Binding StockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="Stock"/>
                <DataGridTextColumn Header="Minimo" Binding="{Binding MinimumStockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="MinimumStock"/>
                <DataGridTextColumn Header="Maximo" Binding="{Binding MaximumStockText, UpdateSourceTrigger=LostFocus}" SortMemberPath="MaximumStock"/>
                <DataGridComboBoxColumn Header="Tipo de venta" SelectedItemBinding="{Binding UnitOfMeasure, UpdateSourceTrigger=LostFocus}" ItemsSource="{StaticResource UnitOptions}" SortMemberPath="UnitOfMeasure" Width="125"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName, UpdateSourceTrigger=LostFocus}" SortMemberPath="SupplierName" Width="150"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" SortMemberPath="Status" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PreviousPageButton" Width="120" Height="34" Click="OnPreviousPageClick">Anterior</Button>
            <Button Grid.Column="1" x:Name="NextPageButton" Width="120" Height="34" Margin="8,0,0,0" Click="OnNextPageClick">Siguiente</Button>
            <TextBlock Grid.Column="2" x:Name="PageInfoText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#526577"/>
            <TextBlock Grid.Column="3" Text="Clic en encabezados para ordenar" VerticalAlignment="Center" Foreground="#526577"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#526577" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ImportProgressBar" Height="6" Margin="0,8,12,0" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorDetailsText" Margin="0,5,12,0" Foreground="#B42318" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SaveReportButton" Width="160" Height="38" Margin="0,0,8,0" IsEnabled="False" Click="OnSaveReportClick">Guardar reporte</Button>
            <Button Grid.Column="2" x:Name="ImportButton" Width="170" Height="38" IsEnabled="False" Click="OnImportClick">Importar ahora</Button>
        </Grid>
    </Grid>
</Window>
