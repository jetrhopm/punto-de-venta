<Window x:Class="Pos.Desktop.RenameRegisterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Renombrar caja" Width="440" Height="220" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Nombre de la caja" FontSize="20" FontWeight="Bold" Foreground="#17324D"/><TextBox Grid.Row="1" x:Name="NameBox" Margin="0,16,0,0" Height="34" MaxLength="80"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Style="{StaticResource DangerButtonStyle}" Width="105" Margin="0,0,8,0" IsCancel="True">Cancelar</Button><Button Style="{StaticResource SuccessButtonStyle}" Width="105" IsDefault="True" Click="OnSaveClick">Guardar</Button></StackPanel></Grid>
</Window>
