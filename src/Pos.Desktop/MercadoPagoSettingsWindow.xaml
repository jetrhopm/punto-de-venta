<Window x:Class="Pos.Desktop.MercadoPagoSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Mercado Pago Point" Width="760" Height="640" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#009EE3"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0087C2"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#156EA8"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Encabezado -->
    <StackPanel Orientation="Horizontal">
      <Border Width="52" Height="52" Background="#E3F5FC" CornerRadius="6"><icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="31" Height="31" Foreground="#009EE3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="14,2,0,0">
        <TextBlock Text="Cobrar con terminal Mercado Pago" FontSize="22" FontWeight="Bold" Foreground="#17324D"/>
        <TextBlock x:Name="HeaderText" Text="Conecta la cuenta donde recibes tus ventas y elige la terminal de esta caja." Foreground="#526577" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>

    <!-- Paso 1: cuenta -->
    <Border Grid.Row="1" Background="#F5F9FC" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,20,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="AccountStep" Width="30" Height="30" CornerRadius="15" Background="#009EE3" VerticalAlignment="Top" Margin="0,2,14,0"><TextBlock x:Name="AccountStepText" Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="ConnectionTitle" Text="Revisando..." FontSize="17" FontWeight="SemiBold" Foreground="#17324D"/>
          <TextBlock x:Name="ConnectionMessage" TextWrapping="Wrap" Foreground="#526577" Margin="0,5,15,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="AuthorizeButton" Content="Conectar con Mercado Pago" Style="{StaticResource PrimaryButton}" Click="OnAuthorizeClick"/>
          <Button x:Name="DisconnectButton" Content="Desconectar cuenta" Style="{StaticResource LinkButton}" Foreground="#B42318" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="Collapsed" Click="OnDisconnectClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Paso 2: terminal -->
    <Border x:Name="TerminalPanel" Grid.Row="2" Background="White" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14" IsEnabled="False" Opacity="0.55">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="30" Height="30" CornerRadius="15" Background="#009EE3" VerticalAlignment="Top" Margin="0,2,14,0"><TextBlock x:Name="TerminalStepText" Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Terminal de esta caja" FontSize="17" FontWeight="SemiBold" Foreground="#17324D"/>
          <TextBlock x:Name="TerminalHelp" Text="Primero conecta tu cuenta." TextWrapping="Wrap" Foreground="#526577" Margin="0,5,0,10"/>
          <DockPanel>
            <Button Content="Actualizar lista" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="OnRefreshTerminalsClick"/>
            <ComboBox x:Name="TerminalBox" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectionChanged="OnTerminalSelectionChanged"/>
          </DockPanel>
          <DockPanel Margin="0,14,0,0">
            <Button x:Name="UseTerminalButton" Content="Usar esta terminal" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="OnUseTerminalClick"/>
            <Button x:Name="EnabledButton" Content="Pausar cobro con terminal" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="OnEnabledClick"/>
          </DockPanel>
          <Border x:Name="ActiveBanner" Background="#EAF7EE" BorderBrush="#A7D8B5" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CheckCircle" Foreground="#137333" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock x:Name="ActiveText" Foreground="#137333" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Solo para desarrollo: se muestra únicamente si la API tiene MercadoPago:AllowTestToken -->
    <Expander x:Name="TestTokenPanel" Grid.Row="3" Header="Herramientas de desarrollo (token de prueba)" Visibility="Collapsed" VerticalAlignment="Top">
      <DockPanel Margin="0,8,0,0"><Button Content="Validar y guardar" DockPanel.Dock="Right" Padding="13,7" Margin="10,0,0,0" Click="OnSaveTestTokenClick"/><PasswordBox x:Name="TestTokenBox" Height="34"/></DockPanel>
    </Expander>

    <!-- Pie -->
    <DockPanel Grid.Row="4" Margin="0,14,0,0">
      <Button Content="Cerrar" DockPanel.Dock="Right" Padding="18,8" Click="OnCloseClick"/>
      <Button Content="Ayuda: vincular la terminal a tu cuenta" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="0,0,12,0" Click="OnOpenHelpClick"/>
      <TextBlock x:Name="StatusText" Foreground="#526577" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
