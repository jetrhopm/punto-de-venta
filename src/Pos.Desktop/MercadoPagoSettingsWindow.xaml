<Window x:Class="Pos.Desktop.MercadoPagoSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Mercado Pago Point" Width="720" Height="790" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Closing="OnClosing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" Background="#E3F5FC" CornerRadius="6"><icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="31" Height="31" Foreground="#009EE3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,2,0,0"><TextBlock Text="Mercado Pago Point" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="La cuenta es de la tienda. Terminal y habilitación se configuran sólo para esta caja." Foreground="#526577" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Background="#F5F9FC" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ConnectionTitle" Text="Revisando configuración..." FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionMessage" TextWrapping="Wrap" Foreground="#526577" Margin="0,5,15,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="EnabledButton" Content="Desactivar Point" Padding="16,9" Margin="0,0,8,0" Click="OnEnabledClick"/><Button x:Name="AuthorizeButton" Content="Autorizar cuenta" Padding="16,9" Margin="0,0,8,0" Click="OnAuthorizeClick"/><Button x:Name="DisconnectButton" Content="Eliminar datos de JetVenta" Padding="12,9" Foreground="#B42318" Click="OnDisconnectClick"/></StackPanel></Grid></Border>
    <Border Grid.Row="2" Background="#EEF7FC" BorderBrush="#BFDCEC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Guía rápida de activación" FontWeight="SemiBold" FontSize="16" Foreground="#17324D"/><TextBlock Text="1. Crea tu aplicación y obtén credenciales de prueba.  2. Para operar en una tienda real, pulsa Autorizar cuenta e inicia sesión en Mercado Pago.  3. Asocia la terminal Point a una sucursal y caja, actívala en modo PDV y selecciónala abajo." Foreground="#526577" TextWrapping="Wrap" Margin="0,5,0,10"/><WrapPanel><Button Content="Crear aplicación y credenciales" Padding="12,7" Margin="0,0,8,0" Click="OnOpenCredentialsClick"/><Button Content="Configurar terminal PDV" Padding="12,7" Margin="0,0,8,0" Click="OnOpenTerminalGuideClick"/><Button Content="Manual de Point" Padding="12,7" Click="OnOpenManualClick"/></WrapPanel><TextBlock Text="Nunca compartas ni envíes tu Access Token. JetVenta lo guarda cifrado únicamente en el servidor de la tienda." Foreground="#526577" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
    <Border x:Name="TestTokenPanel" Grid.Row="3" Visibility="Collapsed" Background="#FFF8E7" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Solo pruebas de desarrollo" FontWeight="SemiBold"/><TextBlock Text="En Mercado Pago abre Tus integraciones > tu aplicación > Pruebas > Credenciales de prueba. Copia el Access Token de prueba, normalmente inicia con APP_USR-, y pégalo aquí. No genera cargos reales." Foreground="#665527" TextWrapping="Wrap" Margin="0,4,0,9"/><DockPanel><PasswordBox x:Name="TestTokenBox" Height="34" MinWidth="450" Margin="0,0,10,0"/><Button Content="Validar y guardar" Padding="13,7" Click="OnSaveTestTokenClick"/></DockPanel></StackPanel></Border>
    <Border Grid.Row="4" Background="White" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Terminal para esta caja" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="El número final debe coincidir con el serial de la etiqueta de la terminal." Foreground="#526577" Margin="0,4,0,0"/></StackPanel><Button Content="Actualizar terminales" DockPanel.Dock="Right" Padding="13,7" Click="OnRefreshTerminalsClick"/></DockPanel><ComboBox x:Name="TerminalBox" Grid.Row="1" Height="38" Margin="0,15,0,10" DisplayMemberPath="Label"/><TextBlock x:Name="TerminalHelp" Grid.Row="2" Text="Solo puede seleccionarse una terminal configurada en modo PDV." Foreground="#526577" TextWrapping="Wrap"/></Grid></Border>
    <DockPanel Grid.Row="5" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Foreground="#526577" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Activar modo PDV" Padding="14,9" Margin="0,0,8,0" Click="OnActivatePdvClick"/><Button Content="Guardar terminal" Padding="18,9" Click="OnSaveTerminalClick"/></StackPanel></DockPanel>
  </Grid>
</Window>
