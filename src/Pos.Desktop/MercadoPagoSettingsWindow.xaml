<Window x:Class="Pos.Desktop.MercadoPagoSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Mercado Pago Point" Width="720" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Closing="OnClosing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" Background="#E3F5FC" CornerRadius="6"><icons:PackIconMaterial Kind="CreditCardWirelessOutline" Width="31" Height="31" Foreground="#009EE3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,2,0,0"><TextBlock Text="Mercado Pago Point" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Autoriza la cuenta que recibirá el dinero y asigna una terminal a esta caja" Foreground="#526577" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Background="#F5F9FC" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ConnectionTitle" Text="Revisando configuración..." FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionMessage" TextWrapping="Wrap" Foreground="#526577" Margin="0,5,15,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="EnabledButton" Content="Desactivar Point" Padding="16,9" Margin="0,0,8,0" Click="OnEnabledClick"/><Button x:Name="AuthorizeButton" Content="Autorizar cuenta" Padding="16,9" Click="OnAuthorizeClick"/></StackPanel></Grid></Border>
    <Border Grid.Row="2" Background="#FFF8E7" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Solo pruebas de desarrollo" FontWeight="SemiBold"/><TextBlock Text="Para una tienda real usa Autorizar cuenta. Este campo acepta únicamente un Access Token de prueba y no es necesario para el usuario final." Foreground="#665527" TextWrapping="Wrap" Margin="0,4,0,9"/><DockPanel><PasswordBox x:Name="TestTokenBox" Height="34" MinWidth="450" Margin="0,0,10,0"/><Button Content="Validar y guardar" Padding="13,7" Click="OnSaveTestTokenClick"/></DockPanel></StackPanel></Border>
    <Border Grid.Row="3" Background="White" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Terminal para esta caja" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="El número final debe coincidir con el serial de la etiqueta de la terminal." Foreground="#526577" Margin="0,4,0,0"/></StackPanel><Button Content="Actualizar terminales" DockPanel.Dock="Right" Padding="13,7" Click="OnRefreshTerminalsClick"/></DockPanel><ComboBox x:Name="TerminalBox" Grid.Row="1" Height="38" Margin="0,15,0,10" DisplayMemberPath="Label"/><TextBlock x:Name="TerminalHelp" Grid.Row="2" Text="Solo puede seleccionarse una terminal configurada en modo PDV." Foreground="#526577" TextWrapping="Wrap"/></Grid></Border>
    <DockPanel Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Foreground="#526577" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Activar modo PDV" Padding="14,9" Margin="0,0,8,0" Click="OnActivatePdvClick"/><Button Content="Guardar terminal" Padding="18,9" Click="OnSaveTerminalClick"/></StackPanel></DockPanel>
  </Grid>
</Window>
