<Window x:Class="Pos.Desktop.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Licencia de JetVenta" Width="760" MinHeight="570" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="26,22" Background="#123C63">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" Background="#E8F3FC" CornerRadius="8"><icons:PackIconMaterial Kind="License" Width="32" Height="32" Foreground="#2479B8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="Licencia de JetVenta" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Activación local vinculada a este equipo" Foreground="#D6E8F6" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22">
                <Border x:Name="StatusBorder" Background="#FFF7E2" BorderBrush="#E9C770" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitleText" FontSize="17" FontWeight="SemiBold" Foreground="#744F00" Text="Revisando licencia..."/>
                        <TextBlock x:Name="StatusMessageText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#5D5D5D"/>
                        <TextBlock x:Name="ExpirationText" Margin="0,8,0,0" Foreground="#5D5D5D"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Código de solicitud" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,4"/>
                <TextBlock Text="Envíalo al emisor de licencias. No contiene contraseñas, datos de ventas ni la base de datos." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                <DockPanel Margin="0,10,0,0">
                    <Button Content="Copiar código" Click="OnCopyRequestClick" Padding="16,8" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <TextBox x:Name="RequestCodeTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="58" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Archivo de activación" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,4"/>
                <TextBlock Text="Selecciona el archivo licencia.jv entregado para esta computadora. JetVenta verificará la firma, la vigencia y el vínculo con el equipo antes de guardarlo." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="ImportButton" Content="Cargar licencia.jv" Click="OnImportClick" Padding="18,9" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    <TextBox x:Name="SelectedFileTextBox" IsReadOnly="True" VerticalContentAlignment="Center" Text="Aún no se ha seleccionado un archivo."/>
                </DockPanel>
                <Border Background="#EDF5FA" BorderBrush="#C9DFEC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,24,0,0">
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Protección local: "/><Run Text="la licencia se conserva cifrada en Windows. Al desinstalar JetVenta se elimina la activación; la base de datos y los respaldos se conservan según la opción normal de desinstalación."/></TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="16" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Actualizar estado" Click="OnRefreshClick" Margin="0,0,10,0" Padding="16,8"/><Button Content="Cerrar" IsCancel="True" Padding="24,8"/></StackPanel></Border>
    </Grid>
</Window>
