<Window x:Class="Pos.Desktop.CustomerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Clientes y créditos" Width="880" Height="650" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterOwner" Background="#F4F7FA">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="7" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E4F2EC" CornerRadius="5"><icons:PackIconMaterial Kind="AccountCreditCardOutline" Width="25" Height="25" Foreground="#238A68" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="TitleText" Text="Clientes y créditos" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Busca clientes, consulta su saldo, registra abonos o crea un cliente nuevo." Foreground="#526577" Margin="0,3,0,0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Margin="0,14,0,0" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Buscar cliente" FontWeight="SemiBold" Foreground="#17324D"/><TextBox x:Name="SearchTextBox" Height="34" Margin="0,6,0,0" TextChanged="OnSearchChanged" ToolTip="Escribe nombre, teléfono o dato disponible del cliente"/></StackPanel></Border>
        <Border Grid.Row="2" Margin="0,14,0,0" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="7" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Clientes encontrados" FontWeight="SemiBold" Foreground="#17324D"/><ListBox Grid.Row="1" x:Name="CustomersList" Margin="0,9,0,0" DisplayMemberPath="DisplayText" MouseDoubleClick="OnCustomerSelected" ToolTip="Doble clic para seleccionar el cliente"/></Grid></Border>
        <Border Grid.Row="3" x:Name="ManagementPanel" Margin="0,14,0,0" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="7" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Alta y abonos" FontWeight="SemiBold" FontSize="16" Foreground="#17324D"/><TextBlock Grid.Row="1" x:Name="SelectedSummaryText" Text="Para registrar un abono, selecciona un cliente de la lista con doble clic." Foreground="#526577" Margin="0,4,0,10"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Nombre del cliente"/><TextBox x:Name="NameTextBox" Height="34" Margin="0,5,0,0" ToolTip="Nombre para crear un nuevo cliente"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Límite de crédito"/><TextBox x:Name="LimitTextBox" Height="34" Margin="0,5,0,0" Text="0.00" ToolTip="Monto máximo de crédito autorizado"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Importe del abono"/><TextBox x:Name="AmountTextBox" Height="34" Margin="0,5,0,0" ToolTip="Cantidad de efectivo que entrega el cliente"/></StackPanel><Button Grid.Column="3" Margin="12,20,0,0" Height="34" Padding="13,0" Click="OnCreateClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="AccountPlusOutline" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Crear cliente"/></StackPanel></Button><Button Grid.Column="4" Margin="8,20,0,0" Height="34" Padding="13,0" Background="#238A68" Foreground="White" Click="OnPaymentClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CashPlus" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Registrar abono"/></StackPanel></Button></Grid></Grid></Border>
        <TextBlock Grid.Row="4" x:Name="MessageText" Foreground="#B42318" TextWrapping="Wrap" Margin="4,10,4,0"/>
    </Grid>
</Window>
