<Window x:Class="Pos.Desktop.CustomerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clientes y credito" Width="760" Height="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" Text="Clientes y credito" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><TextBox x:Name="SearchTextBox" Height="34" Margin="0,12,0,0" TextChanged="OnSearchChanged" ToolTip="Buscar cliente"/></StackPanel>
        <ListBox Grid.Row="1" x:Name="CustomersList" Margin="0,12,0,12" DisplayMemberPath="DisplayText" MouseDoubleClick="OnCustomerSelected"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NameTextBox" Margin="4" Height="34" ToolTip="Nombre"/><TextBox Grid.Column="1" x:Name="LimitTextBox" Margin="4" Height="34" ToolTip="Limite de credito"/><TextBox Grid.Column="2" x:Name="AmountTextBox" Margin="4" Height="34" ToolTip="Abono"/><Button x:Name="ActionButton" Grid.Column="3" Margin="4" Click="OnActionClick">Crear / abonar</Button>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="MessageText" Foreground="#B42318" TextWrapping="Wrap"/>
    </Grid>
</Window>
