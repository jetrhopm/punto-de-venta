<Window x:Class="Pos.Desktop.TrialNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Periodo de prueba de JetVenta" Width="610" Height="455"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#123C63" Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="7" Background="#E8F3FC">
                    <icons:PackIconMaterial Kind="CalendarClockOutline" Width="30" Height="30" Foreground="#2479B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Periodo de prueba activo" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="JetVenta para Windows" Margin="0,3,0,0" Foreground="#D6E8F6"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="26,22">
            <TextBlock x:Name="RemainingText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExpirationText" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <Border Margin="0,22,0,0" Padding="15" Background="#EDF5FA" BorderBrush="#C9DFEC" BorderThickness="1" CornerRadius="5">
                <TextBlock TextWrapping="Wrap">Puedes utilizar todas las funciones durante este periodo. Activa tu licencia antes de la fecha indicada para evitar que se bloquee el acceso.</TextBlock>
            </Border>
            <TextBlock Margin="0,18,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">Para solicitar una licencia: pjetrho@gmail.com · WhatsApp 449 218 9123</TextBlock>
            <ProgressBar x:Name="WaitProgress" Height="7" Margin="0,22,0,0" Minimum="0" Maximum="30" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock x:Name="WaitText" Margin="0,8,0,0" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,14">
            <Button x:Name="ContinueButton" HorizontalAlignment="Right" MinWidth="170" Height="40" Style="{StaticResource SuccessButtonStyle}" IsEnabled="False" IsDefault="True" Click="OnContinueClick">Entendido</Button>
        </Border>
    </Grid>
</Window>
