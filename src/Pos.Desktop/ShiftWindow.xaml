<Window x:Class="Pos.Desktop.ShiftWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Abrir turno" Width="400" Height="270" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock Text="Abrir turno" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <TextBlock Text="Fondo inicial" Margin="0,16,0,4" />
        <TextBox x:Name="InitialCashTextBox" Height="36" FontSize="18" />
        <Button Margin="0,16,0,0" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Abrir turno</Button>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
