<Window x:Class="Pos.Desktop.ShiftWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Abrir caja" Width="440" Height="305" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock x:Name="TitleText" Text="Abrir caja" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <TextBlock x:Name="DescriptionText" Text="Captura el dinero con el que inicia esta caja." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#526577" />
        <TextBlock x:Name="InitialCashLabel" Text="Fondo inicial" Margin="0,16,0,4" />
        <TextBox x:Name="InitialCashTextBox" Height="36" FontSize="18" />
        <Button x:Name="ConfirmButton" Margin="0,16,0,0" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Abrir caja</Button>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
