<Window x:Class="Pos.Desktop.MobilePairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="JetVenta Móvil" Width="620" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="50" Height="50" Background="{StaticResource PrimarySoftBrush}" CornerRadius="6"><icons:PackIconMaterial Kind="CellphoneLink" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,1,0,0"><TextBlock Text="JetVenta Móvil" FontSize="23" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Conecta un teléfono para consultar existencias." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="14" Margin="0,20,0,12"><StackPanel><TextBlock Text="Dirección de la tienda" FontWeight="SemiBold"/><TextBlock Text="En el teléfono escribe esta IP y el puerto 5000. No uses 127.0.0.1." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,7"/><ComboBox x:Name="AddressBox" Height="34" DisplayMemberPath="Display"/><TextBlock Text="Puerto de JetVenta: 5000" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Row="2" Background="#EAF7EF" BorderBrush="#A7D8BA" BorderThickness="1" CornerRadius="5" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Código temporal para el teléfono" FontWeight="SemiBold" Foreground="#15663B"/><TextBlock x:Name="CodeText" Text="------" FontSize="31" FontWeight="Bold" Foreground="#16834A" Margin="0,2,0,0"/><TextBlock x:Name="CodeHintText" Text="Genera un código antes de conectar la app." Foreground="#356A4A" FontSize="12" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="1" Width="170" Height="40" VerticalAlignment="Center" Style="{StaticResource ConfirmButtonStyle}" Click="OnGenerateClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="KeyOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Generar código"/></StackPanel></Button></Grid></Border>
        <Border Grid.Row="3" Margin="0,12,0,0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><StackPanel><TextBlock Text="En el teléfono" FontSize="17" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="1. Conéctalo al mismo Wi-Fi privado de la tienda." Margin="0,11,0,0" TextWrapping="Wrap"/><TextBlock Text="2. Abre JetVenta Móvil y escribe la dirección de esta pantalla, el nombre del teléfono y el código temporal." Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="3. Inicia sesión con un usuario que tenga permiso para consultar inventario." Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="El teléfono sólo consulta productos. No puede vender, modificar inventario ni operar una caja." Margin="0,11,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,16,0"/><Button Grid.Column="1" Width="110" Style="{StaticResource CancelButtonStyle}" IsCancel="True">Cerrar</Button></Grid>
    </Grid>
</Window>
