<Window x:Class="Pos.Desktop.PurchasePlanningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Planificar compras - JetVenta" Width="1360" Height="820" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F8FB">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E3EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#E4F2EC" CornerRadius="8"><icons:PackIconMaterial Kind="ClipboardTextOutline" Width="28" Height="28" Foreground="#238A68" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Listas y órdenes de compra" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Planea reposiciones sin modificar existencias, costos ni precios." Foreground="#637589" Margin="0,3,0,0"/></StackPanel></StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Background="#FFF8E7" BorderBrush="#F0D89D" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="Sólo “Recibir compra” actualiza inventario" Foreground="#8A5A11" FontWeight="SemiBold"/></Border>
        </Grid>
        <TabControl Grid.Row="1">
            <TabItem Header="Sugerencias y nueva orden"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Filtrar por proveedor" FontWeight="SemiBold"/><ComboBox x:Name="SupplierFilterComboBox" DisplayMemberPath="DisplayText" SelectionChanged="OnFilterChanged" Margin="0,5,12,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Filtrar por departamento" FontWeight="SemiBold"/><ComboBox x:Name="DepartmentFilterComboBox" DisplayMemberPath="DisplayText" SelectionChanged="OnFilterChanged" Margin="0,5,12,0"/></StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Padding="15,7" Click="OnRefreshSuggestionsClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Actualizar"/></StackPanel></Button>
                </Grid></Border>
                <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="SuggestionSummaryText" Text="Sugerencias con existencia igual o menor al mínimo." Foreground="#637589" Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Background="#EEF6FB" BorderBrush="#CDE1F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><icons:PackIconMaterial Kind="BarcodeScan" Width="23" Height="23" Foreground="#2A72B5" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="ProductSearchTextBox" Tag="CaptureEnter" Height="32" Padding="9,4" TextChanged="OnProductSearchTextChanged" PreviewKeyDown="OnProductSearchPreviewKeyDown" ToolTip="Escanea un código o escríbelo. Al terminar la lectura, se agregará a la lista de compra."/></Grid></Border>
                        <Border Grid.Row="2" Background="#F8FBFD" BorderBrush="#D7E3EC" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><icons:PackIconMaterial Kind="Magnify" Width="22" Height="22" Foreground="#4D7B9B" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="SuggestionFilterTextBox" Height="32" Padding="9,4" TextChanged="OnSuggestionFilterTextChanged" ToolTip="Filtra la tabla actual por código, producto, departamento o proveedor."/></Grid></Border>
                        <DataGrid x:Name="SuggestionsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="True" MouseDoubleClick="OnSuggestionDoubleClick"><DataGrid.Columns><DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Header="" Width="38" IsReadOnly="False"/><DataGridTextColumn Binding="{Binding Code}" Header="Código" Width="*"/><DataGridTextColumn Binding="{Binding Description}" Header="Producto" Width="2*"/><DataGridTextColumn Binding="{Binding Department}" Header="Departamento" Width="*"/><DataGridTextColumn Binding="{Binding Supplier}" Header="Proveedor" Width="*"/><DataGridTextColumn Binding="{Binding StockText}" Header="Exist." Width="70"/><DataGridTextColumn Binding="{Binding MinimumText}" Header="Mín." Width="65"/><DataGridTextColumn Binding="{Binding MaximumText}" Header="Máx." Width="65"/><DataGridTextColumn Binding="{Binding QuantityText}" Header="Comprar" Width="75"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Lista de compras" FontSize="18" FontWeight="Bold" Foreground="#17324D"/><StackPanel Grid.Row="1" Margin="0,10,0,8"><TextBlock Text="Proveedor de la orden (opcional)" FontWeight="SemiBold"/><ComboBox x:Name="OrderSupplierComboBox" DisplayMemberPath="DisplayText" Margin="0,4,0,8"/><TextBlock Text="Notas" FontWeight="SemiBold"/><TextBox x:Name="NotesTextBox" Height="46" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" Margin="0,4,0,0"/></StackPanel>
                        <DataGrid x:Name="OrderLinesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" BeginningEdit="OnOrderLineBeginningEdit" CellEditEnding="OnOrderLineCellEditEnding"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Code}" Header="Código" Width="*" IsReadOnly="True"/><DataGridTextColumn Binding="{Binding Description}" Header="Producto" Width="2*" IsReadOnly="True"/><DataGridTextColumn Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" Header="Cantidad" Width="90"/><DataGridTextColumn Binding="{Binding UnitCostText}" Header="Costo" Width="85" IsReadOnly="True"/><DataGridTextColumn Binding="{Binding TotalText}" Header="Importe" Width="95" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
                        <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="OrderTotalText" Text="Sin productos seleccionados" FontWeight="SemiBold" Foreground="#31566D"/><TextBlock x:Name="PrintHintText" FontSize="11" Foreground="#637589" Margin="0,3,0,0"/><WrapPanel Margin="0,8,0,0"><Button Background="#E4AA24" Foreground="White" Padding="12,7" Click="OnAddSelectedClick">Agregar selección</Button><Button Margin="8,0,0,0" Padding="12,7" Click="OnRemoveLineClick">Quitar</Button><Button x:Name="PrintOrderButton" Background="#2A72B5" Foreground="White" Margin="8,0,0,0" Padding="12,7" Click="OnPrintOrderClick">Imprimir lista</Button><Button Background="#188C54" Foreground="White" Margin="8,0,0,0" IsDefault="False" Padding="12,7" Click="OnCreateOrderClick">Guardar orden</Button></WrapPanel></StackPanel>
                    </Grid></Border>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="MessageText" Foreground="#31566D" TextWrapping="Wrap"/>
            </Grid></TabItem>
            <TabItem Header="Órdenes guardadas"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Binding="{Binding CreatedText}" Header="Creada" Width="130"/><DataGridTextColumn Binding="{Binding Supplier}" Header="Proveedor" Width="*"/><DataGridTextColumn Binding="{Binding StatusText}" Header="Estado" Width="100"/><DataGridTextColumn Binding="{Binding LineCount}" Header="Partidas" Width="75"/><DataGridTextColumn Binding="{Binding TotalText}" Header="Total estimado" Width="120"/><DataGridTextColumn Binding="{Binding Notes}" Header="Notas" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Padding="14,7" Click="OnRefreshOrdersClick">Actualizar</Button><Button Background="#E4AA24" Foreground="White" Margin="9,0,0,0" Padding="14,7" Click="OnCloseOrderClick">Cerrar orden seleccionada</Button></StackPanel></Grid></TabItem>
        </TabControl>
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,15,0,0" Padding="22,8" Background="#D94949" Foreground="White" IsCancel="True">Cerrar</Button>
    </Grid>
</Window>
