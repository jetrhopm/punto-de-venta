<Window x:Class="Pos.Desktop.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Respaldos" Width="820" Height="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#E6EEF8" CornerRadius="5"><icons:PackIconMaterial Kind="DatabaseExportOutline" Width="27" Height="27" Foreground="#376A9A"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Respaldos de la base de datos" FontSize="22" FontWeight="Bold"/><TextBlock Text="Copias verificadas con checksum SHA-256" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></StackPanel>
        <DataGrid Grid.Row="1" x:Name="BackupsGrid" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,18,0,0"><DataGrid.Columns><DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Fecha UTC" Binding="{Binding CreatedAtUtc}" Width="*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="*"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,7" Margin="0,3,12,3"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource PrimaryButtonStyle}" Width="175" Click="OnCreateClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="DatabasePlusOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Crear respaldo"/></StackPanel></Button><Button Width="190" Click="OnExportClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveMoveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar copia externa"/></StackPanel></Button></StackPanel></Grid>
    </Grid>
</Window>
