<Window x:Class="Pos.Desktop.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Respaldos" Width="760" Height="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Respaldos de la base de datos" FontSize="22" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Cada respaldo se crea con pg_dump y checksum SHA-256." Foreground="#526577" Margin="0,4,0,14"/></StackPanel><DataGrid Grid.Row="1" x:Name="BackupsGrid" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Fecha UTC" Binding="{Binding CreatedAtUtc}" Width="*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="*"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Width="170" Height="36" Click="OnCreateClick">Crear respaldo ahora</Button><Button Width="180" Height="36" Margin="10,0,0,0" Click="OnExportClick">Guardar copia externa</Button></StackPanel><TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#526577" TextWrapping="Wrap"/></StackPanel></Grid>
</Window>
