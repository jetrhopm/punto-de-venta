<Window x:Class="Pos.Desktop.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Respaldos" Width="1040" Height="620" MinWidth="920" MinHeight="560" WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#E6EEF8" CornerRadius="5"><icons:PackIconMaterial Kind="DatabaseExportOutline" Width="27" Height="27" Foreground="#376A9A"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Respaldos de la base de datos" FontSize="22" FontWeight="Bold"/><TextBlock Text="Copias verificadas con checksum SHA-256" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></StackPanel>
        <DataGrid Grid.Row="1" x:Name="BackupsGrid" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,18,0,0"><DataGrid.Columns><DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Fecha UTC" Binding="{Binding CreatedAtUtc}" Width="*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="*"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="OnCreateClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="DatabasePlusOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Crear respaldo" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="1" Height="48" Margin="3" Click="OnExportClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="ContentSaveMoveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar copia externa" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="2" Height="48" Margin="3" Click="OnRestoreClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="DatabaseImportOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Cargar respaldo" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="3" Style="{StaticResource DangerButtonStyle}" Height="48" Margin="3" Click="OnDeleteClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="DeleteOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Eliminar copia" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="4" Style="{StaticResource DangerButtonStyle}" Height="48" Margin="3" Click="OnResetOperationalDataClick" ToolTip="Crea un respaldo y elimina los datos de operación; conserva la tienda y la licencia"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="DatabaseRemoveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Limpiar datos" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></StackPanel></Button></Grid>
    </Grid>
</Window>
