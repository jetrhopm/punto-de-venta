<Window x:Class="Pos.Desktop.JoinServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Emparejar caja" Width="460" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24" Background="#F8FAFC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Emparejar esta caja" FontSize="22" FontWeight="Bold" Foreground="#17324D"/><TextBlock Grid.Row="1" Margin="0,8,0,14" Text="Solicita un codigo temporal al administrador del servidor." Foreground="#526577" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2"><TextBlock Text="Codigo temporal"/><TextBox x:Name="CodeBox" Height="32" Margin="0,4,0,10" MaxLength="6" FontSize="18"/></StackPanel>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Nombre del equipo"/><TextBox x:Name="DeviceBox" Height="32" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Nombre de caja"/><TextBox x:Name="RegisterBox" Height="32" Margin="0,4,0,0" Text="Caja 2"/></StackPanel></Grid>
        <TextBlock Grid.Row="4" x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#526577"/>
        <Button Grid.Row="5" Height="36" IsDefault="True" Click="OnPairClick">Emparejar</Button>
    </Grid>
</Window>
