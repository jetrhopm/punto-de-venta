<Window x:Class="Pos.Desktop.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Reportes" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SmallMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526577"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="#F5F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Width="170" Height="38" Click="OnExportClick">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <icons:PackIconMaterial Kind="FileExportOutline" Width="18" Height="18" Margin="0,0,7,0"/>
                    <TextBlock Text="Exportar ventas CSV"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Reportes y análisis de ventas" FontSize="23" FontWeight="SemiBold" Foreground="#17324D"/>
                <TextBlock x:Name="RangeText" Margin="0,4,0,0" Foreground="#526577"/>
                <TextBlock Text="Los datos salen de PostgreSQL: ventas, partidas e inventario quedan incluidos en respaldos y restauraciones." Margin="0,3,0,0" Foreground="#526577"/>
            </StackPanel>
        </DockPanel>

        <ItemsControl Grid.Row="1" x:Name="PeriodSummaryList" Margin="0,16,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Period}" FontWeight="SemiBold" Foreground="#17324D"/>
                            <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="Bold" Foreground="#146CB0" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding SalesText}" Style="{StaticResource SmallMutedText}" Margin="0,3,0,0"/>
                            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding Percentage}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Grid.Row="2">
            <TabItem Header="Ventas recientes">
                <ListView x:Name="SalesList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CreatedAtUtc}" Width="170"/>
                            <GridViewColumn Header="Venta" DisplayMemberBinding="{Binding SaleId}" Width="245"/>
                            <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding Status}" Width="100"/>
                            <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total}" Width="90"/>
                            <GridViewColumn Header="Pago" DisplayMemberBinding="{Binding PaymentMethod}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Más vendidos">
                <ListView x:Name="BestSellersList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120"/>
                            <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Description}" Width="330"/>
                            <GridViewColumn Header="Vendido" DisplayMemberBinding="{Binding QuantitySoldText}" Width="90"/>
                            <GridViewColumn Header="Importe" DisplayMemberBinding="{Binding TotalSoldText}" Width="100"/>
                            <GridViewColumn Header="Gráfica" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding Percentage}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Surtir tienda">
                <ListView x:Name="RestockList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120"/>
                            <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Description}" Width="330"/>
                            <GridViewColumn Header="Existencia" DisplayMemberBinding="{Binding StockText}" Width="90"/>
                            <GridViewColumn Header="Mínimo" DisplayMemberBinding="{Binding MinimumStockText}" Width="90"/>
                            <GridViewColumn Header="Vendido año" DisplayMemberBinding="{Binding QuantitySoldText}" Width="90"/>
                            <GridViewColumn Header="Sugerencia" DisplayMemberBinding="{Binding Suggestion}" Width="220"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Bajo movimiento">
                <ListView x:Name="LowMovementList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120"/>
                            <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Description}" Width="360"/>
                            <GridViewColumn Header="Vendido año" DisplayMemberBinding="{Binding QuantitySoldText}" Width="100"/>
                            <GridViewColumn Header="Existencia" DisplayMemberBinding="{Binding StockText}" Width="100"/>
                            <GridViewColumn Header="Lectura" DisplayMemberBinding="{Binding MovementNote}" Width="260"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Sin ventas">
                <ListView x:Name="NoMovementList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120"/>
                            <GridViewColumn Header="Producto" DisplayMemberBinding="{Binding Description}" Width="380"/>
                            <GridViewColumn Header="Categoría" DisplayMemberBinding="{Binding Category}" Width="140"/>
                            <GridViewColumn Header="Existencia" DisplayMemberBinding="{Binding StockText}" Width="100"/>
                            <GridViewColumn Header="Lectura" DisplayMemberBinding="{Binding MovementNote}" Width="260"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
