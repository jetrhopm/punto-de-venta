<Window x:Class="Pos.Desktop.FacturamaSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Facturación con Facturama" Width="760" Height="700" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="54" Height="54" Background="#E7F5ED" CornerRadius="6"><icons:PackIconMaterial Kind="FileDocumentCheckOutline" Width="31" Height="31" Foreground="#16803C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="14,2,0,0"><TextBlock Text="Facturación con PAC propio" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Cada tienda contrata y administra su propia cuenta Facturama" Foreground="#526577" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#F4F8FC" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,20,0,15">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Antes de conectar" FontWeight="SemiBold"/><TextBlock Text="El dueño debe crear su cuenta, contratar sus timbres y cargar su CSD en el portal de Facturama. JetVenta no compra timbres ni recibe los archivos del certificado." Foreground="#526577" TextWrapping="Wrap" Margin="0,4,14,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Crear cuenta de pruebas" Padding="12,8" Margin="0,0,8,0" Click="OnOpenSandboxRegistrationClick"/><Button Content="Crear cuenta productiva" Padding="12,8" Click="OnOpenProductionRegistrationClick"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D5E2EA" BorderThickness="1" CornerRadius="6" Padding="20">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <CheckBox x:Name="EnabledCheck" Grid.Row="0" Content="Activar conexión con Facturama para esta tienda" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ambiente" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="EnvironmentBox" Grid.Column="1" Height="38" SelectedValuePath="Content"><ComboBoxItem Content="Sandbox"/><ComboBoxItem Content="Production"/></ComboBox></Grid>
                <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Correo de Facturama" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="AccountEmailBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center" MaxLength="200"/></Grid>
                <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Contraseña API" VerticalAlignment="Center" FontWeight="SemiBold"/><PasswordBox x:Name="PasswordBox" Grid.Column="1" Height="38" VerticalContentAlignment="Center" MaxLength="300" ToolTip="Déjala vacía para conservar la contraseña ya guardada."/></Grid>
                <StackPanel Grid.Row="4" Margin="180,8,0,0"><TextBlock Text="La contraseña se protege con Windows DPAPI en este servidor y nunca se muestra ni se comparte con las cajas adicionales." Foreground="#526577" TextWrapping="Wrap"/><Border Background="#FFF8E7" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,16,0,0"><TextBlock Text="Sandbox no genera facturas válidas. Producción sólo debe activarse después de contratar directamente la API y los timbres con Facturama." Foreground="#665527" TextWrapping="Wrap"/></Border><TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="#526577" TextWrapping="Wrap"/></StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,18,0,0"><Button Content="Cerrar" DockPanel.Dock="Right" Background="#C53E36" Foreground="White" Padding="19,9" IsCancel="True"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0"><Button Content="Probar conexión" Background="#146CB0" Foreground="White" Padding="17,9" Margin="0,0,8,0" Click="OnTestConnectionClick"/><Button Content="Guardar configuración" Background="#16803C" Foreground="White" Padding="18,9" IsDefault="True" Click="OnSaveClick"/></StackPanel></DockPanel>
    </Grid>
</Window>
