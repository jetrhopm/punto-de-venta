<Window x:Class="Pos.Desktop.CustomerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Datos del cliente"
        Width="680" Height="570"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="50" Height="50" Background="#EAF4FB" CornerRadius="6"><icons:PackIconMaterial Kind="AccountDetailsOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="13,0,0,0"><TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Datos generales y estado de la cuenta" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Teléfono" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PhoneText" FontSize="15" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Correo electrónico" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="EmailText" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="RFC o identificación fiscal" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="TaxIdText" FontSize="15" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Estado" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="StateText" FontSize="15" Margin="0,4,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="#F4F8FB" BorderBrush="#D8E5ED" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,24,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Crédito" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="CreditText" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Límite" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="LimitText" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Saldo pendiente" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="BalanceText" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="#1D6D4B"/></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,24,0,0">
            <Button IsCancel="True" MinWidth="110">Cerrar</Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="OnEditClick" MinWidth="130" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="PencilOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Editar"/></StackPanel></Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnManageCreditClick" MinWidth="172" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="AccountCashOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Administrar crédito"/></StackPanel></Button>
                <Button x:Name="DeactivateButton" Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick" MinWidth="132"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="AccountOffOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Desactivar"/></StackPanel></Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
