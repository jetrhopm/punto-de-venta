<Window x:Class="Pos.Desktop.ReturnSaleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Devolución de venta" Width="620" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Devolución de producto" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Selecciona el producto, indica la cantidad y escribe el motivo de la devolución." Foreground="#526577" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
        <ListBox Grid.Row="1" x:Name="LinesList" Margin="0,14,0,12" DisplayMemberPath="DisplayText" MouseDoubleClick="OnLineSelected" ToolTip="Doble clic para seleccionar el producto"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Producto seleccionado" FontWeight="SemiBold" Foreground="#526577"/>
            <TextBlock x:Name="SelectedText" Text="Ningún producto seleccionado." Foreground="#17324D" Margin="0,3,0,8" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Cantidad de productos a devolver" Foreground="#526577"/><TextBox x:Name="QuantityTextBox" Height="34" ToolTip="Escribe cuántas piezas, unidades o kilos devolver"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Motivo de la devolución" Foreground="#526577"/><TextBox x:Name="ReasonTextBox" Height="34" ToolTip="Ejemplo: producto dañado o cambio del cliente"/></StackPanel>
                <Button Grid.Column="2" Height="34" VerticalAlignment="Bottom" Click="OnReturnClick">Devolver producto</Button>
            </Grid>
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
