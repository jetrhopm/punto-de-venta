<Window x:Class="Pos.Desktop.ReturnSaleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Devolver venta" Width="560" Height="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Devolver partida" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><ListBox Grid.Row="1" x:Name="LinesList" Margin="0,14,0,12" DisplayMemberPath="DisplayText" MouseDoubleClick="OnLineSelected"/><StackPanel Grid.Row="2"><TextBlock x:Name="SelectedText" Text="Selecciona una partida." Foreground="#526577"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBox x:Name="QuantityTextBox" Width="150" Height="34" ToolTip="Cantidad a devolver"/><TextBox x:Name="ReasonTextBox" Width="230" Height="34" Margin="8,0,0,0" ToolTip="Motivo"/><Button Margin="8,0,0,0" Click="OnReturnClick">Devolver</Button></StackPanel><TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel></Grid>
</Window>
