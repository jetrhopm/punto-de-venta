<Window x:Class="Pos.Desktop.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Impresora - JetVenta" Width="1040" Height="720" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="50" Height="50" Background="#E4F2EC" CornerRadius="6">
                    <icons:PackIconMaterial Kind="PrinterOutline" Width="28" Height="28" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,1,0,0">
                    <TextBlock Text="Impresora de esta caja" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Salida térmica mediante las impresoras configuradas en Windows" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileSummaryText" Text="Perfil sin guardar" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Dispositivo" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Impresora" FontWeight="SemiBold" Margin="0,13,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="PrinterBox" Height="40" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Height="40" Margin="8,0,0,0" Padding="0" Click="OnRefreshClick" ToolTip="Actualizar impresoras">
                            <icons:PackIconMaterial Kind="Refresh" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <Separator Margin="0,20,0,18"/>
                    <TextBlock Text="Papel térmico" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Ancho" FontWeight="SemiBold" Margin="0,13,0,6"/>
                    <Grid Height="42">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="Width58Button" GroupName="PaperWidth" Content="58 mm" Style="{StaticResource SegmentRadioStyle}" Checked="OnPreviewChanged"/>
                        <RadioButton x:Name="Width80Button" Grid.Column="1" GroupName="PaperWidth" Content="80 mm" Style="{StaticResource SegmentRadioStyle}" Checked="OnPreviewChanged"/>
                    </Grid>

                    <Separator Margin="0,20,0,18"/>
                    <TextBlock Text="Tipografía" FontSize="17" FontWeight="Bold"/>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Fuente instalada en Windows" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="FontBox" Height="40" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="OnPreviewChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Tamaño" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="FontSizeBox" Height="40" IsEditable="True" SelectionChanged="OnPreviewChanged">
                                <ComboBoxItem>7</ComboBoxItem><ComboBoxItem>8</ComboBoxItem><ComboBoxItem>9</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>11</ComboBoxItem><ComboBoxItem>12</ComboBoxItem><ComboBoxItem>14</ComboBoxItem><ComboBoxItem>16</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="NormalTotalsCheck" Margin="0,16,0,0" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged">
                        <StackPanel><TextBlock Text="Usar fuente normal para los totales" FontWeight="SemiBold"/><TextBlock Text="Si se desactiva, subtotal, total y cambio se imprimen en negrita." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#E8EEF2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Vista previa" FontSize="17" FontWeight="Bold"/><TextBlock Text="Ticket genérico de configuración" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/></StackPanel>
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" VerticalAlignment="Center"><TextBlock x:Name="PreviewWidthText" Text="80 mm" FontWeight="SemiBold"/></Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Border Background="White" BorderBrush="#B9C8D2" BorderThickness="1" HorizontalAlignment="Center" Effect="{StaticResource PanelShadowEffect}">
                            <ContentControl x:Name="TicketPreviewHost"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="25,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="3,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="195" Click="OnTestClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PrinterOutline" Width="19" Height="19" Margin="0,0,8,0"/><TextBlock Text="Imprimir ticket de prueba"/></StackPanel></Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Width="185" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,8,0"/><TextBlock Text="Guardar configuración"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
