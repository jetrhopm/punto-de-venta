<Window x:Class="Pos.Desktop.PrinterSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuración de impresora" Width="600" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24"><TextBlock Text="Impresora de esta caja" FontSize="22" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Impresoras instaladas y disponibles en Windows" Foreground="#526577" Margin="0,4,0,18"/><TextBlock Text="Impresora"/><ComboBox x:Name="PrinterBox" Height="36" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Width="150" Height="36" Click="OnRefreshClick">Actualizar lista</Button><Button Width="150" Height="36" Margin="10,0,0,0" Click="OnSaveClick">Guardar selección</Button></StackPanel><Separator Margin="0,20"/><TextBlock Text="Prueba de impresión" FontWeight="SemiBold"/><TextBlock Text="Abre el diálogo estándar de Windows para confirmar impresora y guardar como PDF cuando corresponda." Foreground="#526577" TextWrapping="Wrap" Margin="0,5,0,10"/><Button Width="180" Height="36" HorizontalAlignment="Left" Click="OnTestClick">Imprimir página de prueba</Button><TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="#526577" TextWrapping="Wrap"/></StackPanel>
</Window>
