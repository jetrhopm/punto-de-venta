<Window x:Class="Pos.Desktop.PrinterSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Configuración de impresora" Width="650" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#E4F2EC" CornerRadius="5"><icons:PackIconMaterial Kind="PrinterOutline" Width="27" Height="27" Foreground="{StaticResource SuccessBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Impresora de esta caja" FontSize="22" FontWeight="Bold"/><TextBlock Text="Colas instaladas y disponibles en Windows" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Impresora" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="PrinterBox" Height="38"/></StackPanel><Button Grid.Column="1" Width="50" Height="38" Margin="8,22,0,0" Click="OnRefreshClick" ToolTip="Actualizar lista"><icons:PackIconMaterial Kind="Refresh" Width="21" Height="21"/></Button></Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prueba de impresión" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Usa el controlador de Windows o Guardar como PDF." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Width="155" Click="OnTestClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="FileDocumentOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Página de prueba"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Width="150" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></StackPanel></Grid>
        <Border Grid.Row="3" Margin="0,20,0,0" Padding="12,9" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" VerticalAlignment="Top"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
