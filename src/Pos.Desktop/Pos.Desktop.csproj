<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pos.Application\Pos.Application.csproj" />
    <ProjectReference Include="..\Pos.Printing\Pos.Printing.csproj" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\app-icon-48.png" />
    <Resource Include="Assets\Icons\app-icon-64.png" />
    <Resource Include="Assets\Icons\app-icon-128.png" />
    <Resource Include="Assets\Icons\app-icon-256.png" />
    <Resource Include="Assets\Icons\app-icon-512.png" />
    <Resource Include="Assets\jetventa-banner.png" />
    <Resource Include="Assets\jetventa-icon.png" />
    <Resource Include="Assets\logo.png" />
    <Content Include="Assets\Icons\license-file.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>license-file.ico</TargetPath>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>JetVenta</AssemblyName>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
