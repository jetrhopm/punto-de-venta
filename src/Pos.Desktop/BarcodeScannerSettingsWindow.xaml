<Window x:Class="Pos.Desktop.BarcodeScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Lector de códigos - JetVenta" Width="750" Height="600" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" Background="#E7F0FA" CornerRadius="6"><icons:PackIconMaterial Kind="BarcodeScan" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="14,0,0,0"><TextBlock Text="Lector de códigos" FontSize="24" FontWeight="Bold"/><TextBlock Text="Configura cómo recibe esta caja los códigos de barras" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,22">
            <StackPanel>
                <TextBlock Text="Tipo de conexión" FontSize="17" FontWeight="Bold"/>
                <RadioButton x:Name="KeyboardModeButton" GroupName="ScannerMode" Margin="0,15,0,8" Checked="OnModeChanged">
                    <StackPanel><TextBlock Text="USB o Bluetooth tipo teclado (recomendado)" FontWeight="SemiBold"/><TextBlock Text="No necesita configuración ni controlador de JetVenta. El lector escribe el código y envía Enter." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="SerialModeButton" GroupName="ScannerMode" Margin="0,8" Checked="OnModeChanged">
                    <StackPanel><TextBlock Text="Puerto serial COM" FontWeight="SemiBold"/><TextBlock Text="Para lectores RS-232 o lectores USB que aparecen como puerto COM en Windows." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="DisabledModeButton" GroupName="ScannerMode" Margin="0,8" Checked="OnModeChanged"><TextBlock Text="No usar lector en esta caja" FontWeight="SemiBold"/></RadioButton>

                <Border x:Name="SerialPanel" Margin="0,16,0,0" Padding="18" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Puerto detectado" FontWeight="SemiBold"/><ComboBox x:Name="PortBox" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"/></StackPanel><Button Grid.Column="1" Margin="8,26,0,0" Height="40" Padding="0" Click="OnRefreshPortsClick" ToolTip="Buscar puertos COM"><icons:PackIconMaterial Kind="Refresh" Width="20" Height="20"/></Button></Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Velocidad" FontWeight="SemiBold"/><ComboBox x:Name="BaudRateBox" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Fin de lectura" FontWeight="SemiBold"/><ComboBox x:Name="TerminatorBox" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"><ComboBoxItem Content="CRLF"/><ComboBoxItem Content="CR"/><ComboBoxItem Content="LF"/></ComboBox></StackPanel></Grid>
                        <TextBlock Margin="0,15,0,0" Text="JetVenta usa 8 bits, sin paridad y 1 bit de parada. Si no aparece un puerto, el controlador del lector o adaptador debe instalarse con el fabricante." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="25,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="3,0,15,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Width="150" Margin="0,0,10,0" Click="OnTestClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Connection" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Probar puerto"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Width="170" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></StackPanel></Grid></Border>
    </Grid>
</Window>
