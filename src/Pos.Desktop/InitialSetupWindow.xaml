<Window x:Class="Pos.Desktop.InitialSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Configuración inicial - JetVenta" Width="560" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
        <StackPanel Orientation="Horizontal"><Border Width="50" Height="50" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="StoreCogOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="13,1,0,0"><TextBlock Text="Configuración inicial" FontSize="24" FontWeight="Bold"/><TextBlock Text="Crea la tienda, el administrador y la primera caja" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <Separator Margin="0,20,0,16"/>
        <TextBlock Text="Tienda" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
        <TextBlock Text="Nombre de la tienda" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBox x:Name="StoreNameBox"/>
        <TextBlock Text="Giro del negocio" FontWeight="SemiBold" Margin="0,11,0,5"/><ComboBox x:Name="BusinessTypeBox"><ComboBoxItem Content="Abarrotes" IsSelected="True"/><ComboBoxItem Content="Minisúper"/><ComboBoxItem Content="Farmacia"/><ComboBoxItem Content="Papelería"/><ComboBoxItem Content="Ferretería"/><ComboBoxItem Content="Comercio general"/><ComboBoxItem Content="Otro"/></ComboBox>
        <TextBlock Text="Administrador" FontSize="17" FontWeight="SemiBold" Foreground="#76538D" Margin="0,18,0,0"/>
        <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,8,0"><TextBlock Text="Usuario" FontWeight="SemiBold"/><TextBox x:Name="UserNameBox" Margin="0,5,0,0" Text="admin"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Nombre" FontWeight="SemiBold"/><TextBox x:Name="AdministratorNameBox" Margin="0,5,0,0" Text="Administrador"/></StackPanel></UniformGrid>
        <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,11,0,5"/><PasswordBox x:Name="PasswordBox"/>
        <TextBlock Text="Primera caja" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,18,0,0"/>
        <TextBlock Text="Nombre de la caja" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBox x:Name="RegisterNameBox" Text="Caja 1"/>
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="3,20,3,3" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="StoreCheckOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Crear tienda"/></StackPanel></Button>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</Window>
