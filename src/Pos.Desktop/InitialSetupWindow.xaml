<Window x:Class="Pos.Desktop.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracion inicial - Punto de Venta" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Configuracion inicial" FontSize="24" FontWeight="Bold" Foreground="#17324D" />
            <TextBlock Text="Completa estos datos para crear la tienda y el administrador." Margin="0,6,0,18" Foreground="#526577" TextWrapping="Wrap" />
            <TextBlock Text="Nombre de la tienda" />
            <TextBox x:Name="StoreNameBox" Height="32" Margin="0,4,0,10" />
            <TextBlock Text="Giro del negocio" />
            <ComboBox x:Name="BusinessTypeBox" Height="32" Margin="0,4,0,10">
                <ComboBoxItem Content="Abarrotes" IsSelected="True"/><ComboBoxItem Content="Minisuper"/><ComboBoxItem Content="Farmacia"/><ComboBoxItem Content="Papeleria"/><ComboBoxItem Content="Ferreteria"/><ComboBoxItem Content="Comercio general"/><ComboBoxItem Content="Otro"/>
            </ComboBox>
            <TextBlock Text="Usuario administrador" />
            <TextBox x:Name="UserNameBox" Height="32" Margin="0,4,0,10" Text="admin" />
            <TextBlock Text="Contraseña" />
            <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,4,0,10" />
            <TextBlock Text="Nombre del administrador" />
            <TextBox x:Name="AdministratorNameBox" Height="32" Margin="0,4,0,10" Text="Administrador" />
            <TextBlock Text="Nombre de la caja" />
            <TextBox x:Name="RegisterNameBox" Height="32" Margin="0,4,0,16" Text="Caja 1" />
            <Button x:Name="SaveButton" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnSaveClick">Crear tienda</Button>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
