<UserControl x:Class="Pos.Desktop.CustomerModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="#FFFFFF" BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="6" Padding="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EEF8FF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#56A9DC"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F7FBFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="7" Padding="18">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="HeaderIconBackground" Width="50" Height="50" Background="#EAF4FB" CornerRadius="6">
                    <icons:PackIconMaterial x:Name="HeaderIcon" Kind="AccountGroupOutline" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="13,0,0,0">
                    <TextBlock x:Name="TitleText" Text="Clientes" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Administra los datos generales y el estado de los clientes." Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="7" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Buscar cliente" FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchTextBox" Height="38" Margin="0,6,0,0" Padding="12,0" TextChanged="OnSearchChanged" ToolTip="Nombre, teléfono, correo o ID del cliente"/>
                </StackPanel>
                <Border x:Name="CreditSummaryPanel" Grid.Column="1" Visibility="Collapsed" Background="#E7F5EE" BorderBrush="#B8DEC8" BorderThickness="1" CornerRadius="5" Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Saldo total pendiente" FontSize="11" Foreground="#39745B"/>
                        <TextBlock x:Name="CreditSummaryText" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#1D6D4B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="7" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="#EAF4FB" CornerRadius="5"><icons:PackIconMaterial Kind="AccountGroupOutline" Width="20" Height="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="ListTitleText" Text="Clientes activos" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Selecciona un cliente o usa doble clic para consultar sus datos." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel>
                <ListBox Grid.Row="1" x:Name="CustomersList" Margin="0,10,0,0" SelectionChanged="OnCustomerSelectionChanged" MouseDoubleClick="OnCustomerDoubleClick" ToolTip="Doble clic para abrir los detalles del cliente">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="#EAF4FB" CornerRadius="19" VerticalAlignment="Center"><icons:PackIconMaterial Kind="AccountOutline" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><Border Background="#E7F5EE" CornerRadius="3" Padding="7,2" Margin="9,0,0,0"><TextBlock Text="{Binding CreditStatus}" FontSize="10" Foreground="#1D7651"/></Border></StackPanel><TextBlock Text="{Binding ContactSummary}" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Text="Saldo" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding BalanceDisplay}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" Foreground="#1D6D4B"/></StackPanel><icons:PackIconMaterial Grid.Column="3" Kind="ChevronRight" Width="19" Height="19" Foreground="#637589" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="#FFFFFF" BorderBrush="#DCE7F0" BorderThickness="1" CornerRadius="7" Padding="12">
            <Grid>
                <StackPanel x:Name="CustomerActionsPanel" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnCreateCustomerClick" MinWidth="176" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="AccountPlusOutline" Width="20" Height="20" Margin="0,0,7,0"/><TextBlock Text="Alta de cliente"/></StackPanel>
                    </Button>
                    <Button x:Name="EditCustomerButton" Click="OnEditCustomerClick" MinWidth="176" Margin="0,0,10,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="PencilOutline" Width="20" Height="20" Margin="0,0,7,0" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Editar cliente"/></StackPanel>
                    </Button>
                    <Button x:Name="DeactivateCustomerButton" Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateCustomerClick" MinWidth="198" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="AccountOffOutline" Width="20" Height="20" Margin="0,0,7,0"/><TextBlock Text="Desactivar cliente"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="CreditActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="OpenCreditAccountButton" Style="{StaticResource SuccessButtonStyle}" Click="OnOpenCreditAccountClick" MinWidth="224" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="AccountCashOutline" Width="20" Height="20" Margin="0,0,7,0"/><TextBlock Text="Ver cuenta y registrar abono"/></StackPanel>
                    </Button>
                    <TextBlock Text="Selecciona una cuenta o usa doble clic para consultar movimientos, ajustar el límite y registrar abonos." Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="10,7">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
