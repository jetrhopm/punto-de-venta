<Window x:Class="Pos.Desktop.ProductEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Producto" Width="720" Height="760" MinWidth="620" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Nuevo producto" FontSize="23" FontWeight="Bold" Foreground="#17324D"/>
            <TextBlock x:Name="SubtitleText" Text="Captura los datos del catálogo." Foreground="#5C7080" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12">
            <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Código de barras o código"/><TextBox x:Name="CodeBox" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Descripción"/><TextBox x:Name="DescriptionBox" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Departamento"/><ComboBox x:Name="DepartmentBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Unidad de venta"/><ComboBox x:Name="UnitBox" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <Border Background="#EAF3F8" BorderBrush="#C8DCE9" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,14,0,0">
                    <StackPanel><TextBlock Text="Menudeo" FontSize="16" FontWeight="SemiBold" Foreground="#156EA8"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="Costo"/><TextBox x:Name="CostBox" Text="0.00" Margin="0,4,0,0" LostFocus="OnPricingChanged"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="ProfitPercentBox" Text="20" Margin="0,4,0,0" LostFocus="OnPricingChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Precio venta"/><TextBox x:Name="PriceBox" Text="0.00" Margin="0,4,0,0" TextChanged="OnPriceChanged"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="ProfitAmountText" Foreground="#156EA8" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#F2ECF8" BorderBrush="#D4C3E5" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0">
                    <StackPanel><TextBlock Text="Mayoreo (opcional)" FontSize="16" FontWeight="SemiBold" Foreground="#7A4EAB"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="Precio mayoreo"/><TextBox x:Name="WholesalePriceBox" Text="0.00" Margin="0,4,0,0" TextChanged="OnWholesalePriceChanged"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="WholesaleProfitPercentBox" Text="0" Margin="0,4,0,0" LostFocus="OnWholesalePricingChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Mínimo de artículos"/><TextBox x:Name="WholesaleMinimumBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="WholesaleProfitAmountText" Foreground="#7A4EAB" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#F7FAF5" BorderBrush="#CFE1C5" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0">
                    <StackPanel><TextBlock Text="Inventario" FontSize="16" FontWeight="SemiBold" Foreground="#16834A"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock x:Name="InitialStockLabel" Text="Existencia inicial"/><TextBox x:Name="InitialStockBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Mínimo"/><TextBox x:Name="MinimumStockBox" Text="0" Margin="0,4,0,0" TextChanged="OnStockLimitChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Máximo"/><TextBox x:Name="MaximumStockBox" Text="0" Margin="0,4,0,0" TextChanged="OnStockLimitChanged"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="StockHintText" Foreground="#5C7080" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="IsKitBox" Content="Es kit o producto compuesto" Margin="0,13,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#C33B32" TextWrapping="Wrap" MaxWidth="440"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource CancelButtonStyle}" IsCancel="True" Click="OnCancelClick" Margin="6,0,0,0"/><Button x:Name="SaveButton" Content="Guardar" Style="{StaticResource ConfirmButtonStyle}" IsDefault="True" Click="OnSaveClick" Margin="8,0,0,0"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>
