<Window x:Class="Pos.Desktop.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Producto" Width="720" Height="700" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="46" Height="46" Background="#E7F3FB" CornerRadius="6"><icons:PackIconMaterial Kind="PackageVariantClosed" Width="27" Height="27" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock x:Name="TitleText" Text="Agregar producto" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Completa la información comercial e inventario inicial." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,10" VerticalScrollBarVisibility="Auto"><StackPanel>
            <UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Código" FontWeight="SemiBold"/><TextBox x:Name="CodeBox" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Descripción" FontWeight="SemiBold"/><TextBox x:Name="DescriptionBox" Margin="0,5,0,0"/></StackPanel></UniformGrid>
            <UniformGrid Columns="2" Margin="0,12,0,0"><StackPanel Margin="0,0,8,0"><TextBlock Text="Departamento" FontWeight="SemiBold"/><ComboBox x:Name="DepartmentBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Unidad de venta" FontWeight="SemiBold"/><ComboBox x:Name="UnitBox" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="Pieza"/><ComboBoxItem Content="Kilogramo"/><ComboBoxItem Content="Gramo"/><ComboBoxItem Content="Litro"/><ComboBoxItem Content="Servicio"/></ComboBox></StackPanel></UniformGrid>
            <UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="Costo"/><TextBox x:Name="CostBox" Text="0.00" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0"><TextBlock Text="Ganancia %"/><TextBox x:Name="ProfitBox" Text="20" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Text="Precio venta"/><TextBox x:Name="PriceBox" Text="0.00" Margin="0,5,0,0"/></StackPanel></UniformGrid>
            <UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="Precio mayoreo (opcional)"/><TextBox x:Name="WholesalePriceBox" Text="0.00" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0"><TextBlock Text="Ganancia mayoreo %"/><TextBox x:Name="WholesaleProfitBox" Text="0" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Text="Cantidad mínima mayoreo"/><TextBox x:Name="WholesaleMinimumBox" Text="0" Margin="0,5,0,0"/></StackPanel></UniformGrid>
            <Border Margin="0,18,0,0" Padding="12" Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="5"><StackPanel><TextBlock Text="Inventario" FontWeight="SemiBold"/><UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Text="Existencia inicial"/><TextBox x:Name="InitialStockBox" Text="0" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0"><TextBlock Text="Inventario mínimo"/><TextBox x:Name="MinimumStockBox" Text="0" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Text="Inventario máximo"/><TextBox x:Name="MaximumStockBox" Text="0" Margin="0,5,0,0"/></StackPanel></UniformGrid><TextBlock x:Name="InventoryHintText" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">La existencia inicial se registra como movimiento. Después de guardar, las existencias se ajustan desde Inventario.</TextBlock></StackPanel></Border>
            <CheckBox x:Name="IsKitBox" Content="Es kit o producto compuesto" Margin="0,14,0,0"/>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="115" Height="39" Margin="0,0,10,0" Background="#C63D3D" Foreground="White" IsCancel="True">Cancelar</Button><Button Width="135" Height="39" Background="#238A68" Foreground="White" FontWeight="SemiBold" IsDefault="True" Click="OnSaveClick">Guardar</Button></StackPanel>
    </Grid>
</Window>
