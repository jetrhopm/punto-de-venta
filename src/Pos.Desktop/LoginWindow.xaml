<Window x:Class="Pos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Iniciar sesión - JetVenta"
        Width="900" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#102F43">
            <Grid Margin="32,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Image Source="/Pos.Desktop;component/Assets/jetventa-icon.png"
                           Width="224" Height="224"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="PUNTO DE VENTA"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#BFE9F7"/>
                    <Border Width="54" Height="3" Margin="0,17,0,20"
                            HorizontalAlignment="Center"
                            Background="#31C1D4" CornerRadius="2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <icons:PackIconMaterial Kind="StorefrontOutline"
                                                Width="20" Height="20"
                                                Margin="0,0,8,0"
                                                Foreground="White"/>
                        <TextBlock x:Name="StoreNameText"
                                   Text="Preparando tienda"
                                   MaxWidth="245"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <TextBlock Text="JetVenta para Windows"
                               HorizontalAlignment="Center"
                               FontSize="12" Foreground="#B9CAD4"/>
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12" Foreground="#91A9B7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="54,38,54,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Bienvenido"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Inicia sesión para abrir tu caja y comenzar a vender."
                           Margin="0,7,0,0"
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <Grid>
                    <icons:PackIconMaterial Kind="AccountOutline"
                                            Width="21" Height="21"
                                            Margin="14,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            IsHitTestVisible="False"/>
                    <TextBox x:Name="UserNameTextBox"
                             Height="46" Padding="45,7,12,7"
                             Text="admin" FontSize="16"
                             automation:AutomationProperties.Name="Usuario"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <Grid>
                    <icons:PackIconMaterial Kind="LockOutline"
                                            Width="21" Height="21"
                                            Margin="14,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            IsHitTestVisible="False"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="46" Padding="45,7,12,7"
                                 FontSize="16"
                                 PreviewKeyUp="OnPasswordPreviewKeyUp"
                                 automation:AutomationProperties.Name="Contraseña"/>
                </Grid>
                <StackPanel x:Name="CapsLockPanel" Visibility="Collapsed"
                            Margin="2,7,0,0" Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="KeyboardCaps"
                                            Width="16" Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="Bloq Mayús está activado."
                               FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="3" x:Name="LoginButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="48" Margin="0,22,0,0"
                    IsDefault="True" Click="OnLoginClick">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial x:Name="LoginButtonIcon"
                                            Kind="LoginVariant" Width="20" Height="20"
                                            Margin="0,0,9,0"/>
                    <TextBlock x:Name="LoginButtonText"
                               Text="Iniciar sesión" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Border Grid.Row="4" x:Name="StatusBorder"
                    Margin="0,16,0,0" Padding="13,11"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <icons:PackIconMaterial x:Name="StatusIcon"
                                            Kind="ProgressClock"
                                            Width="20" Height="20"
                                            Margin="0,1,10,0"
                                            Foreground="{StaticResource PrimaryBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="MessageText"
                                   Text="Preparando JetVenta..."
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="BusyProgress"
                                     Height="3" Margin="0,9,0,0"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="6" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ServerButton" Margin="0,0,5,0" Click="OnServerClick">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="ServerNetwork" Width="18" Height="18" Margin="0,0,7,0"/>
                        <TextBlock Text="Cambiar servidor"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" x:Name="PairButton" Margin="5,0,0,0" Click="OnPairClick">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="LinkVariant" Width="18" Height="18" Margin="0,0,7,0"/>
                        <TextBlock Text="Emparejar caja"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                            Margin="2,13,2,0" Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="LanConnect"
                                            Width="16" Height="16" Margin="0,1,7,0"
                                            Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="ServerText"
                               MaxWidth="410"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
