<Window x:Class="Pos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión - Punto de Venta" Width="440" Height="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F8FAFC" Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Punto de Venta" FontSize="24" FontWeight="Bold" Foreground="#17324D" />
            <TextBlock Text="Iniciar sesión" Margin="0,6,0,20" FontSize="16" Foreground="#526577" />
            <TextBlock Text="Usuario" />
            <TextBox x:Name="UserNameTextBox" Height="34" Margin="0,4,0,12" Text="admin" FontSize="16" />
            <TextBlock Text="Contraseña" />
            <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,4,0,16" FontSize="16" />
            <Button x:Name="LoginButton" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" IsDefault="True" Click="OnLoginClick">Iniciar sesión</Button>
            <Button Height="30" Margin="0,8,0,0" Click="OnServerClick">Configurar servidor</Button>
            <Button Height="30" Margin="0,6,0,0" Click="OnPairClick">Emparejar esta caja</Button>
        </StackPanel>
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10" Background="#EEF5FA" BorderBrush="#C9D8E5" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ServerText" Foreground="#526577" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" Foreground="#B42318" TextWrapping="Wrap" MinHeight="36" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
