<Window x:Class="Pos.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Iniciar sesión - JetVenta" Width="500" Height="590"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#17384E">
            <Grid Margin="20,0"><Image Source="/Assets/jetventa-banner.png" Width="440" Height="122" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Border>
        <Grid Grid.Row="1" Margin="38,26,38,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Iniciar sesión" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid><icons:PackIconMaterial Kind="AccountOutline" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox x:Name="UserNameTextBox" Height="42" Padding="40,6,9,6" Text="admin" FontSize="16"/></Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,13,0,0">
                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid><icons:PackIconMaterial Kind="LockOutline" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><PasswordBox x:Name="PasswordBox" Height="42" Padding="40,6,9,6" FontSize="16"/></Grid>
            </StackPanel>
            <Button Grid.Row="3" x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="0,18,0,0" IsDefault="True" Click="OnLoginClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LoginVariant" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="Iniciar sesión" FontWeight="SemiBold"/></StackPanel></Button>
            <UniformGrid Grid.Row="4" Columns="2" Margin="0,8,0,0">
                <Button Click="OnServerClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ServerNetwork" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Servidor"/></StackPanel></Button>
                <Button Click="OnPairClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LinkVariant" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Emparejar caja"/></StackPanel></Button>
            </UniformGrid>
            <Border Grid.Row="5" Margin="0,15,0,0" Padding="12,10" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ServerOutline" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,7,0"/><TextBlock x:Name="ServerText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel>
                    <TextBlock x:Name="MessageText" Margin="25,7,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="34"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
