<Window x:Class="Pos.Desktop.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cliente"
        Width="620" Height="530"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="#EAF4FB" CornerRadius="6"><icons:PackIconMaterial Kind="AccountEditOutline" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="13,0,0,0"><TextBlock x:Name="TitleText" Text="Alta de cliente" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Text="Captura sus datos generales para poder asignarlo a ventas." Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Nombre del cliente" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Height="38" Margin="0,6,0,0" ToolTip="Nombre completo o nombre comercial"/>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Teléfono" FontWeight="SemiBold"/><TextBox x:Name="PhoneBox" Height="38" Margin="0,6,0,0" ToolTip="Teléfono opcional del cliente"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Correo electrónico" FontWeight="SemiBold"/><TextBox x:Name="EmailBox" Height="38" Margin="0,6,0,0" ToolTip="Correo opcional del cliente"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="RFC o identificación fiscal" FontWeight="SemiBold"/><TextBox x:Name="TaxIdBox" Height="38" Margin="0,6,0,0" ToolTip="Dato fiscal opcional"/></StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="Esc: cancelar" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button IsCancel="True" MinWidth="118" Margin="0,0,8,0">Cancelar</Button>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnSaveClick" MinWidth="142"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock x:Name="SaveButtonText" Text="Crear cliente"/></StackPanel></Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
