<Window x:Class="Pos.Desktop.MeasureSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Unidades de medida" Width="600" Height="365" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="WeightKilogram" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Unidad de peso" FontSize="22" FontWeight="Bold"/><TextBlock Text="Predeterminada para productos vendidos a granel" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,25,0,15"><TextBlock Text="Unidad de peso que usará la tienda" FontWeight="SemiBold"/><ComboBox x:Name="WeightUnitBox" Margin="0,7,0,15" FontSize="16"><ComboBoxItem Content="Kilogramo"/><ComboBoxItem Content="Gramo"/><ComboBoxItem Content="Libra"/><ComboBoxItem Content="Onza"/></ComboBox><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="14"><StackPanel><TextBlock Text="Cómo se aplica" FontWeight="SemiBold"/><TextBlock Text="Al crear un producto, selecciona “Granel (unidad configurada)”. JetVenta guardará la unidad elegida aquí. Cambiar esta preferencia no altera existencias, precios ni ventas históricas." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="155" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></Grid>
    </Grid>
</Window>
