<Window x:Class="Pos.Desktop.SaleFolioSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Modificar folios" Width="610" Height="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="ReceiptTextEditOutline" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Folios de venta" FontSize="22" FontWeight="Bold"/><TextBlock Text="Consecutivo único para ventas confirmadas" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,25,0,15">
            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Último folio emitido" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="LastFolioText" Text="-" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Siguiente folio actual" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="CurrentNextFolioText" Text="-" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
            <TextBlock Text="Definir siguiente folio" FontWeight="SemiBold"/><TextBox x:Name="NextFolioBox" Margin="0,6,0,8" FontSize="18"/>
            <TextBlock Text="Solo se puede avanzar el consecutivo. JetVenta no permite reutilizar ni bajar folios que ya fueron reservados." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="190" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar siguiente folio"/></StackPanel></Button></Grid>
    </Grid>
</Window>
