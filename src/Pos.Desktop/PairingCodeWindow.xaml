<Window x:Class="Pos.Desktop.PairingCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Conectar caja adicional" Width="740" Height="720" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="50" Height="50" Background="{StaticResource PrimarySoftBrush}" CornerRadius="6"><icons:PackIconMaterial Kind="LanConnect" Width="29" Height="29" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,1,0,0"><TextBlock Text="Conectar una caja adicional" FontSize="23" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Prepara la red y usa estos datos al instalar la segunda computadora." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="14" Margin="0,20,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dirección de la caja principal" FontWeight="SemiBold"/><TextBlock Text="Usa esta IP en la segunda computadora. No uses 127.0.0.1." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,7"/><ComboBox x:Name="AddressBox" Height="34" DisplayMemberPath="Display" SelectionChanged="OnAddressChanged"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="12,0,0,0"><Button Width="42" Height="34" Padding="0" Click="OnRefreshAddressesClick" ToolTip="Actualizar direcciones de red"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18"/></Button><Button Width="105" Height="34" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="OnCopyAddressClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Copiar IP"/></StackPanel></Button></StackPanel></Grid></Border>
        <Border Grid.Row="2" Background="#EAF7EF" BorderBrush="#A7D8BA" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Código temporal" FontWeight="SemiBold" Foreground="#15663B"/><TextBlock x:Name="CodeText" Text="------" FontSize="31" FontWeight="Bold" Foreground="#16834A" Margin="0,2,0,0"/><TextBlock x:Name="CodeHintText" Text="Genera un código antes de iniciar la instalación de la caja adicional." Foreground="#356A4A" FontSize="12" Margin="0,2,0,0"/></StackPanel><Button x:Name="GenerateButton" Grid.Column="1" Width="170" Height="40" VerticalAlignment="Center" Style="{StaticResource ConfirmButtonStyle}" Click="OnGenerateClick"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="KeyOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Generar código"/></StackPanel></Button></Grid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="15"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Pasos sencillos" FontSize="17" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="1. Conecta ambas computadoras al mismo router o switch. Por cable es más estable." TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="2. En ambas computadoras abre Configuración de Windows &gt; Red e Internet &gt; Wi-Fi o Ethernet &gt; Propiedades. En Perfil de red selecciona Privada." TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="3. No uses una red Pública, de invitados o Wi-Fi que impida comunicarse entre equipos." TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="4. En esta caja principal evita que Windows entre en suspensión automática." TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="5. En la segunda computadora ejecuta Setup.exe, selecciona Caja adicional y escribe esta IP, puerto 5000, el código temporal y el nombre de la nueva caja." TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="6. No necesitas compartir carpetas, desactivar Firewall, abrir PostgreSQL ni abrir puertos del router. JetVenta funciona solamente dentro de tu red privada." TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,16,0"/><Button Grid.Column="1" Width="110" Style="{StaticResource CancelButtonStyle}" IsCancel="True">Cerrar</Button></Grid>
    </Grid>
</Window>
