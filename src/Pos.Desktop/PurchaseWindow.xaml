<UserControl x:Class="Pos.Desktop.PurchaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Recibir compra" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock Text="Selecciona el proveedor que entrega la mercancía." Margin="0,4,0,4" Foreground="#526577"/><TextBlock Text="Proveedor"/><ComboBox x:Name="SupplierComboBox" Margin="0,4,0,8" Height="34" DisplayMemberPath="DisplayText"/><StackPanel Orientation="Horizontal"><StackPanel Width="470"><TextBlock Text="Nuevo proveedor"/><TextBox x:Name="NewSupplierTextBox" Height="32"/></StackPanel><Button Margin="8,18,0,0" Click="OnCreateSupplierClick">Crear proveedor</Button></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12"><TextBlock Text="Buscar producto"/><TextBlock Text="Busca por código o descripción. El precio y la existencia son informativos." Margin="0,3,0,5" Foreground="#526577"/><TextBox x:Name="SearchTextBox" Height="34" TextChanged="OnSearchChanged"/><ListBox x:Name="ResultsList" Height="130" Margin="0,6,0,10" DisplayMemberPath="DisplayText" MouseDoubleClick="OnProductSelected" Visibility="Collapsed"/><Border Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="Producto seleccionado" FontWeight="SemiBold"/><TextBlock x:Name="SelectedProductText" Text="Selecciona un producto." Foreground="#526577" Margin="0,4,0,0"/><TextBlock x:Name="SelectedProductInfoText" Text="" Foreground="#526577" Margin="0,3,0,0"/></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><StackPanel Width="220"><TextBlock Text="Cantidad recibida"/><TextBox x:Name="QuantityTextBox" Height="34"/></StackPanel><StackPanel Width="220" Margin="10,0,0,0"><TextBlock Text="Costo unitario de compra"/><TextBox x:Name="UnitCostTextBox" Height="34"/></StackPanel></StackPanel></StackPanel>
        <StackPanel Grid.Row="2"><Button Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnReceiveClick">Recibir compra</Button><TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
    </Grid>
</UserControl>
