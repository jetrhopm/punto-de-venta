<Window x:Class="Pos.Desktop.PurchaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Proveedores y compras" Width="650" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Recibir compra" FontSize="22" FontWeight="SemiBold" Foreground="#17324D"/><ComboBox x:Name="SupplierComboBox" Margin="0,12,0,4" Height="34" DisplayMemberPath="DisplayText"/><StackPanel Orientation="Horizontal"><TextBox x:Name="NewSupplierTextBox" Width="420" Height="32" ToolTip="Nombre de nuevo proveedor"/><Button Margin="8,0,0,0" Click="OnCreateSupplierClick">Crear proveedor</Button></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12"><TextBlock Text="Producto"/><TextBox x:Name="SearchTextBox" Height="34" TextChanged="OnSearchChanged"/><ListBox x:Name="ResultsList" Height="100" Margin="0,6,0,10" DisplayMemberPath="DisplayText" MouseDoubleClick="OnProductSelected" Visibility="Collapsed"/><TextBlock x:Name="SelectedProductText" Text="Selecciona un producto." Foreground="#526577"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBox x:Name="QuantityTextBox" Width="180" Height="34" ToolTip="Cantidad"/><TextBox x:Name="UnitCostTextBox" Width="180" Height="34" Margin="8,0,0,0" ToolTip="Costo unitario"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="2"><Button Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnReceiveClick">Recibir compra</Button><TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel>
    </Grid>
</Window>
