<Window x:Class="Pos.Desktop.PaymentMethodSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Formas de pago" Width="640" Height="455" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="CreditCardMultipleOutline" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Formas de pago" FontSize="22" FontWeight="Bold"/><TextBlock Text="Define las opciones disponibles al cobrar una venta" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,12"><TextBlock Text="Activa las formas de pago que acepta la tienda" FontWeight="SemiBold"/><TextBlock Text="Los métodos desactivados no se mostrarán en la ventana de cobro." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12"/><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5" Padding="14"><StackPanel><CheckBox x:Name="CashBox" Content="Efectivo" FontSize="16" Margin="0,3"/><CheckBox x:Name="CardBox" Content="Tarjeta" FontSize="16" Margin="0,8,0,3"/><CheckBox x:Name="TransferBox" Content="Transferencia" FontSize="16" Margin="0,8,0,3"/><CheckBox x:Name="CreditBox" Content="Crédito" FontSize="16" Margin="0,8,0,3"/></StackPanel></Border><TextBlock Text="Pago mixto aparece automáticamente cuando hay dos o más formas de pago activas." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="155" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></Grid>
    </Grid>
</Window>
