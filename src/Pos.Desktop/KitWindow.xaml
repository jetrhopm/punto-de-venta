<Window x:Class="Pos.Desktop.KitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Kits" Width="1110" Height="700" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><Style x:Key="ToolbarActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="11,4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,6,0"/></Style></Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#F0EBFF" CornerRadius="6"><icons:PackIconMaterial Kind="PackageVariant" Width="28" Height="28" Foreground="#5223B8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Kits y productos compuestos" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Vende un paquete y descuenta automáticamente sus artículos." Foreground="#5C7080" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Margin="0,16,0,12" Background="#F5F1FF" BorderBrush="#D9C9F0" BorderThickness="1" CornerRadius="6" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Buscar kit por código o descripción" FontSize="11" Foreground="#637589"/><TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Click="OnNewClick" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="PlusCircle" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Nuevo kit"/></StackPanel></Button><Button Style="{StaticResource ToolbarActionButton}" Background="#0879D8" Foreground="White" BorderBrush="#0879D8" Click="OnEditDetailsClick" Margin="0,0,7,0">Editar datos</Button><Button Style="{StaticResource ToolbarActionButton}" Background="#FFF7F7" Foreground="#A42836" BorderBrush="#E7AFB7" Click="OnToggleInactiveClick"><TextBlock x:Name="ShowInactiveText" Text="Mostrar bajas"/></Button></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,12,0"><DataGrid x:Name="KitsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnKitSelectionChanged" MouseDoubleClick="OnKitDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Kit" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="82"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="78"/></DataGrid.Columns></DataGrid></Border>
      <Border Grid.Column="1" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="SelectedTitleText" Text="Selecciona o crea un kit" FontSize="19" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock x:Name="SelectedDetailText" Text="El precio de venta se edita en los datos del kit." Foreground="#5C7080" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Buscar artículo para agregar" FontSize="11" Foreground="#637589"/><TextBox x:Name="ComponentSearchBox" Height="33" TextChanged="OnComponentSearchChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Cantidad" FontSize="11" Foreground="#637589"/><TextBox x:Name="QuantityBox" Height="33" Text="1"/></StackPanel><Button Grid.Column="2" Style="{StaticResource ConfirmButtonStyle}" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="OnAddComponentClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Agregar"/></StackPanel></Button><ListBox x:Name="ComponentResults" Grid.ColumnSpan="3" Margin="0,56,0,0" Height="95" DisplayMemberPath="Display" Visibility="Collapsed" MouseDoubleClick="OnComponentSelected"/></Grid>
        <DataGrid Grid.Row="2" x:Name="ComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Artículo" Binding="{Binding Display}" Width="*"/><DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="65"/><DataGridTextColumn Header="Costo unit." Binding="{Binding UnitCost, StringFormat={}{0:C2}}" Width="88"/><DataGridTextColumn Header="Venta unit." Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="88"/><DataGridTextColumn Header="Costo comp." Binding="{Binding TotalCost, StringFormat={}{0:C2}}" Width="92"/></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TotalsText" FontWeight="SemiBold" Foreground="#17324D"/><TextBlock x:Name="StatusText" Foreground="#5C7080" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource DangerButtonStyle}" Click="OnRemoveComponentClick" Margin="0,0,7,0">Quitar artículo</Button><Button Style="{StaticResource ConfirmButtonStyle}" Click="OnSaveCompositionClick" Margin="0,0,7,0">Guardar composición</Button><Button x:Name="ReactivateButton" Style="{StaticResource ConfirmButtonStyle}" Click="OnReactivateClick" Visibility="Collapsed">Reactivar</Button><Button x:Name="DeactivateButton" Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick" Margin="7,0,0,0">Dar de baja</Button></StackPanel></Grid></Grid></Border>
    </Grid>
    <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource CancelButtonStyle}" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"/>
  </Grid>
</Window>
