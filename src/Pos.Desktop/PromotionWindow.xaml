<Window x:Class="Pos.Desktop.PromotionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Promociones" Width="1120" Height="700" WindowStartupLocation="CenterOwner">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#E7F3FB" CornerRadius="5"><icons:PackIconMaterial Kind="TagMultipleOutline" Width="25" Height="25" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="Promociones" FontSize="22" FontWeight="Bold"/><TextBlock Text="Descuentos por porcentaje, importe fijo o compra 3 y paga 2" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel><Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="#F3F8FC" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Producto"/><TextBox x:Name="ProductBox" TextChanged="OnProductTextChanged"/><TextBlock x:Name="ProductPricingText" Text="Selecciona un producto para consultar costo y precio de venta." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/><ListBox x:Name="ProductList" Height="85" Visibility="Collapsed" MouseDoubleClick="OnProductSelected"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Nombre único"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Tipo de promoción"/><ComboBox x:Name="TypeBox" SelectionChanged="OnTypeChanged" SelectedIndex="0"><ComboBoxItem Tag="percent">Porcentaje</ComboBoxItem><ComboBoxItem Tag="amount">Descuento fijo ($)</ComboBoxItem><ComboBoxItem Tag="buyPay">Compra N y paga M</ComboBoxItem></ComboBox></StackPanel><Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="OnSaveClick" Style="{StaticResource ConfirmButtonStyle}"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="17" Height="17" Margin="0,0,5,0"/><TextBlock x:Name="SaveButtonText" Text="Guardar"/></StackPanel></Button><UniformGrid Grid.Row="1" Grid.ColumnSpan="4" Columns="4" Margin="0,12,0,0"><StackPanel Margin="0,0,8,0"><TextBlock x:Name="ValueOneLabel" Text="Descuento %"/><TextBox x:Name="ValueOneBox" Text="10"/></StackPanel><StackPanel Margin="8,0"><TextBlock x:Name="ValueTwoLabel" Text="Importe"/><TextBox x:Name="ValueTwoBox" Text="0" IsEnabled="False"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="Vigencia desde (opcional)"/><DatePicker x:Name="StartDate"/></StackPanel><StackPanel Margin="8,0"><TextBlock Text="Vigencia hasta (opcional)"/><DatePicker x:Name="EndDate"/></StackPanel></UniformGrid></Grid></Border><Border Grid.Row="2" Margin="0,0,0,12" Padding="10,8" Background="#F8FBFE" BorderBrush="#D7E6F0" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><icons:PackIconMaterial Kind="Magnify" Width="19" Height="19" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="PromotionSearchBox" Height="32" VerticalContentAlignment="Center" TextChanged="OnPromotionSearchChanged" ToolTip="Busca por promoción, código o producto"/></Grid></Border><DataGrid Grid.Row="3" x:Name="PromotionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnPromotionSelected" MouseDoubleClick="OnPromotionDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding ProductDisplay}" Width="2*"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Costo" Binding="{Binding ProductCost, StringFormat={}{0:C2}}" Width="85"/><DataGridTextColumn Header="Precio venta" Binding="{Binding ProductPrice, StringFormat={}{0:C2}}" Width="100"/><DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="60"/><DataGridTextColumn Header="Desc. fijo" Binding="{Binding DiscountAmount, StringFormat={}{0:C2}}" Width="90"/><DataGridTextColumn Header="Compra" Binding="{Binding BuyQuantity}" Width="70"/><DataGridTextColumn Header="Paga" Binding="{Binding PayQuantity}" Width="65"/><DataGridTextColumn Header="Desde" Binding="{Binding StartsAtUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="92"/><DataGridTextColumn Header="Hasta" Binding="{Binding EndsAtUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="92"/></DataGrid.Columns></DataGrid><Grid Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Content="Desactivar seleccionada" HorizontalAlignment="Right" Click="OnDeactivateClick" Style="{StaticResource DangerButtonStyle}"/></Grid></Grid>
</Window>
