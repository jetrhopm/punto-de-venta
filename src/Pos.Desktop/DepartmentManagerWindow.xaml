<Window x:Class="Pos.Desktop.DepartmentManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Departamentos" Width="620" Height="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#E7F3FB" CornerRadius="5"><icons:PackIconMaterial Kind="ShapeOutline" Width="24" Height="24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="Departamentos" FontSize="22" FontWeight="Bold"/><TextBlock Text="Organiza el catálogo sin hacer obligatoria esta clasificación" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel><DataGrid Grid.Row="1" x:Name="DepartmentsGrid" Margin="0,16,0,12" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock Text="Nombre del departamento"/><TextBox x:Name="NameBox" Margin="0,4,0,0" Height="34"/></StackPanel><Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nuevo" Click="OnNewClick" Margin="0,0,6,0"/><Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" Margin="0,0,6,0"/><Button Content="Desactivar" Style="{StaticResource DangerButtonStyle}" Click="OnDeactivateClick"/></StackPanel></Grid></Grid>
</Window>
