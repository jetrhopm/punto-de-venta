<Window x:Class="Pos.Desktop.InventoryAdjustmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajustar inventario" Width="560" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock Text="Ajustar inventario" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <TextBlock Text="Producto" Margin="0,14,0,4" /><TextBox x:Name="SearchTextBox" Height="34" TextChanged="OnSearchChanged" />
        <ListBox x:Name="ResultsList" Height="90" Margin="0,6,0,10" DisplayMemberPath="DisplayText" MouseDoubleClick="OnProductSelected" Visibility="Collapsed" />
        <TextBlock x:Name="SelectedProductText" Text="Selecciona un producto de la lista." Foreground="#526577" />
        <TextBlock Text="Cantidad a ajustar" Margin="0,12,0,4" />
        <TextBox x:Name="QuantityTextBox" Height="34" />
        <Border Margin="0,7,0,0" Padding="10,8" Background="#F3F8FC" BorderBrush="#CFE1EE" BorderThickness="1" CornerRadius="5">
            <TextBlock Text="Ejemplo: escribe 10 para agregar 10 piezas. Para retirar producto escribe -10 y se descontarán 10 piezas del inventario." TextWrapping="Wrap" Foreground="#24516D" />
        </Border>
        <TextBlock Text="Motivo obligatorio" Margin="0,10,0,4" /><TextBox x:Name="ReasonTextBox" Height="34" ToolTip="Explica por qué se agrega o retira mercancía" />
        <Button Margin="0,16,0,0" Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnAdjustClick">Registrar ajuste</Button>
        <TextBlock x:Name="MessageText" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
