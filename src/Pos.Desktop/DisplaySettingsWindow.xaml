<Window x:Class="Pos.Desktop.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Pantalla - JetVenta" Width="660" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="MonitorDashboard" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="14,1,0,0"><TextBlock Text="Tamaño de pantalla" FontSize="23" FontWeight="Bold"/><TextBlock Text="Esta configuración se guarda sólo en esta computadora." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,14">
            <TextBlock Text="Perfil visual" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <RadioButton x:Name="StandardButton" GroupName="DisplayProfile" Margin="0,5" Checked="OnProfileChanged"><StackPanel><TextBlock Text="Predeterminado - 1920 x 1080" FontWeight="SemiBold"/><TextBlock Text="Mantiene exactamente el tamaño visual actual de JetVenta." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></RadioButton>
            <RadioButton x:Name="CompactButton" GroupName="DisplayProfile" Margin="0,12,0,5" Checked="OnProfileChanged"><StackPanel><TextBlock Text="Compacto - 1366 x 768" FontWeight="SemiBold"/><TextBlock Text="Reduce espacios, botones y controles para pantallas de menor altura." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></RadioButton>
            <RadioButton x:Name="ReducedButton" GroupName="DisplayProfile" Margin="0,12,0,5" Checked="OnProfileChanged"><StackPanel><TextBlock Text="Reducido - 1280 x 800" FontWeight="SemiBold"/><TextBlock Text="Usa medidas más cortas para equipos antiguos o pantallas pequeñas." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></RadioButton>
            <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="11" Margin="0,18,0,0"><TextBlock Text="Después de guardar, cierra y vuelve a abrir JetVenta para que todas las ventanas adopten el perfil seleccionado. Esta opción no modifica ventas, inventario ni configuraciones de otras cajas." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/></Border>
        </StackPanel>
        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/><Button Style="{StaticResource ConfirmButtonStyle}" Width="170" HorizontalAlignment="Right" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar perfil"/></StackPanel></Button></Grid>
    </Grid>
</Window>
