<Window x:Class="Pos.Desktop.ProductImportMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relacionar columnas para importar"
        Width="1100" Height="800" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Relaciona las columnas del archivo" FontSize="22" FontWeight="Bold" Foreground="#17324D"/>
            <TextBlock Margin="0,6,0,0"
                       Text="La primera fila del archivo se usa como nombre de cada columna. Código y producto son obligatorios; los demás pueden dejarse como No importar."
                       TextWrapping="Wrap" Foreground="#526577"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="12"
                Background="#EAF5FA" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="5">
            <TextBlock Text="Se aplicó la propuesta predeterminada para archivos exportados por Eleventa. Revisa los primeros productos y ajusta lo necesario; el archivo original no será modificado."
                       TextWrapping="Wrap" Foreground="#17324D"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Vista previa del archivo: primeros 3 productos" FontWeight="SemiBold" Foreground="#17324D"/>
            <DataGrid Grid.Row="1" x:Name="SourcePreviewGrid" Margin="0,7,0,0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" HeadersVisibility="Column"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
        </Grid>

        <DataGrid Grid.Row="3" x:Name="MappingGrid"
                  ItemsSource="{Binding MappingRows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dato en JetVenta" Binding="{Binding TargetName}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Requisito" Binding="{Binding Requirement}" Width="105" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Columna del archivo" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="4" MinWidth="390" MaxDropDownHeight="520"
                                      ItemsSource="{Binding DataContext.ColumnOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Index"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectedValue="{Binding SelectedColumnIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ejemplos detectados" Binding="{Binding ExampleText}" Width="260" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Button Width="190" Height="36" HorizontalAlignment="Left" Click="OnAutoDetectClick">Volver a detectar columnas</Button>
                <TextBlock x:Name="StatusText" Margin="0,7,12,0" Foreground="#B42318" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Width="120" Height="40" Margin="0,0,8,0" Style="{StaticResource CancelButtonStyle}" IsCancel="True">Cancelar</Button>
            <Button Grid.Column="2" Width="170" Height="40" IsDefault="True" Click="OnApplyClick"
                    Background="#146CB0" Foreground="White" FontWeight="SemiBold">Usar estas columnas</Button>
        </Grid>
    </Grid>
</Window>
