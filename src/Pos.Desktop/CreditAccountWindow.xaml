<Window x:Class="Pos.Desktop.CreditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cuenta de crédito"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52" Background="#E7F5EE" CornerRadius="6"><icons:PackIconMaterial Kind="AccountCashOutline" Width="30" Height="30" Foreground="#238A68" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="13,0,0,0"><TextBlock x:Name="CustomerNameText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Cuenta de crédito, movimientos y abonos" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Background="#F1F8F4" BorderBrush="#C7E4D1" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Saldo pendiente" FontSize="11" Foreground="#39745B"/><TextBlock x:Name="BalanceText" FontSize="22" FontWeight="Bold" Foreground="#1D6D4B" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Límite de crédito" FontSize="11" Foreground="#39745B"/><TextBlock x:Name="CurrentLimitText" FontSize="22" FontWeight="Bold" Foreground="#1D6D4B" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Disponible" FontSize="11" Foreground="#39745B"/><TextBlock x:Name="AvailableText" FontSize="22" FontWeight="Bold" Foreground="#1D6D4B" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Configuración de crédito" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox x:Name="CreditEnabledBox" Content="Permitir ventas a crédito" Margin="0,12,0,0"/>
                    <TextBlock Text="Límite autorizado" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <Grid Margin="0,5,0,0"><TextBlock Text="$" VerticalAlignment="Center" Margin="11,0,0,0" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/><TextBox x:Name="CreditLimitBox" Height="36" Padding="27,5,8,5" ToolTip="Monto máximo de crédito que puede usar el cliente"/></Grid>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveCreditClick" Margin="0,12,0,0" Height="36"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Guardar crédito"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Registrar abono" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Importe recibido" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <Grid Margin="0,5,0,0"><TextBlock Text="$" VerticalAlignment="Center" Margin="11,0,0,0" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/><TextBox x:Name="PaymentAmountBox" Height="36" Padding="27,5,8,5" ToolTip="Cantidad de efectivo que entrega el cliente"/></Grid>
                    <TextBlock Text="Motivo o referencia" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBox x:Name="PaymentReasonBox" Height="36" Margin="0,5,0,0" Text="Abono registrado en Créditos F2" ToolTip="Motivo para el comprobante y estado de cuenta"/>
                    <Button x:Name="PaymentButton" Style="{StaticResource SuccessButtonStyle}" Click="OnApplyPaymentClick" Margin="0,12,0,0" Height="36"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><icons:PackIconMaterial Kind="CashPlus" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Registrar abono"/></StackPanel></Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,18,0,0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Movimientos de la cuenta" FontWeight="SemiBold" FontSize="16"/>
                <DataGrid Grid.Row="1" x:Name="StatementGrid" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding DateDisplay}" Width="145"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding AmountDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Saldo" Binding="{Binding BalanceDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" IsCancel="True" MinWidth="110">Cerrar</Button></DockPanel>
    </Grid>
</Window>
