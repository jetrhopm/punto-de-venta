<Window x:Class="Pos.Desktop.CashDrawerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cajón de dinero - JetVenta" Width="760" Height="560" MinWidth="680" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#E8F3ED" CornerRadius="6"><icons:PackIconMaterial Kind="CashRegister" Width="28" Height="28" Foreground="#2C8A5C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="Cajón de dinero" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="El cajón se abre mediante la impresora conectada en Windows." Foreground="#526577" Margin="0,4,0,0"/></StackPanel></StackPanel>
            <Border Margin="0,18,0,0" Padding="12" Background="#E8F3FB" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="5"><TextBlock Text="No se instala un controlador independiente para el cajón. La impresora debe estar instalada y funcionando en Windows; el cajón recibe el pulso desde esa impresora." TextWrapping="Wrap" Foreground="#17324D"/></Border>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <CheckBox x:Name="EnabledCheck" Content="Abrir cajón automáticamente después de confirmar un cobro" FontSize="15" FontWeight="SemiBold" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
            <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Impresora de Windows" FontWeight="SemiBold"/><ComboBox x:Name="PrinterBox" Height="38" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Puerto configurado" FontWeight="SemiBold"/><ComboBox x:Name="PortBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Content="USB"/><ComboBoxItem Content="LPT1"/><ComboBoxItem Content="LPT2"/><ComboBoxItem Content="LPT3"/><ComboBoxItem Content="COM1"/><ComboBoxItem Content="COM2"/><ComboBoxItem Content="COM3"/><ComboBoxItem Content="COM4"/></ComboBox></StackPanel></Grid>
            <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="Modelo o señal de apertura" FontWeight="SemiBold"/><ComboBox x:Name="ModelBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Tag="PrinterPulse" Content="Apertura por impresión (recomendado)"/><ComboBoxItem Tag="EpsonDrawer1" Content="Epson - Cajón 1"/><ComboBoxItem Tag="EpsonDrawer2" Content="Epson - Cajón 2"/><ComboBoxItem Tag="StarDrawer1" Content="Star - Cajón 1"/><ComboBoxItem Tag="StarDrawer2" Content="Star - Cajón 2"/><ComboBoxItem Tag="Generic" Content="Genérico ESC/POS"/></ComboBox></StackPanel>
            <Border Grid.Row="3" Margin="0,20,0,0" Padding="12" Background="#F7F9FB" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="5"><TextBlock Text="Si la prueba no abre el cajón, revisa que la impresora seleccionada sea la que tiene conectado el cajón, que esté encendida y que Windows permita imprimir en ella. El puerto se conserva como referencia para equipos USB, seriales o paralelos." TextWrapping="Wrap" Foreground="#526577"/></Border>
            <TextBlock Grid.Row="4" x:Name="StatusText" Margin="2,14,0,0" Foreground="#526577" TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="190" Margin="0,0,8,0" Click="OnTestClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="LockOpenOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Probar apertura"/></StackPanel></Button><Button Width="180" Background="#146CB0" Foreground="White" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></StackPanel>
    </Grid>
</Window>
