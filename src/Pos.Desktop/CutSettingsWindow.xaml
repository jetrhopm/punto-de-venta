<Window x:Class="Pos.Desktop.CutSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Configuración de corte" Width="710" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5"><icons:PackIconMaterial Kind="ContentCut" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="Corte de caja" FontSize="22" FontWeight="Bold"/><TextBlock Text="Reglas para cerrar turnos y controlar efectivo" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,22,0,12"><StackPanel><TextBlock Text="Al cerrar turno" FontSize="16" FontWeight="SemiBold"/><RadioButton x:Name="CountAndAdjustOption" GroupName="Close" Margin="0,9,0,4" Checked="OnCloseOptionChanged"><StackPanel><TextBlock Text="Solicitar efectivo contado y ajustar diferencias" FontWeight="SemiBold"/><TextBlock Text="El cajero captura el efectivo real. Si existe diferencia, JetVenta registra un ajuste de entrada o salida con motivo de corte." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></RadioButton><CheckBox x:Name="AutoAdjustBox" Content="Registrar el ajuste automático cuando haya diferencia" Margin="24,4,0,14"/><RadioButton x:Name="CloseWithoutCountOption" GroupName="Close" Checked="OnCloseOptionChanged"><StackPanel><TextBlock Text="Cerrar turno sin solicitar efectivo contado" FontWeight="SemiBold"/><TextBlock Text="No se solicita conteo ni se registra ningún ajuste. El corte conserva el efectivo esperado por el sistema." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></RadioButton><Separator Margin="0,20,0,16"/><TextBlock Text="Límite de efectivo en caja" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="CashLimitEnabledBox" Content="Mostrar aviso cuando el efectivo esperado alcance el límite" Margin="0,9,0,7" Checked="OnCashLimitChanged" Unchecked="OnCashLimitChanged"/><Grid Margin="24,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Límite de efectivo" VerticalAlignment="Center"/><TextBox x:Name="CashLimitTextBox" Grid.Column="1" Height="30"/></Grid><TextBlock Margin="24,0,0,4" Text="Mensaje que verá el cajero"/><TextBox x:Name="CashLimitMessageTextBox" Margin="24,0,0,0" Height="54" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></ScrollViewer>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,14,0"/><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Width="155" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></Grid>
    </Grid>
</Window>
