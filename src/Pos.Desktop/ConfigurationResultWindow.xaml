<Window x:Class="Pos.Desktop.ConfigurationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Configuración guardada" Width="470" Height="285" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52" Background="#EAF7EF" BorderBrush="#A7D8BA" BorderThickness="1" CornerRadius="6">
                <icons:PackIconMaterial Kind="CheckCircleOutline" Width="31" Height="31" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,2,0,0">
                <TextBlock Text="Configuración guardada" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TitleText" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,20,0,16" Padding="14" Background="#F3F8FC" BorderBrush="#C8DCE9" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="RestartText" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="2" Width="130" HorizontalAlignment="Right" Style="{StaticResource ConfirmButtonStyle}" IsDefault="True" Click="OnCloseClick">Aceptar</Button>
    </Grid>
</Window>
