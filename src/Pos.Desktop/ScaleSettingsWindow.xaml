<Window x:Class="Pos.Desktop.ScaleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Báscula - JetVenta" Width="820" Height="700" MinWidth="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" Background="#F0EAF7" CornerRadius="6"><icons:PackIconMaterial Kind="ScaleBalance" Width="28" Height="28" Foreground="#76538D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="Báscula" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Configura una báscula que Windows presente como puerto COM." Foreground="#526577" Margin="0,4,0,0"/></StackPanel></StackPanel>
            <Border Margin="0,18,0,0" Padding="12" Background="#E8F3FB" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="5"><TextBlock Text="La báscula debe enviar una lectura de peso terminada en CR/LF, CR o LF. Una báscula USB puede necesitar el controlador del fabricante para aparecer como COM; JetVenta no instala controladores genéricos ni inventa protocolos de modelos desconocidos." TextWrapping="Wrap" Foreground="#17324D"/></Border>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,22,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="EnabledCheck" Content="Usar báscula en esta caja" FontSize="15" FontWeight="SemiBold" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Puerto COM" FontWeight="SemiBold"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><ComboBox x:Name="PortBox" Height="40" VerticalContentAlignment="Center"/><Button Grid.Column="1" Margin="8,0,0,0" Height="40" Padding="0" Click="OnRefreshPortsClick" ToolTip="Buscar puertos COM"><icons:PackIconMaterial Kind="Refresh" Width="20" Height="20"/></Button></Grid></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Velocidad" FontWeight="SemiBold"/><ComboBox x:Name="BaudRateBox" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"><ComboBoxItem Content="1200"/><ComboBoxItem Content="2400"/><ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Unidad de lectura" FontWeight="SemiBold"/><ComboBox x:Name="UnitBox" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"><ComboBoxItem Content="Kilogramo"/><ComboBoxItem Content="Gramo"/><ComboBoxItem Content="Libra"/></ComboBox></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Paridad" FontWeight="SemiBold"/><ComboBox x:Name="ParityBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Content="None"/><ComboBoxItem Content="Even"/><ComboBoxItem Content="Odd"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Bits de datos" FontWeight="SemiBold"/><ComboBox x:Name="DataBitsBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Bits de parada" FontWeight="SemiBold"/><ComboBox x:Name="StopBitsBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Content="One"/><ComboBoxItem Content="Two"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Fin de lectura" FontWeight="SemiBold"/><ComboBox x:Name="TerminatorBox" Height="38" Margin="0,5,0,0"><ComboBoxItem Content="CRLF"/><ComboBoxItem Content="CR"/><ComboBoxItem Content="LF"/></ComboBox></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tiempo de espera (ms)" FontWeight="SemiBold"/><TextBox x:Name="TimeoutBox" Text="1500" Margin="0,5,12,0"/></StackPanel><TextBlock Grid.Column="1" Margin="0,27,0,0" Text="Usa un valor entre 200 y 5000 ms. No se bloquea indefinidamente si la báscula no responde." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Grid>
                <Border Margin="0,20,0,0" Padding="14" Background="#F7F9FB" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="5"><StackPanel><TextBlock Text="Lectura de prueba" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Conecta la báscula, selecciona su puerto y pulsa Probar lectura. Se mostrará el texto recibido y el primer peso válido detectado." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="RawReadingText" Text="Sin lectura" FontFamily="Consolas" FontSize="16" Margin="0,14,0,0"/><TextBlock x:Name="ParsedReadingText" Text="Peso: --" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                <TextBlock x:Name="StatusText" Margin="2,14,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="170" Margin="0,0,8,0" Click="OnTestClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Scale" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Probar lectura"/></StackPanel></Button><Button Style="{StaticResource PrimaryButtonStyle}" Width="170" Click="OnSaveClick"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="Guardar"/></StackPanel></Button></StackPanel>
    </Grid>
</Window>
