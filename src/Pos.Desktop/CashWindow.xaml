<Window x:Class="Pos.Desktop.CashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Cobrar venta" Width="540" Height="700" MinHeight="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Cobrar venta" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" /><TextBlock x:Name="TotalText" Margin="0,10,0,0" FontSize="20" FontWeight="Bold" /><TextBlock x:Name="ItemsText" Margin="0,3,0,0" Foreground="#526577" /></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Button x:Name="CashMethodButton" Tag="Cash" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="Cash" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#16803C"/><TextBlock Text="Efectivo" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button x:Name="CardMethodButton" Tag="Card" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="CreditCardOutline" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#146CB0"/><TextBlock Text="Tarjeta" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button x:Name="TransferMethodButton" Tag="Transfer" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="BankTransfer" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#2B8C7F"/><TextBlock Text="Transferencia" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button x:Name="MixedMethodButton" Tag="Mixed" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="SwapHorizontal" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#7A4EAB"/><TextBlock Text="Pago mixto" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
        </UniformGrid>
        <TextBlock Grid.Row="2" x:Name="MethodText" Margin="0,8,0,0" FontWeight="SemiBold" />
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <StackPanel x:Name="CashPanel"><TextBlock Text="Recibido en efectivo" /><TextBox x:Name="ReceivedTextBox" Margin="0,4,0,8" Height="34" FontSize="18" TextChanged="OnAmountChanged" /><TextBlock Text="Cambio" Foreground="#526577" /><TextBlock x:Name="ChangeText" FontSize="22" FontWeight="Bold" Foreground="#16803C" /></StackPanel>
            <Grid x:Name="MixedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="CardAmountLabel" Grid.Row="0" Text="Importe con tarjeta" />
                <TextBox x:Name="CardAmountTextBox" Grid.Row="1" Margin="0,4,0,8" Height="30" Text="0.00" TextChanged="OnAmountChanged" />
                <TextBlock x:Name="TransferAmountLabel" Grid.Row="2" Text="Importe por transferencia" />
                <TextBox x:Name="TransferAmountTextBox" Grid.Row="3" Margin="0,4,0,8" Height="30" Text="0.00" TextChanged="OnAmountChanged" />
                <TextBlock x:Name="MixedCashDueText" Grid.Row="4" Foreground="#526577" TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="MessageText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,6" /><Button Height="40" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Cobrar e imprimir  F1</Button><Button Height="32" Margin="0,6,0,0" Click="OnConfirmWithoutPrintClick">Cobrar sin imprimir  F2</Button><Button x:Name="CreditButton" Height="32" Margin="0,6,0,0" Click="OnCreditClick">Cobrar a crédito  F3</Button><TextBlock Text="Esc: cancelar" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#526577" FontSize="11"/></StackPanel>
    </Grid>
</Window>
