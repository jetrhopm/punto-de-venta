<Window x:Class="Pos.Desktop.CashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Cobrar venta" Width="520" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Cobrar venta" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" /><TextBlock x:Name="TotalText" Margin="0,12,0,0" FontSize="20" FontWeight="Bold" /></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0">
            <Button Tag="Cash" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="Cash" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#16803C"/><TextBlock Text="Efectivo" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button Tag="Card" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="CreditCardOutline" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#146CB0"/><TextBlock Text="Tarjeta" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button Tag="Transfer" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="BankTransfer" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#2B8C7F"/><TextBlock Text="Transferencia" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
            <Button Tag="Mixed" Click="OnPaymentMethodClick" Margin="2"><StackPanel><icons:PackIconMaterial Kind="SwapHorizontal" Width="25" Height="25" HorizontalAlignment="Center" Foreground="#7A4EAB"/><TextBlock Text="Pago mixto" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
        </UniformGrid>
        <TextBlock Grid.Row="2" x:Name="MethodText" Margin="0,14,0,0" FontWeight="SemiBold" />
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel x:Name="CashPanel"><TextBlock Text="Recibido en efectivo" /><TextBox x:Name="ReceivedTextBox" Margin="0,4,0,12" Height="36" FontSize="18" TextChanged="OnAmountChanged" /><TextBlock Text="Cambio" Foreground="#526577" /><TextBlock x:Name="ChangeText" FontSize="22" FontWeight="Bold" Foreground="#16803C" /></StackPanel>
            <StackPanel x:Name="MixedPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Importe con tarjeta" /><TextBox x:Name="CardAmountTextBox" Margin="0,4,0,10" Height="34" Text="0.00" TextChanged="OnAmountChanged" /><TextBlock Text="Importe por transferencia" /><TextBox x:Name="TransferAmountTextBox" Margin="0,4,0,10" Height="34" Text="0.00" TextChanged="OnAmountChanged" /><TextBlock x:Name="MixedCashDueText" Foreground="#526577" TextWrapping="Wrap" /></StackPanel>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="4"><Button Height="42" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Confirmar cobro</Button><Button Height="34" Margin="0,8,0,0" Click="OnCreditClick">Cobrar a crédito</Button></StackPanel>
    </Grid>
</Window>
