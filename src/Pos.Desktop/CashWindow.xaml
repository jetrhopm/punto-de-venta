<Window x:Class="Pos.Desktop.CashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cobro en efectivo" Width="400" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><StackPanel>
        <TextBlock Text="Cobro en efectivo" FontSize="22" FontWeight="SemiBold" Foreground="#17324D" />
        <TextBlock x:Name="TotalText" Margin="0,16,0,8" FontSize="18" />
        <TextBlock Text="Recibido" /><TextBox x:Name="ReceivedTextBox" Margin="0,4,0,12" Height="36" FontSize="18" />
        <Button Height="38" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnConfirmClick">Confirmar cobro</Button>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel></Grid>
</Window>
