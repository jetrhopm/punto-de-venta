<Window x:Class="Pos.Desktop.PermissionAuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Autorización requerida" Width="550" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" Background="#FEE4E2" CornerRadius="5">
                <icons:PackIconMaterial Kind="ShieldLockOutline" Width="25" Height="25" Foreground="#B42318" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Permiso requerido" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="ActionText" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="12" Background="#FFF8E7" BorderBrush="#F7C948" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="RequiredPermissionText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Un administrador o usuario autorizado debe elegir su cuenta y escribir su contraseña. La autorización se revoca al terminar esta acción." Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Usuario que autoriza" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="UserFilterTextBox" Height="36" Padding="10,6" TextChanged="OnUserFilterChanged" ToolTip="Escribe para buscar un usuario"/>
            <ComboBox x:Name="UserComboBox" Height="36" Margin="0,7,0,0" DisplayMemberPath="DisplayText"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Padding="10,6"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="38" Margin="0,0,8,0" Style="{StaticResource DangerButtonStyle}" IsCancel="True" Click="OnCancelClick">Cancelar (Esc)</Button>
            <Button Width="190" Height="38" Style="{StaticResource SuccessButtonStyle}" IsDefault="True" Click="OnAuthorizeClick">Autorizar temporalmente</Button>
        </StackPanel>
    </Grid>
</Window>
