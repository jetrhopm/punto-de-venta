<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>JetVenta Móvil</ApplicationTitle>
    <ApplicationId>mx.com.jetventa.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0.15</ApplicationDisplayVersion>
    <ApplicationVersion>17</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net.Maui.Controls" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\jetventa_mobile_icon.png" />
    <MauiSplashScreen Include="Resources\AppIcon\jetventa_mobile_icon.png" Color="#07172D" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\jetventa_icon.png" />
    <MauiImage Include="Resources\Images\barcode_scan.svg" />
    <MauiImage Include="Resources\Images\inventory_count.svg" />
    <MauiImage Include="Resources\Images\inventory_boxes.svg" />
    <MauiImage Include="Resources\Images\shopping_list.svg" />
  </ItemGroup>
</Project>
