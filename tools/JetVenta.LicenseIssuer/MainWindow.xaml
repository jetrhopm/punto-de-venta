<Window x:Class="JetVenta.LicenseIssuer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Emisor de licencias - JetVenta" Width="720" Height="650" MinWidth="620" MinHeight="540" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F8FB">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#123C63" Padding="24"><StackPanel><TextBlock Text="Emisor de licencias JetVenta" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Herramienta interna. La llave emisora permanece protegida en esta computadora." Foreground="#D6E8F6" Margin="0,5,0,0"/></StackPanel></Border>
        <ScrollViewer Grid.Row="1"><StackPanel Margin="24">
            <TextBlock Text="Código de solicitud del cliente" FontWeight="SemiBold"/><TextBox x:Name="RequestCodeTextBox" MinHeight="88" Margin="0,6,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Nombre de tienda o titular" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBox x:Name="StoreNameTextBox" Margin="0,6,0,0"/>
            <CheckBox x:Name="ExpirationCheckBox" Content="Definir vencimiento" Margin="0,18,0,0" Checked="OnExpirationChanged" Unchecked="OnExpirationChanged"/>
            <DatePicker x:Name="ExpirationPicker" IsEnabled="False" Margin="0,6,0,0" SelectedDate="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
            <Border Background="#FFF7E2" BorderBrush="#E9C770" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Uso restringido. "/><Run Text="Este programa solo emite archivos licencia.jv con la llave privada local. No distribuyas esta aplicación ni copies su almacén de claves."/></TextBlock></Border>
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#555"/>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#D6E1EA" BorderThickness="0,1,0,0" Padding="16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Generar licencia.jv" Click="OnGenerateClick" Padding="22,9" Background="#1673B8" Foreground="White" BorderBrush="#1673B8"/><Button Content="Cerrar" IsCancel="True" Padding="22,9" Margin="10,0,0,0"/></StackPanel></Border>
    </Grid>
</Window>
