<Window x:Class="JetVenta.LicenseIssuer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Emisor de licencias - JetVenta" Width="790" Height="690" MinWidth="680" MinHeight="570" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F8FB">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#123C63" Padding="24"><StackPanel><TextBlock Text="Emisor de licencias JetVenta" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="IssuerStateText" Foreground="#D6E8F6" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <TabControl Grid.Row="1" Margin="24">
            <TabItem Header="Emitir licencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="Código de solicitud del cliente" FontWeight="SemiBold"/><TextBox x:Name="RequestCodeTextBox" MinHeight="88" Margin="0,6,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Nombre de tienda o titular" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBox x:Name="StoreNameTextBox" Margin="0,6,0,0"/>
                    <CheckBox x:Name="ExpirationCheckBox" Content="Definir vencimiento" Margin="0,18,0,0" Checked="OnExpirationChanged" Unchecked="OnExpirationChanged"/>
                    <DatePicker x:Name="ExpirationPicker" IsEnabled="False" Margin="0,6,0,0" SelectedDate="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                    <Border Background="#FFF7E2" BorderBrush="#E9C770" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Uso restringido. "/><Run Text="Este programa solo emite archivos licencia.jv cuando el equipo fue autorizado. No distribuyas la herramienta ni los archivos de recuperación."/></TextBlock></Border>
                    <TextBlock x:Name="IssueStatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#555"/>
                    <Button Content="Generar licencia.jv" Click="OnGenerateClick" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="22,9" Background="#1673B8" Foreground="White" BorderBrush="#1673B8"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Autorizar otro emisor">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="1. Solicitud desde la computadora nueva" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="En la computadora que quieres autorizar, presiona el botón siguiente. Copia el código y llévalo al emisor ya autorizado." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#566B7A"/>
                    <Button Content="Crear solicitud para esta computadora" Click="OnCreateEnrollmentRequestClick" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="18,8"/>
                    <DockPanel Margin="0,8,0,0"><Button Content="Copiar" Click="OnCopyEnrollmentRequestClick" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="16,7"/><TextBox x:Name="EnrollmentRequestTextBox" IsReadOnly="True" MinHeight="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
                    <Separator Margin="0,24,0,18"/>
                    <TextBlock Text="2. Crear autorización desde un emisor ya autorizado" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Pega la solicitud recibida, genera un archivo .jvissuer y llévalo a la computadora nueva. El archivo está cifrado para ese equipo y firmado por JetVenta." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#566B7A"/>
                    <TextBox x:Name="AuthorizationRequestTextBox" MinHeight="76" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Crear archivo de autorización" Click="OnCreateAuthorizationFileClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,8"/>
                    <Separator Margin="0,24,0,18"/>
                    <TextBlock Text="3. Importar autorización en la computadora nueva" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Primero debe haberse creado la solicitud en esta misma computadora. Al importarla, la autorización queda cifrada para el usuario actual de Windows." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#566B7A"/>
                    <Button Content="Importar archivo .jvissuer" Click="OnImportAuthorizationFileClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,8"/>
                    <TextBlock x:Name="AuthorizationStatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#555"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Recuperación de emergencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <Border Background="#FFF2E3" BorderBrush="#E7B978" BorderThickness="1" CornerRadius="6" Padding="14"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Guarda este respaldo fuera de la computadora emisora. "/><Run Text="No lo envíes a clientes ni lo conserves junto con la contraseña. Se usa solo si pierdes el emisor principal y debe mantenerse en un medio cifrado o custodiado."/></TextBlock></Border>
                    <TextBlock Text="Contraseña de recuperación (mínimo 16 caracteres)" FontWeight="SemiBold" Margin="0,20,0,0"/><PasswordBox x:Name="RecoveryPasswordBox" Margin="0,6,0,0"/>
                    <TextBlock Text="Confirmar contraseña" FontWeight="SemiBold" Margin="0,12,0,0"/><PasswordBox x:Name="RecoveryConfirmPasswordBox" Margin="0,6,0,0"/>
                    <Button Content="Crear respaldo de recuperación" Click="OnCreateRecoveryClick" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="18,8"/>
                    <Separator Margin="0,24,0,18"/>
                    <TextBlock Text="Recuperar un emisor en esta computadora" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Selecciona el archivo .jvrecovery y escribe su contraseña. La llave recuperada quedará cifrada para este usuario de Windows." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#566B7A"/>
                    <Button Content="Importar respaldo de recuperación" Click="OnImportRecoveryClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,8"/>
                    <TextBlock x:Name="RecoveryStatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#555"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="White" BorderBrush="#D6E1EA" BorderThickness="0,1,0,0" Padding="16"><Button Content="Cerrar" IsCancel="True" HorizontalAlignment="Right" Padding="22,9"/></Border>
    </Grid>
</Window>
