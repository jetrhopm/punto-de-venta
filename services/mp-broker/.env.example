# Copia estos nombres en el panel de variables de entorno de Hostinger.
# Nunca subas valores reales al repositorio.
PORT=3000
PUBLIC_BASE_URL=https://mp.gocentersuplementos.com
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://mp.gocentersuplementos.com/v1/oauth/callback
# 32 bytes en base64. Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# 1 cuando la app corre detrás del proxy de Hostinger (usa X-Forwarded-For para la IP).
TRUST_PROXY=1
# Opcional: permitir registrar instalaciones (1 = abierto). En fase 2 se exigirá licencia firmada.
ALLOW_OPEN_REGISTRATION=1
