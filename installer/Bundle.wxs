<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Punto de Venta" Manufacturer="Punto de Venta" Version="$(var.ProductVersion)" UpgradeCode="E2F2F47F-2F4C-4D24-9A0D-7D8F8B8A6C10" IconSourceFile="$(var.IconPath)"><BootstrapperApplication><bal:WixStandardBootstrapperApplication LicenseUrl="license.rtf" LogoFile="$(var.LogoPath)" Theme="hyperlinkLicense" /></BootstrapperApplication><Chain><ExePackage SourceFile="$(var.VcRedistPath)" InstallArguments="/install /quiet /norestart" Permanent="yes" Vital="yes" /><MsiPackage SourceFile="$(var.MsiPath)" /><ExePackage SourceFile="$(var.BootstrapPath)" DetectCondition="WixBundleInstalled" UninstallArguments="--uninstall" Permanent="no" Vital="yes" /></Chain></Bundle>
</Wix>
