<Window x:Class="Pos.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Instalación de Punto de Venta" Width="720" Height="680" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
 <Grid Background="#F7FAFC" Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Image Source="Assets/app-icon-256.png" Width="72" Height="72"/><StackPanel Margin="16,4,0,0"><TextBlock x:Name="HeaderText" Text="Instalar Punto de Venta" FontSize="28" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Instalador oficial para Windows x64" Foreground="#526577" Margin="0,5,0,0"/></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Términos y condiciones" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,8"/>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="TermsHint" Text="Al continuar aceptas instalar Punto de Venta y sus dependencias. La desinstalación conserva los datos de la tienda." TextWrapping="Wrap" Foreground="#526577"/>
   <CheckBox x:Name="TermsCheck" Grid.Row="1" Content="Acepto los términos y condiciones" Margin="0,12,0,12"/>
   <StackPanel x:Name="AdminPanel" Grid.Row="2"><TextBlock Text="Administrador inicial" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Nombre"/><TextBox x:Name="AdminNameBox" Text="Administrador" Height="30"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Usuario"/><TextBox Text="admin" IsReadOnly="True" Height="30"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Contraseña"/><PasswordBox x:Name="PasswordBox" Password="12345" Height="30"/></StackPanel></Grid><StackPanel Margin="0,10,0,0"><TextBlock Text="Nombre de la tienda"/><TextBox x:Name="StoreNameBox" Text="Mi tienda" Height="30"/></StackPanel></StackPanel>
   <StackPanel x:Name="DependenciesPanel" Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="Dependencias que se instalarán" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="• Microsoft Visual C++ Redistributable x64&#x0a;• PostgreSQL incluido para Punto de Venta&#x0a;• API local y servicio de Windows&#x0a;• Cliente de escritorio WPF y accesos directos opcionales" Margin="0,8,0,0" Foreground="#526577"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="Carpeta de instalación" FontWeight="SemiBold"/><TextBlock x:Name="InstallPathText" TextWrapping="Wrap" Foreground="#526577" Margin="0,4,0,0"/><TextBlock x:Name="StatusText" Text="Listo para comenzar." Foreground="#146CB0" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="4" Margin="0,18,0,0"><ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="100"/><DockPanel Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><CheckBox x:Name="DesktopShortcutCheck" Content="Acceso directo en el escritorio" IsChecked="True" VerticalAlignment="Center"/><CheckBox x:Name="StartMenuShortcutCheck" Content="Menú Inicio" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center"/></StackPanel><Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Instalar" Width="140" Height="38" Margin="16,0,0,0" Background="#146CB0" Foreground="White" FontWeight="Bold" Click="OnInstallClick"/></DockPanel></StackPanel>
 </Grid>
</Window>
